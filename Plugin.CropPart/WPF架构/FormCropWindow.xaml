<UserControl x:Class="Plugin.CropPart.WPF架构.FormCropWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ctrl="clr-namespace:FrameCommunity.UserControls;assembly=FrameCommunity"
             xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Loaded="UserControl_Loaded"
            >
    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#081018"/>
        <SolidColorBrush x:Key="LineCyan" Color="#23D9FF"/>
        <SolidColorBrush x:Key="LinePink" Color="#FF3FB4"/>
        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="BorderBrush" Value="#21485A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#DCF8FF"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,2,0,8"/>
            <Setter Property="Foreground" Value="#E9FBFF"/>
            <Setter Property="Background" Value="#102536"/>
            <Setter Property="BorderBrush" Value="#2F7E98"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Background" Value="#0E9FE8"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#00A9C8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="Gray"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="82"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Foreground" Value="#E9FBFF"/>
            <Setter Property="Background" Value="#102536"/>
            <Setter Property="BorderBrush" Value="#00A9C8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="#111923"/>
            <Setter Property="BorderBrush" Value="#2F7E98"/>
            <Setter Property="Foreground" Value="#DCF8FF"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#102536"/>
            <Setter Property="Foreground" Value="#DCF8FF"/>
        </Style>
    </UserControl.Resources>
    <Grid Background="#08111B">
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="200"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="6.5*"/>
            <ColumnDefinition Width="3.5*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Row="0" Grid.ColumnSpan="2" BorderBrush="#2F7E98" BorderThickness="1" Background="#101A26" Padding="14,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="520"/>
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="{Binding TitleText}" FontSize="21" FontWeight="Bold" Foreground="#00E5FF" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding StatusText}" Foreground="#9FC7D8"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolButton}" Content="加载图像" Command="{Binding LoadImageCommand}"/>
                    <Button Style="{StaticResource ToolButton}" Content="单步仿真" Command="{Binding StepSimulationCommand}"/>
                    <Button Style="{StaticResource ToolButton}" Content="适应窗口" Command="{Binding FitWindowCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,1,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Border Background="{StaticResource PanelBg}" CornerRadius="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{DynamicResource {x:Static SystemColors.GradientActiveCaptionBrushKey}}" Padding="8,0" CornerRadius="5">
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="主运行图 " FontWeight="Bold" Foreground="{StaticResource LineCyan}" VerticalAlignment="Center"/>
                                <Button DockPanel.Dock="Right" Content="适应" Width="58" Height="28" Command="{Binding FitWindowCommand}"/>
                            </DockPanel>
                        </Border>
                        <Border Grid.Row="1" Padding="2" CornerRadius="5" Background="White">
                            <wfi:WindowsFormsHost Name="mainHost"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
            <Grid Grid.Column="1">
                <Border Background="{StaticResource PanelBg}" CornerRadius="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{DynamicResource {x:Static SystemColors.GradientActiveCaptionBrushKey}}" Padding="8,0" CornerRadius="5">
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="裁拼图结果显示 " FontWeight="Bold" Foreground="{StaticResource LineCyan}" VerticalAlignment="Center"/>
                                <Button DockPanel.Dock="Right" Content="适应" Width="58" Height="28" Command="{Binding FitWindowCommand}"/>
                            </DockPanel>
                        </Border>
                        <Border Grid.Row="1" Padding="2" CornerRadius="5" Background="White">
                            <wfi:WindowsFormsHost Name="CropHost"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
        <Grid Grid.Row="2" Grid.Column="0" Margin="0,8,0,0" MinHeight="140">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource PanelBorder}" Padding="12">
                <StackPanel>
                    <TextBlock Text="图像/鼠标" Foreground="{StaticResource LineCyan}" FontWeight="Bold"/>
                    <TextBlock Text="{Binding ImageInfoText}" Foreground="#DCF8FF" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="12">
                <StackPanel>
                    <TextBlock Text="运行输出" Foreground="{StaticResource LinePink}" FontWeight="Bold"/>
                    <TextBlock Text="{Binding OutputText}" Foreground="#DCF8FF" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource PanelBorder}" Padding="12" Grid.ColumnSpan="2" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="状态" Foreground="#8DFF64" FontWeight="Bold"/>
                    <TextBlock Text="{Binding SimulationText}" Foreground="#DCF8FF" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
        <Border Grid.Column="1" Grid.Row="1" Grid.RowSpan="2" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource LinePink}" BorderThickness="1" CornerRadius="6" Padding="2">
            <Grid>
                <GroupBox Header="基本参数" Foreground="#FFF7F3F3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="【区域中心】图像ID " 
               Padding="5" 
               HorizontalAlignment="Center" 
               Height="35" 
               VerticalAlignment="Bottom" 
               Grid.Row="0" Grid.Column="0" />
                        <ctrl:NumericBox Value="{Binding PartCenterID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                     DecimalPlaces="0" 
                     Increment="1" 
                     Padding="5" 
                     VerticalAlignment="Bottom" 
                     Height="35" 
                     Grid.Row="0" Grid.Column="1" />

                        <!-- 第1行：行 -->
                        <TextBlock Text="【区域中心】行        " 
               Padding="5" 
               HorizontalAlignment="Center" 
               Height="35" 
               VerticalAlignment="Bottom" 
               Grid.Row="1" Grid.Column="0" />
                        <ctrl:NumericBox Value="{Binding PartCenterRow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                     DecimalPlaces="2" 
                     Increment="1" 
                     Padding="5" 
                     VerticalAlignment="Bottom" 
                   
                     Height="35" 
                     Grid.Row="1" Grid.Column="1" />

                        <!-- 第2行：列 -->
                        <TextBlock Text="【区域中心】列        " 
               Padding="5" 
               HorizontalAlignment="Center" 
               Height="35" 
               VerticalAlignment="Bottom" 
               Grid.Row="2" Grid.Column="0" />
                        <ctrl:NumericBox Value="{Binding PartCenterCol, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                     DecimalPlaces="2" 
                     Increment="1" 
                     Padding="5" 
                     VerticalAlignment="Bottom" 
                     
                     Height="35" 
                     Grid.Row="2" Grid.Column="1" />

                        <!-- 第3行：区域尺寸行 -->
                        <TextBlock Text="【区域尺寸】行        " 
               Padding="5" 
               HorizontalAlignment="Center" 
               Height="35" 
               VerticalAlignment="Bottom" 
               Grid.Row="3" Grid.Column="0" />
                        <ctrl:NumericBox Value="{Binding PartSizeRow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                     Minimum="1" 
                     DecimalPlaces="2" 
                     Increment="1" 
                     Padding="5" 
                     VerticalAlignment="Bottom" 
                    
                     Height="35" 
                     Grid.Row="3" Grid.Column="1" />

                        <!-- 第4行：区域尺寸列 -->
                        <TextBlock Text="【区域尺寸】列        " 
               Padding="5" 
               HorizontalAlignment="Center" 
               Height="35" 
               VerticalAlignment="Bottom" 
               Grid.Row="4" Grid.Column="0" />
                        <ctrl:NumericBox Value="{Binding PartSizeCol, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                     Minimum="1" 
                     DecimalPlaces="2" 
                     Increment="1" 
                     Padding="5" 
                     VerticalAlignment="Bottom" 
                    
                     Height="35" 
                     Grid.Row="4" Grid.Column="1" />

                        <!-- 第5行：边缘预留行 -->
                        <TextBlock Text="【边缘预留尺寸】行 " 
               Padding="5" 
               HorizontalAlignment="Center" 
               Height="35" 
               VerticalAlignment="Bottom" 
               Grid.Row="5" Grid.Column="0" />
                        <ctrl:NumericBox Value="{Binding CropShaftRow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                     DecimalPlaces="2" 
                     Increment="1" 
                     Padding="5" 
                     VerticalAlignment="Bottom" 
                    
                     Height="35" 
                     Grid.Row="5" Grid.Column="1" />

                        <!-- 第6行：边缘预留列 -->
                        <TextBlock Text="【边缘预留尺寸】列 " 
               Padding="5" 
               HorizontalAlignment="Center" 
               Height="35" 
               VerticalAlignment="Bottom" 
               Grid.Row="6" Grid.Column="0" />
                        <ctrl:NumericBox Value="{Binding CropShaftCol, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                     DecimalPlaces="2" 
                     Increment="1" 
                     Padding="5" 
                     VerticalAlignment="Bottom" 
                     
                     Height="35" 
                     Grid.Row="6" Grid.Column="1" />
                    </Grid>
                </GroupBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
