  <Target Name="CopyClassifierNativeDlls" AfterTargets="Build">
    <!--
      传统分类器（ONNX Runtime + OpenCvSharp）原生 DLL 随插件输出一起复制，
      保证宿主运行时无需手工部署 onnxruntime.dll / OpenCvSharpExtern.dll。
    -->
    <ItemGroup>
      <ClassifierNative Include="..\DefectRuleClassifier\bin\x64\$(Configuration)\onnxruntime.dll" Condition="Exists('..\DefectRuleClassifier\bin\x64\$(Configuration)\onnxruntime.dll')" />
      <ClassifierNative Include="..\DefectRuleClassifier\bin\x64\$(Configuration)\onnxruntime_providers_shared.dll" Condition="Exists('..\DefectRuleClassifier\bin\x64\$(Configuration)\onnxruntime_providers_shared.dll')" />
      <ClassifierNative Include="..\DefectRuleClassifier\bin\x64\$(Configuration)\OpenCvSharpExtern.dll" Condition="Exists('..\DefectRuleClassifier\bin\x64\$(Configuration)\OpenCvSharpExtern.dll')" />
      <ClassifierNative Include="..\DefectRuleClassifier\bin\x64\$(Configuration)\dll\x64\OpenCvSharpExtern.dll" Condition="Exists('..\DefectRuleClassifier\bin\x64\$(Configuration)\dll\x64\OpenCvSharpExtern.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(ClassifierNative)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>
