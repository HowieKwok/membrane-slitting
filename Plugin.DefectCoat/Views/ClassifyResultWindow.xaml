<Window x:Class="Plugin.DefectCoat.Views.ClassifyResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="分类结果" Width="1280" Height="720" MinWidth="980" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#05080D" Foreground="#EAFBFF" FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#081018"/>
        <SolidColorBrush x:Key="LineCyan" Color="#23D9FF"/>
        <SolidColorBrush x:Key="LinePink" Color="#FF3FB4"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EAFBFF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Background" Value="#0E9FE8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineCyan}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#F7FBFF"/>
            <Setter Property="Foreground" Value="#111820"/>
            <Setter Property="RowBackground" Value="#FFFFFF"/>
            <Setter Property="AlternatingRowBackground" Value="#EEF6FB"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
        </Style>
    </Window.Resources>
    <Border Margin="10" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource LinePink}" BorderThickness="1" CornerRadius="6" Padding="10">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="分类结果" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="  点击表格行查看缺陷小图推理效果；底部可续接训练模型。" Foreground="#8DFF64" Margin="12,0,0,0"/>
            </StackPanel>

            <!-- 续接训练面板 -->
            <Border DockPanel.Dock="Bottom" Background="#0A1620" BorderBrush="{StaticResource LineCyan}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,8,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="数据集目录："/>
                        <TextBox Grid.Column="1" x:Name="TrainingDataRootTextBox" Height="26" VerticalContentAlignment="Center" ToolTip="类别文件夹=标签"/>
                        <TextBlock Grid.Column="2" Text="  轮数：" Margin="8,0,0,0"/>
                        <TextBox Grid.Column="3" x:Name="TrainingEpochsTextBox" Width="52" Height="26" Text="30" VerticalContentAlignment="Center"/>
                        <CheckBox Grid.Column="4" x:Name="TrainingResumeCheckBox" Content="续接上次训练" IsChecked="True" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        <Button Grid.Column="5" x:Name="TrainingButton" Content="开始续接训练" Click="TrainingButton_Click" MinWidth="120"/>
                    </Grid>
                    <TextBox Grid.Row="1" x:Name="TrainingLogTextBox" Height="120" IsReadOnly="True" FontFamily="Consolas" FontSize="10"
                             TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Background="#060D13" Foreground="#A9E5A9" Margin="0,6,0,0"/>
                </Grid>
            </Border>

            <Button DockPanel.Dock="Bottom" Content="关闭" Width="100" HorizontalAlignment="Right" Margin="0,8,0,0" Click="CloseButton_Click"/>

            <!-- 左：结果表格；右：推理效果预览 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="430"/>
                </Grid.ColumnDefinitions>
                <DataGrid Grid.Column="0" x:Name="ResultGrid"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ItemsSource="{Binding}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          SelectionChanged="ResultGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="45"/>
                        <DataGridTextColumn Header="标签序号" Binding="{Binding ClassIndex}" Width="70"/>
                        <DataGridTextColumn Header="分类类别" Binding="{Binding ClassName}" Width="120"/>
                        <DataGridTextColumn Header="置信度" Binding="{Binding Confidence, StringFormat=P2}" Width="80"/>
                        <DataGridTextColumn Header="分类结果" Binding="{Binding Source}" Width="110"/>
                        <DataGridTextColumn Header="极性" Binding="{Binding Polarity}" Width="80"/>
                        <DataGridTextColumn Header="长" Binding="{Binding Length, StringFormat=F2}" Width="70"/>
                        <DataGridTextColumn Header="宽" Binding="{Binding Width, StringFormat=F2}" Width="70"/>
                        <DataGridTextColumn Header="面积" Binding="{Binding Area, StringFormat=F2}" Width="80"/>
                        <DataGridTextColumn Header="均值" Binding="{Binding MeanGray, StringFormat=F2}" Width="80"/>
                        <DataGridTextColumn Header="命中规则" Binding="{Binding HitRule}" Width="460"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Column="2" Background="#060D13" BorderBrush="{StaticResource LineCyan}" BorderThickness="1" CornerRadius="4" Padding="8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="推理效果（缺陷小图 + 类别 / 序号 / 置信度）" FontWeight="Bold" Foreground="{StaticResource LineCyan}" Margin="0,0,0,6"/>
                        <Image x:Name="PreviewImage" DockPanel.Dock="Top" Stretch="Uniform" Margin="0,0,0,6"
                               MinHeight="180" MaxHeight="300" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="PreviewInfoTextBlock" DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#8DFF64" Margin="0,0,0,6"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="PreviewHitRuleTextBlock" TextWrapping="Wrap" Foreground="#B8C7D4"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</Window>
