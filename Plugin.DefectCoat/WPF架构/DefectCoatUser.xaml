<UserControl x:Class="Plugin.DefectCoat.WPF架构.DefectCoatUser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        xmlns:localModelsComm="clr-namespace:FrameCommunity.公共类;assembly=FrameCommunity"
        xmlns:ctrl="clr-namespace:FrameCommunity.UserControls;assembly=FrameCommunity"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        MinWidth="1200" MinHeight="720"
        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
        Background="#05080D" Foreground="#EAFBFF" FontFamily="Microsoft YaHei UI" FontSize="13"
        >
    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#081018"/>
        <SolidColorBrush x:Key="PanelBg2" Color="#0B141E"/>
        <SolidColorBrush x:Key="LineCyan" Color="#23D9FF"/>
        <SolidColorBrush x:Key="LinePink" Color="#FF3FB4"/>
        <SolidColorBrush x:Key="InputBg" Color="#F7FBFF"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EAFBFF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Background" Value="#0E9FE8"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineCyan}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,3,8,3"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="#111820"/>
            <Setter Property="BorderBrush" Value="#BFD3E0"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,3,8,3"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="#111820"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#EAFBFF"/>
            <Setter Property="Margin" Value="0,5,14,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#F7FBFF"/>
            <Setter Property="Foreground" Value="#111820"/>
            <Setter Property="RowBackground" Value="#FFFFFF"/>
            <Setter Property="AlternatingRowBackground" Value="#EEF6FB"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="Foreground" Value="#EAFBFF"/>
            <Setter Property="BorderBrush" Value="#355A6E"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="MinWidth" Value="82"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Foreground" Value="#111820"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="BorderBrush" Value="#21485A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style x:Key="GroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Foreground" Value="#EAFBFF"/>
            <Setter Property="BorderBrush" Value="#21485A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.6*" MinWidth="760"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="0.82*" MinWidth="450"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="118"/>
        </Grid.RowDefinitions>

        <Border Grid.ColumnSpan="3" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource LineCyan}" BorderThickness="1" CornerRadius="6" Padding="12,8">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="缺陷检测工具" FontSize="21" FontWeight="Bold"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="加载图像" Command="{Binding LoadImageCommand}"/>
                    <Button Content="图像适应" Click="OnFitImageClick"/>
                    <Button Content="绘制ROI" Command="{Binding DrawRoiCommand}"/>
                    <Button Content="执行检测" Command="{Binding DetectCommand}"/>
                    <Button Content="分类规则设置" Command="{Binding ShowRuleSettingsCommand}"/>
                    <Button Content="Show分类结果" Command="{Binding ShowClassifyCommand}"/>
                    <Button Content="保存参数" Command="{Binding SaveParamsCommand}"/>
                    <Button Content="读取参数" Command="{Binding LoadParamsCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="0.78*"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="0.78*"/>
            </Grid.RowDefinitions>

            <Border Grid.RowSpan="5" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource LineCyan}" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{StaticResource PanelBg}" Padding="8,0">
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="主运行图 / ViewROI检测区域" FontWeight="Bold" Foreground="{StaticResource LineCyan}"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <TextBlock Text="{Binding MouseInfo}" Foreground="#8DFF64" Margin="0,0,18,0"/>
                                <TextBlock Text="{Binding ImageInfo}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Grid.Row="1" Margin="4" Background="Black">
                        <wfi:WindowsFormsHost x:Name="MainHost"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource LinePink}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{StaticResource PanelBg}" Padding="10,0">
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding RegionPreviewTitle}" FontWeight="Bold" Foreground="{StaticResource LinePink}"/>
                            <Button DockPanel.Dock="Right" Content="适应" Width="58" Height="28" Click="OnFitRegionClick"/>
                        </DockPanel>
                    </Border>
                    <Border Grid.Row="1" Margin="6,0,6,6" Background="Black">
                        <wfi:WindowsFormsHost x:Name="RegionHost"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Grid.Row="2" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource LineCyan}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{StaticResource PanelBg}" Padding="10,0">
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding SmallPreviewTitle}" FontWeight="Bold" Foreground="{StaticResource LineCyan}"/>
                            <Button DockPanel.Dock="Right" Content="适应" Width="58" Height="28" Click="OnFitSmallClick"/>
                        </DockPanel>
                    </Border>
                    <Border Grid.Row="1" Margin="6,0,6,6" Background="Black">
                        <wfi:WindowsFormsHost x:Name="SmallHost"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Grid.Row="4" Background="{StaticResource PanelBg}" BorderBrush="#8DFF64" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="24"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{StaticResource PanelBg}" Padding="10,0">
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding PreprocessPreviewTitle}" FontWeight="Bold" Foreground="#8DFF64"/>
                            <Button DockPanel.Dock="Right" Content="适应" Width="58" Height="28" Click="OnFitPreprocessClick"/>
                        </DockPanel>
                    </Border>
                    <Border Grid.Row="1" Margin="6,0,6,4" Background="Black">
                        <wfi:WindowsFormsHost x:Name="PreprocessHost"/>
                    </Border>
                    <TextBlock Grid.Row="2" Text="{Binding PreprocessMouseInfo}" Foreground="#8DFF64" Margin="8,0,8,4"/>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Grid.Column="0" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource PanelBorder}" Padding="12">
                <StackPanel>
                    <TextBlock Text="图像/鼠标" Foreground="{StaticResource LineCyan}" FontWeight="Bold"/>
                    <TextBlock Text="{Binding ImageInfo}" Margin="0,10,0,0"/>
                    <TextBlock Text="{Binding MouseInfo}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="12">
                <StackPanel>
                    <TextBlock Text="运行输出" Foreground="{StaticResource LinePink}" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Results.Count, StringFormat=候选缺陷：{0}}" Margin="0,10,0,0"/>
                    <TextBlock Text="{Binding RunElapsedText}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding Params.PreprocessInfo}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding RoiInfo}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource PanelBorder}" Padding="12">
                <StackPanel>
                    <TextBlock Text="状态" Foreground="#8DFF64" FontWeight="Bold"/>
                    <TextBlock Text="{Binding StatusText}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Column="2" Grid.Row="1" Grid.RowSpan="2" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource LinePink}" BorderThickness="1" CornerRadius="6" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="缺陷检测参数与输出" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
                <TabControl Grid.Row="1">
                    <TabItem Header="基础参数">
                        <Border Background="{StaticResource PanelBg2}" Padding="10">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <GroupBox Header="分类入口" Style="{StaticResource GroupBoxStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="98"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="分类方式"/>
                                            <WrapPanel Grid.Row="0" Grid.Column="1">
                                                <CheckBox Content="特征值分类" IsChecked="{Binding Params.EnableFeatureRuleClassify, Mode=TwoWay}" Margin="0,0,12,0"/>
                                                <CheckBox Content="分类器分类" IsChecked="{Binding Params.EnableModelClassify, Mode=TwoWay}" Margin="0,0,12,0"/>
                                                <CheckBox Content="AI分类" IsChecked="{Binding Params.EnableAiClassify, Mode=TwoWay}"/>
                                            </WrapPanel>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="分类规则路径"/>
                                            <DockPanel Grid.Row="1" Grid.Column="1">
                                                <Button DockPanel.Dock="Right" Content="设置" Width="54" Command="{Binding SelectFeatureRulePathCommand}"/>
                                                <TextBox Text="{Binding Params.RuleConfigPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DockPanel>
                                        </Grid>
                                    </GroupBox>

                                    <GroupBox Header="基础参数" Style="{StaticResource GroupBoxStyle}">
                                        <UniformGrid Columns="2">
                                            <TextBlock Text="横向单量(mm/pixel)"/>
                                            <ctrl:NumericBox Value="{Binding Params.PixelToMmH, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0.000001" Increment="0.001" DecimalPlaces="6"/>
                                            <TextBlock Text="纵向单量(mm/pixel)"/>
                                            <ctrl:NumericBox Value="{Binding Params.PixelToMmV, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0.000001" Increment="0.001" DecimalPlaces="6"/>
                                        </UniformGrid>
                                    </GroupBox>

                                    <GroupBox Header="分类操作" Style="{StaticResource GroupBoxStyle}">
                                        <StackPanel>
                                            <Button Content="分类规则设置" Command="{Binding ShowRuleSettingsCommand}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                                            <Button Content="Show分类结果" Command="{Binding ShowClassifyCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </GroupBox>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </TabItem>

                    <TabItem Header="ROI设置">
                        <Border Background="{StaticResource PanelBg2}" Padding="10">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <GroupBox Header="检测区域与编辑对象" Style="{StaticResource GroupBoxStyle}">
                                        <StackPanel>
                                            <WrapPanel Margin="0,0,0,8">
                                                <CheckBox Content="启用检测区域ROI" IsChecked="{Binding Params.EnableLocalRoi, Mode=TwoWay}"/>
                                                <CheckBox Content="启用屏蔽ROI" IsChecked="{Binding Params.EnableMaskRoi, Mode=TwoWay}"/>
                                                <CheckBox Content="显示ViewROI" IsChecked="{Binding ShowViewRoi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <CheckBox Content="位置跟随" IsChecked="{Binding Params.EnablePositionFollow, Mode=TwoWay}"/>
                                                <Button Content="绘制/刷新ROI" Command="{Binding DrawRoiCommand}"/>
                                                <Button Content="同步ROI参数" Command="{Binding GetRoiDataCommand}"/>
                                            </WrapPanel>
                                            <UniformGrid Columns="4">
                                                <TextBlock Text="检测范围"/>
                                                <ComboBox SelectedValue="{Binding Params.DetectMode, Mode=TwoWay}" SelectedValuePath="Tag">
                                                    <ComboBoxItem Content="全局检测" Tag="{x:Static localModelsComm:DetectRangeMode.Global}"/>
                                                    <ComboBoxItem Content="局部ROI检测" Tag="{x:Static localModelsComm:DetectRangeMode.LocalRoi}"/>
                                                </ComboBox>
                                                <TextBlock Text="编辑对象"/>
                                                <ComboBox SelectedValue="{Binding EditRole, Mode=TwoWay}" SelectedValuePath="Tag">
                                                    <ComboBoxItem Content="检测区域ROI" Tag="{x:Static localModelsComm:RoiEditRole.Local}"/>
                                                    <ComboBoxItem Content="屏蔽ROI" Tag="{x:Static localModelsComm:RoiEditRole.Mask}"/>
                                                </ComboBox>
                                            </UniformGrid>
                                        </StackPanel>
                                    </GroupBox>

                                    <GroupBox Header="Rectangle1 ROI参数" Style="{StaticResource GroupBoxStyle}">
                                        <UniformGrid Columns="8">
                                            <TextBlock Text="Row1(px)"/><ctrl:NumericBox Value="{Binding EditRoiRow1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Increment="1" DecimalPlaces="2"/>
                                            <TextBlock Text="Col1(px)"/><ctrl:NumericBox Value="{Binding EditRoiCol1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Increment="1" DecimalPlaces="2"/>
                                            <TextBlock Text="Row2(px)"/><ctrl:NumericBox Value="{Binding EditRoiRow2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="1" Increment="1" DecimalPlaces="2"/>
                                            <TextBlock Text="Col2(px)"/><ctrl:NumericBox Value="{Binding EditRoiCol2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="1" Increment="1" DecimalPlaces="2"/>
                                            <TextBlock Text="上偏移(px)"/>
                                            <ctrl:NumericBox Value="{Binding EditTopOffsetRow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Increment="1" DecimalPlaces="2"/>
                                            <TextBlock Text="下偏移(px)"/>
                                            <ctrl:NumericBox Value="{Binding EditBottomOffsetRow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Increment="1" DecimalPlaces="2"/>
                                            <TextBlock Text="左偏移(px)"/>
                                            <ctrl:NumericBox Value="{Binding EditLeftOffsetCol, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="1" Increment="1" DecimalPlaces="2"/>
                                            <TextBlock Text="右偏移(px)"/>
                                            <ctrl:NumericBox Value="{Binding EditRightOffsetCol, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="1" Increment="1" DecimalPlaces="2"/>
                                        </UniformGrid>
                                    </GroupBox>

                                    <GroupBox Header="位置跟随" Style="{StaticResource GroupBoxStyle}">
                                        <StackPanel>
                                            <UniformGrid Columns="4">
                                                <TextBlock Text="基准Row(px)"/><ctrl:NumericBox Value="{Binding Params.BaseRow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Increment="1" DecimalPlaces="2"/>
                                                <TextBlock Text="基准Col(px)"/><ctrl:NumericBox Value="{Binding Params.BaseCol, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Increment="1" DecimalPlaces="2"/>
                                                <TextBlock Text="基准角度(°)"/><ctrl:NumericBox Value="{Binding Params.BaseAngle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Increment="0.1" DecimalPlaces="3"/>
                                                <TextBlock Text="当前Row(px)"/><ctrl:NumericBox Value="{Binding Params.CurrentRow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Increment="1" DecimalPlaces="2"/>
                                                <TextBlock Text="当前Col(px)"/><ctrl:NumericBox Value="{Binding Params.CurrentCol, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Increment="1" DecimalPlaces="2"/>
                                                <TextBlock Text="当前角度(°)"/><ctrl:NumericBox Value="{Binding Params.CurrentAngle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Increment="0.1" DecimalPlaces="3"/>
                                            </UniformGrid>
                                        </StackPanel>
                                    </GroupBox>

                                    <GroupBox Header="屏蔽ROI列表" Style="{StaticResource GroupBoxStyle}">
                                        <DockPanel LastChildFill="True">
                                            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                                <Button Content="新增屏蔽ROI" Command="{Binding AddMaskRoiCommand}"/>
                                                <Button Content="删除屏蔽ROI" Command="{Binding DeleteMaskRoiCommand}"/>
                                            </WrapPanel>
                                            <DataGrid ItemsSource="{Binding MaskRoiItems}" SelectedItem="{Binding SelectedMaskRoi, Mode=TwoWay}" AutoGenerateColumns="False" MinHeight="180" MaxHeight="260">
                                                <DataGrid.Columns>
                                                    <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled, Mode=TwoWay}" Width="50"/>
                                                    <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="38"/>
                                                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/>
                                                    <DataGridTextColumn Header="Row1" Binding="{Binding Row1, Mode=TwoWay, StringFormat=F1}" Width="76"/>
                                                    <DataGridTextColumn Header="Col1" Binding="{Binding Col1, Mode=TwoWay, StringFormat=F1}" Width="76"/>
                                                    <DataGridTextColumn Header="Row2" Binding="{Binding Row2, Mode=TwoWay, StringFormat=F1}" Width="76"/>
                                                    <DataGridTextColumn Header="Col2" Binding="{Binding Col2, Mode=TwoWay, StringFormat=F1}" Width="76"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </GroupBox>
                                    <TextBlock Text="{Binding RoiInfo}" Foreground="#8DFF64" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </TabItem>

                    <TabItem Header="过滤条件">
                        <ScrollViewer  VerticalScrollBarVisibility="Auto">
                            <Border Background="{StaticResource PanelBg2}" Padding="10">
                                <DockPanel LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Top">
                                        <TextBlock Text="检测统一按分区参数执行：设置为 1 分区就是单区域检测；设置多个分区时，按所选方向切分检测 ROI。" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <GroupBox Header="全局默认检测参数" Style="{StaticResource GroupBoxStyle}">
                                            <StackPanel>
                                                <UniformGrid Columns="4">
                                                    <TextBlock Text="参考灰(gray)"/>
                                                    <ctrl:NumericBox Value="{Binding Params.ReferenceGray, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="255" Increment="1" DecimalPlaces="0"/>
                                                    <TextBlock Text="亮偏差(gray)"/>
                                                    <ctrl:NumericBox Value="{Binding Params.UpGrayOffset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="255" Increment="1" DecimalPlaces="0"/>
                                                    <TextBlock Text="暗偏差(gray)"/>
                                                    <ctrl:NumericBox Value="{Binding Params.DownGrayOffset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="255" Increment="1" DecimalPlaces="0"/>
                                                    <TextBlock Text="最小面积(mm²)"/>
                                                    <ctrl:NumericBox Value="{Binding Params.MinCandidateArea, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Increment="0.1" DecimalPlaces="4"/>
                                                    <TextBlock Text="开半径(px)"/>
                                                    <ctrl:NumericBox Value="{Binding Params.OpenRadius, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Increment="1" DecimalPlaces="0"/>
                                                    <TextBlock Text="闭半径(px)"/>
                                                    <ctrl:NumericBox Value="{Binding Params.CloseRadius, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Increment="1" DecimalPlaces="0"/>
                                                    <TextBlock Text="最大缩放倍率"/>
                                                    <ctrl:NumericBox Value="{Binding Params.MaxGrayScaleAbs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="1" Increment="1" DecimalPlaces="2"/>
                                                    <TextBlock Text="合并最大面积(px²)"/>
                                                    <ctrl:NumericBox Value="{Binding Params.SmallRegionMergeMaxArea, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Increment="1" DecimalPlaces="2"/>
                                                    <TextBlock Text="合并宽(px)"/>
                                                    <ctrl:NumericBox Value="{Binding Params.SmallRegionMergeWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Increment="1" DecimalPlaces="0"/>
                                                    <TextBlock Text="合并高(px)"/>
                                                    <ctrl:NumericBox Value="{Binding Params.SmallRegionMergeHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Increment="1" DecimalPlaces="0"/>
                                                </UniformGrid>
                                                <WrapPanel Margin="0,4,0,0">
                                                    <CheckBox Content="背景归一化" IsChecked="{Binding Params.EnableBackgroundGrayScale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <CheckBox Content="小区域合并" IsChecked="{Binding Params.EnableSmallRegionMerge, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </GroupBox>
                                        <UniformGrid Columns="4">
                                            <TextBlock Text="分段方向"/>
                                            <ComboBox ItemsSource="{Binding PartitionDirections}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding Params.PartitionDirection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Text="分区数"/>
                                            <ctrl:NumericBox Value="{Binding Params.PartitionCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="1" Maximum="50" Increment="1" DecimalPlaces="0"/>
                                            <TextBlock Text="长度输入单位"/>
                                            <ComboBox SelectedValue="{Binding Params.PartitionLengthUnit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag">
                                                <ComboBoxItem Content="像素(px)" Tag="{x:Static localModelsComm:PartitionLengthUnit.Pixel}"/>
                                                <ComboBoxItem Content="实际尺寸(mm)" Tag="{x:Static localModelsComm:PartitionLengthUnit.Millimeter}"/>
                                            </ComboBox>
                                            <TextBlock Text="总分段长度"/>
                                            <TextBlock Text="{Binding PartitionTotalLengthText}" Foreground="#8DFF64"/>
                                            <TextBlock Text="固定宽度"/>
                                            <TextBlock Text="{Binding PartitionFixedWidthText}" Foreground="#8DFF64"/>
                                            <TextBlock Text="横向单量(mm/pixel)"/>
                                            <ctrl:NumericBox Value="{Binding Params.PixelToMmH, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0.000001" Increment="0.001" DecimalPlaces="6"/>
                                            <TextBlock Text="纵向单量(mm/pixel)"/>
                                            <ctrl:NumericBox Value="{Binding Params.PixelToMmV, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0.000001" Increment="0.001" DecimalPlaces="6"/>
                                        </UniformGrid>
                                        <WrapPanel Margin="0,6,0,8">
                                            <Button Content="生成分区" Command="{Binding RebuildPartitionsCommand}"/>
                                            <Button Content="换算长度" Command="{Binding NormalizePartitionsCommand}"/>
                                        </WrapPanel>
                                    </StackPanel>
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                        <DataGrid ItemsSource="{Binding PartitionItems}" AutoGenerateColumns="False" MinHeight="320">
                                            <DataGrid.Columns>
                                                <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled, Mode=TwoWay}" Width="48"/>
                                                <DataGridCheckBoxColumn Header="固定长度" Binding="{Binding IsLengthFixed, Mode=TwoWay}" Width="76"/>
                                                <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="34"/>
                                                <DataGridTextColumn Header="名称" Binding="{Binding Name, Mode=TwoWay}" Width="80"/>
                                                <DataGridTemplateColumn Header="分段长度(px)" Width="112">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <ctrl:NumericBox Value="{Binding Length, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Increment="1" DecimalPlaces="2"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="分段长度(mm)" Width="118">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <ctrl:NumericBox Value="{Binding LengthMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Increment="0.1" DecimalPlaces="4"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="参考灰(gray)" Binding="{Binding ReferenceGray, Mode=TwoWay}" Width="92"/>
                                                <DataGridTextColumn Header="亮偏差(gray)" Binding="{Binding UpGrayOffset, Mode=TwoWay}" Width="92"/>
                                                <DataGridTextColumn Header="暗偏差(gray)" Binding="{Binding DownGrayOffset, Mode=TwoWay}" Width="92"/>
                                                <DataGridTextColumn Header="最小面积(mm²)" Binding="{Binding MinCandidateArea, Mode=TwoWay, StringFormat=F4}" Width="108"/>
                                                <DataGridTextColumn Header="开半径(px)" Binding="{Binding OpenRadius, Mode=TwoWay}" Width="82"/>
                                                <DataGridTextColumn Header="闭半径(px)" Binding="{Binding CloseRadius, Mode=TwoWay}" Width="82"/>
                                                <DataGridCheckBoxColumn Header="背景归一化" Binding="{Binding EnableBackgroundGrayScale, Mode=TwoWay}" Width="86"/>
                                                <DataGridTextColumn Header="最大缩放倍率" Binding="{Binding MaxGrayScaleAbs, Mode=TwoWay, StringFormat=F2}" Width="104"/>
                                                <DataGridCheckBoxColumn Header="小区域合并" Binding="{Binding EnableSmallRegionMerge, Mode=TwoWay}" Width="86"/>
                                                <DataGridTextColumn Header="合并最大面积(px²)" Binding="{Binding SmallRegionMergeMaxArea, Mode=TwoWay, StringFormat=F2}" Width="124"/>
                                                <DataGridTextColumn Header="合并宽(px)" Binding="{Binding SmallRegionMergeWidth, Mode=TwoWay}" Width="88"/>
                                                <DataGridTextColumn Header="合并高(px)" Binding="{Binding SmallRegionMergeHeight, Mode=TwoWay}" Width="88"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </ScrollViewer>
                        
                    </TabItem>

                    <TabItem Header="输出结果">
                        <Border Background="{StaticResource PanelBg2}" Padding="10">
                            <DataGrid ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult, Mode=TwoWay}" AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="42"/>
                                    <DataGridTextColumn Header="标签序号" Binding="{Binding ClassIndex}" Width="70"/>
                                    <DataGridTextColumn Header="分类类别" Binding="{Binding ClassName}" Width="150"/>
                                    <DataGridTextColumn Header="分类结果" Binding="{Binding Source}" Width="96"/>
                                    <DataGridTextColumn Header="极性" Binding="{Binding Polarity}" Width="68"/>
                                    <DataGridTextColumn Header="长(mm)" Binding="{Binding Length, StringFormat=F2}" Width="72"/>
                                    <DataGridTextColumn Header="宽(mm)" Binding="{Binding Width, StringFormat=F2}" Width="72"/>
                                    <DataGridTextColumn Header="面积(mm²)" Binding="{Binding Area, StringFormat=F2}" Width="82"/>
                                    <DataGridTextColumn Header="Row(px)" Binding="{Binding Row, StringFormat=F2}" Width="78"/>
                                    <DataGridTextColumn Header="Col(px)" Binding="{Binding Column, StringFormat=F2}" Width="78"/>
                                    <DataGridTextColumn Header="灰度均值" Binding="{Binding MeanGray, StringFormat=F2}" Width="78"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </TabItem>

                    <TabItem Header="特征输出">
                        <Border Background="{StaticResource PanelBg2}" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="42"/>
                                    <RowDefinition Height="1.05*"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="0.95*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" BorderBrush="{StaticResource LineCyan}" BorderThickness="1" CornerRadius="4" Padding="8,4" Background="#07131C">
                                    <DockPanel LastChildFill="True">
                                        <Button DockPanel.Dock="Left" Content="获取全部特征用于分类" Command="{Binding GetAllFeaturesCommand}" MinWidth="190" Height="30" Background="#FF3FB4" Margin="0,0,10,0"/>
                                        <WrapPanel VerticalAlignment="Center">
                                            <TextBlock Text="当前缺陷：" Foreground="{StaticResource LineCyan}" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding SelectedResult.Index}" Width="44"/>
                                            <TextBlock Text="分类类别：" Margin="8,0,0,0" Foreground="{StaticResource LineCyan}" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding SelectedResult.ClassName}" Width="145"/>
                                            <TextBlock Text="分类结果：" Margin="8,0,0,0" Foreground="{StaticResource LineCyan}" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding SelectedResult.Source}" Width="100"/>
                                            <TextBlock Text="极性：" Margin="8,0,0,0" Foreground="{StaticResource LineCyan}" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding SelectedResult.Polarity}" Width="70"/>
                                        </WrapPanel>
                                    </DockPanel>
                                </Border>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding FeatureRows}" SelectedItem="{Binding SelectedFeatureRow, Mode=TwoWay}" AutoGenerateColumns="False">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="MouseDoubleClick">
                                            <i:InvokeCommandAction Command="{Binding GetAllFeaturesCommand}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                   

                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="缺陷#" Binding="{Binding DefectIndex}" Width="65"/>
                                        <DataGridTextColumn Header="极性" Binding="{Binding Polarity}" Width="76"/>
                                        <DataGridTextColumn Header="面积(mm2)" Binding="{Binding Area, StringFormat=F4}" Width="82"/>
                                        <DataGridTextColumn Header="长(mm)" Binding="{Binding Length, StringFormat=F4}" Width="76"/>
                                        <DataGridTextColumn Header="宽(mm)" Binding="{Binding Width, StringFormat=F4}" Width="76"/>
                                        <DataGridTextColumn Header="高(mm)" Binding="{Binding Height, StringFormat=F4}" Width="76"/>
                                        <DataGridTextColumn Header="中心Row" Binding="{Binding Row, StringFormat=F2}" Width="78"/>
                                        <DataGridTextColumn Header="中心Col" Binding="{Binding Column, StringFormat=F2}" Width="78"/>
                                        <DataGridTextColumn Header="灰度均值" Binding="{Binding MeanGray, StringFormat=F2}" Width="78"/>
                                        <DataGridTextColumn Header="对比度" Binding="{Binding Contrast, StringFormat=F2}" Width="72"/>
                                        <DataGridTextColumn Header="圆度" Binding="{Binding Roundness, StringFormat=F4}" Width="66"/>
                                        <DataGridTextColumn Header="宽高比" Binding="{Binding WidthHeightRate, StringFormat=F4}" Width="72"/>
                                        <DataGridTextColumn Header="亮区面积" Binding="{Binding BrightArea, StringFormat=F4}" Width="78"/>
                                        <DataGridTextColumn Header="暗区面积" Binding="{Binding DarkArea, StringFormat=F4}" Width="78"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="#21485A"/>
                                <GroupBox Grid.Row="3" Header="当前缺陷全部特征" Style="{StaticResource GroupBoxStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <DataGrid Grid.Row="0" ItemsSource="{Binding FeatureDetailRows}" AutoGenerateColumns="False">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="缺陷#" Binding="{Binding DefectIndex}" Width="64"/>
                                                <DataGridTextColumn Header="特征类型" Binding="{Binding DisplayName}" Width="180"/>
                                                <DataGridTextColumn Header="特征值" Binding="{Binding Value, StringFormat=F6}" Width="120"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </GroupBox>
                            </Grid>
                        </Border>
                    </TabItem>

                    <TabItem Header="算法调试">
                        <Border Background="{StaticResource PanelBg2}" Padding="10">
                            <ListBox ItemsSource="{Binding DebugLogs}" FontFamily="Consolas" FontSize="12" Background="WhiteSmoke" Foreground="#FF919797"/>
                        </Border>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
