<UserControl x:Class="Plugin.FindIntersectionAngle.AngleWpfView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
             MinWidth="900" MinHeight="620"
             Background="#0A121C">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelBg2" Color="#0B1622"/>
        <SolidColorBrush x:Key="TextMain" Color="#EAFBFF"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Foreground" Value="#F2FCFF"/>
            <Setter Property="Background" Value="#17283A"/>
            <Setter Property="BorderBrush" Value="#00AEEA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Foreground" Value="#EAFBFF"/>
            <Setter Property="Background" Value="#0D1926"/>
            <Setter Property="BorderBrush" Value="#315E76"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Foreground" Value="#102030"/>
            <Setter Property="Background" Value="#EAFBFF"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#00D8FF"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="#2B6076"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#EAFBFF"/>
            <Setter Property="Background" Value="#16283A"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="14,7"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="110"/>
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <Border Grid.ColumnSpan="2" Background="#08111B" BorderBrush="#14394B" BorderThickness="1">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                    <TextBlock Text="两线交点角度工具" Foreground="#00E5FF" FontSize="20" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtRuntime" Text="等待执行" Foreground="#8FB9C9" Margin="18,0,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button x:Name="BtnLoadImage" Style="{StaticResource IconButton}" Content="&#xE8E5;" ToolTip="打开图像" Click="BtnLoadImage_Click"/>
                    <Button x:Name="BtnReset" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="复位显示" Click="BtnReset_Click"/>
                    <Button x:Name="BtnCrosshair" Style="{StaticResource IconButton}" Content="&#xE7C1;" ToolTip="十字光标/灰度曲线" Click="BtnCrosshair_Click"/>
                    <Button x:Name="BtnRun" Style="{StaticResource IconButton}" Content="&#xE768;" ToolTip="执行检测" Click="BtnRun_Click"/>
                    <Button x:Name="BtnSave" Style="{StaticResource IconButton}" Content="&#xE74E;" ToolTip="保存参数" Click="BtnSave_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Background="Black" BorderBrush="#27566D" BorderThickness="1" Margin="0,8,8,8">
            <wfi:WindowsFormsHost x:Name="HalconHost"/>
        </Border>

        <Grid Grid.Row="2" Grid.Column="0" Margin="0,0,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource PanelBg2}" BorderBrush="#22495E" BorderThickness="1" Margin="0,0,4,0">
                <Canvas x:Name="CanvasHProfile"/>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource PanelBg2}" BorderBrush="#22495E" BorderThickness="1" Margin="4,0,0,0">
                <Canvas x:Name="CanvasVProfile"/>
            </Border>
        </Grid>

        <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Background="#08111B" BorderBrush="#14394B" BorderThickness="1">
            <DockPanel>
                <TextBlock x:Name="TxtImageSize" Text="图像：-" Margin="12,0,28,0"/>
                <TextBlock x:Name="TxtGray" Text="行：--  列：--  灰度：--" Margin="0,0,28,0"/>
                <TextBlock x:Name="TxtLineAngleStatus" Text="夹角：-" Foreground="#00E5FF" FontWeight="Bold"/>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Margin="8,8,0,8" Background="#0A121C" BorderBrush="#2B6076">
            <TabItem Header="线1参数">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <GroupBox Header="ROI区域">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/>
                                    <RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="中心行"/><TextBox x:Name="L1Row" Grid.Column="1" LostFocus="Param_LostFocus"/>
                                <TextBlock Grid.Row="1" Text="中心列"/><TextBox x:Name="L1Col" Grid.Row="1" Grid.Column="1" LostFocus="Param_LostFocus"/>
                                <TextBlock Grid.Row="2" Text="角度"/><TextBox x:Name="L1Angle" Grid.Row="2" Grid.Column="1" LostFocus="Param_LostFocus"/>
                                <TextBlock Grid.Row="3" Text="高度"/><TextBox x:Name="L1Height" Grid.Row="3" Grid.Column="1" LostFocus="Param_LostFocus"/>
                                <TextBlock Grid.Row="4" Text="宽度"/><TextBox x:Name="L1Width" Grid.Row="4" Grid.Column="1" LostFocus="Param_LostFocus"/>
                                <TextBlock Grid.Row="5" Text="采样密度"/><TextBox x:Name="L1Points" Grid.Row="5" Grid.Column="1"/>
                            </Grid>
                        </GroupBox>
                        <GroupBox Header="抓边参数">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/>
                                    <RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="平滑系数"/><TextBox x:Name="L1Sigma" Grid.Column="1"/>
                                <TextBlock Grid.Row="1" Text="灰度阈值"/><TextBox x:Name="L1Threshold" Grid.Row="1" Grid.Column="1"/>
                                <TextBlock Grid.Row="2" Text="拟合数量"/><TextBox x:Name="L1NumInstances" Grid.Row="2" Grid.Column="1"/>
                                <TextBlock Grid.Row="3" Text="剔除距离"/><TextBox x:Name="L1DistThreshold" Grid.Row="3" Grid.Column="1"/>
                                <TextBlock Grid.Row="4" Text="最小得分"/><TextBox x:Name="L1MinScore" Grid.Row="4" Grid.Column="1"/>
                                <TextBlock Grid.Row="5" Text="迭代次数"/><TextBox x:Name="L1Iterations" Grid.Row="5" Grid.Column="1"/>
                                <TextBlock Grid.Row="6" Text="明暗方向"/><ComboBox x:Name="L1Transition" Grid.Row="6" Grid.Column="1"/>
                                <TextBlock Grid.Row="7" Text="边缘选取"/><ComboBox x:Name="L1Select" Grid.Row="7" Grid.Column="1"/>
                                <TextBlock Grid.Row="8" Text="插值类型"/><ComboBox x:Name="L1Interpolation" Grid.Row="8" Grid.Column="1"/>
                                <TextBlock Grid.Row="9" Text="结果区域"/><ComboBox x:Name="L1IORegions" Grid.Row="9" Grid.Column="1"/>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="线2参数">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <GroupBox Header="ROI区域">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/>
                                    <RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="中心行"/><TextBox x:Name="L2Row" Grid.Column="1" LostFocus="Param_LostFocus"/>
                                <TextBlock Grid.Row="1" Text="中心列"/><TextBox x:Name="L2Col" Grid.Row="1" Grid.Column="1" LostFocus="Param_LostFocus"/>
                                <TextBlock Grid.Row="2" Text="角度"/><TextBox x:Name="L2Angle" Grid.Row="2" Grid.Column="1" LostFocus="Param_LostFocus"/>
                                <TextBlock Grid.Row="3" Text="高度"/><TextBox x:Name="L2Height" Grid.Row="3" Grid.Column="1" LostFocus="Param_LostFocus"/>
                                <TextBlock Grid.Row="4" Text="宽度"/><TextBox x:Name="L2Width" Grid.Row="4" Grid.Column="1" LostFocus="Param_LostFocus"/>
                                <TextBlock Grid.Row="5" Text="采样密度"/><TextBox x:Name="L2Points" Grid.Row="5" Grid.Column="1"/>
                            </Grid>
                        </GroupBox>
                        <GroupBox Header="抓边参数">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/>
                                    <RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="平滑系数"/><TextBox x:Name="L2Sigma" Grid.Column="1"/>
                                <TextBlock Grid.Row="1" Text="灰度阈值"/><TextBox x:Name="L2Threshold" Grid.Row="1" Grid.Column="1"/>
                                <TextBlock Grid.Row="2" Text="拟合数量"/><TextBox x:Name="L2NumInstances" Grid.Row="2" Grid.Column="1"/>
                                <TextBlock Grid.Row="3" Text="剔除距离"/><TextBox x:Name="L2DistThreshold" Grid.Row="3" Grid.Column="1"/>
                                <TextBlock Grid.Row="4" Text="最小得分"/><TextBox x:Name="L2MinScore" Grid.Row="4" Grid.Column="1"/>
                                <TextBlock Grid.Row="5" Text="迭代次数"/><TextBox x:Name="L2Iterations" Grid.Row="5" Grid.Column="1"/>
                                <TextBlock Grid.Row="6" Text="明暗方向"/><ComboBox x:Name="L2Transition" Grid.Row="6" Grid.Column="1"/>
                                <TextBlock Grid.Row="7" Text="边缘选取"/><ComboBox x:Name="L2Select" Grid.Row="7" Grid.Column="1"/>
                                <TextBlock Grid.Row="8" Text="插值类型"/><ComboBox x:Name="L2Interpolation" Grid.Row="8" Grid.Column="1"/>
                                <TextBlock Grid.Row="9" Text="结果区域"/><ComboBox x:Name="L2IORegions" Grid.Row="9" Grid.Column="1"/>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="结果输出">
                <StackPanel>
                    <GroupBox Header="实时结果">
                        <StackPanel>
                            <TextBlock x:Name="TxtLineAngle" Text="夹角：-" Foreground="#00E5FF" FontSize="28" FontWeight="Bold" Margin="4,8"/>
                            <TextBlock x:Name="TxtResultRow" Text="交点行：--" Margin="4,6"/>
                            <TextBlock x:Name="TxtResultCol" Text="交点列：--" Margin="4,6"/>
                            <TextBlock x:Name="TxtParallel" Text="是否平行：-" Margin="4,6"/>
                            <TextBlock x:Name="TxtLine1Success" Text="线1拟合：-" Margin="4,18,4,6"/>
                            <TextBlock x:Name="TxtLine2Success" Text="线2拟合：-" Margin="4,6"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
