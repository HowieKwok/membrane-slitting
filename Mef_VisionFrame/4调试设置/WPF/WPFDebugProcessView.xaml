<UserControl
    x:Class="Mef_VisionFrame.调试设置.WPF.WPFDebugProcessView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="760"
    d:DesignWidth="1220"
    Background="#061018"
    Loaded="UserControl_Loaded"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="Foreground" Value="#E8FBFF" />
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="#0D1723" />
            <Setter Property="BorderBrush" Value="#1C6E86" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="8" />
        </Style>
        <Style x:Key="GlowButton" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Margin" Value="4,2" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="#E8FBFF" />
            <Setter Property="Background" Value="#0D2230" />
            <Setter Property="BorderBrush" Value="#15748A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="CommandGroup" TargetType="Border">
            <Setter Property="Background" Value="#081522" />
            <Setter Property="BorderBrush" Value="#1C6E86" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.Background>
            <DrawingBrush
                Opacity="0.32"
                TileMode="Tile"
                Viewport="0,0,44,44"
                ViewportUnits="Absolute">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="#061018">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,44,44" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="#0B2A36">
                            <GeometryDrawing.Geometry>
                                <GeometryGroup>
                                    <RectangleGeometry Rect="0,0,1,44" />
                                    <RectangleGeometry Rect="0,0,44,1" />
                                </GeometryGroup>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="98" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Background="#0B1824"
            BorderBrush="#23869E"
            BorderThickness="0,0,0,1">
            <Grid Margin="18,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        FontSize="24"
                        FontWeight="Bold"
                        Foreground="#00E5FF"
                        Text="调试流程界面" />
                    <TextBlock
                        x:Name="StatusText"
                        Margin="0,6,0,0"
                        FontSize="12"
                        Foreground="#7EE6FF"
                        Text="状态：等待操作" />
                </StackPanel>
                <Grid
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CommandGroup}">
                        <DockPanel LastChildFill="True">
                            <TextBlock
                                Margin="4,0,0,4"
                                DockPanel.Dock="Top"
                                FontSize="12"
                                Foreground="#7EE6FF"
                                Text="流程控制" />
                            <WrapPanel>
                                <Button
                                    Click="BtnAddProcess_Click"
                                    Content="新建"
                                    Style="{StaticResource GlowButton}" />
                                <Button
                                    Click="BtnDeleteProcess_Click"
                                    Content="删除"
                                    Style="{StaticResource GlowButton}" />
                                <Button
                                    Click="BtnRebuild_Click"
                                    Content="重建"
                                    Style="{StaticResource GlowButton}" />
                                <Button
                                    Click="BtnLoad_Click"
                                    Content="加载"
                                    Style="{StaticResource GlowButton}" />
                                <Button
                                    Click="BtnSave_Click"
                                    Content="保存"
                                    Style="{StaticResource GlowButton}" />
                            </WrapPanel>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CommandGroup}">
                        <DockPanel LastChildFill="True">
                            <TextBlock
                                Margin="4,0,0,4"
                                DockPanel.Dock="Top"
                                FontSize="12"
                                Foreground="#7EE6FF"
                                Text="模块调试" />
                            <WrapPanel>
                                <Button
                                    Click="BtnAddModule_Click"
                                    Content="添加"
                                    Style="{StaticResource GlowButton}" />
                                <Button
                                    Click="BtnDeleteModule_Click"
                                    Content="删除"
                                    Style="{StaticResource GlowButton}" />
                                <Button
                                    Click="BtnRunOnce_Click"
                                    Content="运行一次"
                                    Style="{StaticResource GlowButton}" />
                                <Button
                                    Click="BtnRunLoop_Click"
                                    Content="循环"
                                    Style="{StaticResource GlowButton}" />
                                <Button
                                    Click="BtnRunStop_Click"
                                    Content="停止"
                                    Style="{StaticResource GlowButton}" />
                                <Button
                                    x:Name="BtnToggleContainerTop"
                                    Click="BtnToggleContainer_Click"
                                    Content="隐藏容器"
                                    Style="{StaticResource GlowButton}" />
                            </WrapPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4.5*" />
                <ColumnDefinition Width="5.5*" />
                <ColumnDefinition x:Name="PluginContainerColumn" Width="360" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Panel}">
                <DockPanel>
                    <TextBlock
                        Margin="0,0,0,14"
                        DockPanel.Dock="Top"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="#00E5FF"
                        Text="流程列表" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ProcessPanel" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Panel}">
                <DockPanel>
                    <TextBlock
                        Margin="0,0,0,14"
                        DockPanel.Dock="Top"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="#00E5FF"
                        Text="模块列表" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="SelectedModulePanel" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <Border
                x:Name="PluginContainerPanel"
                Grid.Column="2"
                Style="{StaticResource Panel}">
                <DockPanel>
                    <Grid Margin="0,0,0,14" DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="#00E5FF"
                            Text="模块容器" />
                        <Button
                            Grid.Column="1"
                            MinWidth="64"
                            Click="BtnToggleContainer_Click"
                            Content="收起"
                            Style="{StaticResource GlowButton}" />
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PluginCategoryPanel" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
