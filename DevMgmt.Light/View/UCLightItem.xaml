<UserControl
    x:Class="DevMgmt.Light.View.UCLightItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DevMgmt.Light.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tool="clr-namespace:DevMgmt.Light.Tool"
    xmlns:usercontrols="clr-namespace:FrameCommunity.UserControls;assembly=FrameCommunity"
    d:DesignHeight="450"
    d:DesignWidth="400"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="ItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="#102536" />
            <Setter Property="Foreground" Value="#DCF8FF" />
            <Setter Property="BorderBrush" Value="#2F7E98" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <!--  强制内部内容横向铺满整行  -->
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2F7E98" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DCF8FF" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="35" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#102536" />
            <Setter Property="BorderBrush" Value="#00A9C8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#DCF8FF" />
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,2,0,8" />
            <Setter Property="Foreground" Value="#102536" />
            <Setter Property="Background" Value="#102536" />
            <Setter Property="BorderBrush" Value="#2F7E98" />
            <Setter Property="IsEditable" Value="False" />
        </Style>

        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="82" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Foreground" Value="#E9FBFF" />
            <Setter Property="Background" Value="#102536" />
            <Setter Property="BorderBrush" Value="#00A9C8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <SolidColorBrush x:Key="SelectedBrush" Color="#2F7E98" />
        <SolidColorBrush x:Key="UnSelectedBrush" Color="#102536" />
    </UserControl.Resources>

    <Grid Background="#08111B">
        <ListBox
            x:Name="LightItemPanel"
            Margin="0"
            Padding="0"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            d:ItemsSource="{d:SampleData ItemCount=3}"
            Background="Transparent"
            BorderThickness="0"
            ItemContainerStyle="{StaticResource ItemStyle}"
            ItemsSource="{Binding LightChannelItems}">

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <!--  标题行30，控件行统一30高度，完全匹配  -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="35" />
                            <RowDefinition Height="45" />
                        </Grid.RowDefinitions>

                        <!--  顶部标题  -->
                        <TextBlock
                            Grid.Row="0"
                            VerticalAlignment="Center"
                            Text="{Binding DisplayName, Mode=OneWay}" />

                        <!--  控件行两列布局  -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--  左侧开关按钮：固定高30，垂直居中  -->
                            <Button
                                Grid.Column="0"
                                Height="35"
                                Padding="0,0,0,0"
                                VerticalAlignment="Center"
                                Background="{Binding SwitchState, Mode=OneWay, Converter={tool:BoolToStatusBrushConverter}}"
                                BorderBrush="#00A9C8"
                                BorderThickness="1"
                                Command="{Binding OepnClosingLight, ElementName=LightItemPanel}"
                                CommandParameter="{Binding}"
                                Foreground="#DCF8FF">
                                <Button.Content>
                                    <Binding
                                        Converter="{tool:BoolOpenClosingConnectTextConverter}"
                                        Mode="OneWay"
                                        Path="SwitchState" />
                                </Button.Content>
                            </Button>

                            <!--  右侧亮度输入框：同高30，左侧留10px间距，自动填充剩余宽度  -->
                            <usercontrols:NumericBox
                                Grid.Column="1"
                                Height="35"
                                Margin="0,5,0,5"
                                Padding="10,0,0,0"
                                DecimalPlaces="0"
                                Increment="1"
                                Maximum="255"
                                Minimum="0"
                                Value="{Binding Brightness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>