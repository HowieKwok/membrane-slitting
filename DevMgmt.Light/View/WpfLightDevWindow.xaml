<Window
    x:Class="DevMgmt.Light.View.WpfLightDevWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DevMgmt.Light.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tool="clr-namespace:DevMgmt.Light.Tool"
    Title="光源控制器管理"
    Width="1200"
    Height="900"
    Closing="Window_Closing"
    mc:Ignorable="d">
    <Window.Resources>

        <!--  绑定代理，指向全局 ViewModel  -->
        <local:BindingProxy x:Key="VmProxy" Data="{Binding}" />

        <!--  右键菜单  -->
        <ContextMenu x:Key="ItemMenu" StaysOpen="true">
            <MenuItem
                Command="{Binding Data.RenameCommand, Source={StaticResource VmProxy}}"
                CommandParameter="{Binding}"
                Header="重命名" />
            <Separator />
            <MenuItem
                Command="{Binding Data.DeleteCommand, Source={StaticResource VmProxy}}"
                CommandParameter="{Binding}"
                Header="删除" />
        </ContextMenu>


        <Style x:Key="ItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="#102536" />
            <Setter Property="Foreground" Value="#DCF8FF" />
            <Setter Property="BorderBrush" Value="#2F7E98" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Cursor" Value="Hand" />

            <!--  新增：绑定右键菜单  -->
            <Setter Property="ContextMenu" Value="{StaticResource ItemMenu}" />

            <!--  选中状态切换背景  -->
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2F7E98" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DCF8FF" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="35" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#102536" />
            <Setter Property="BorderBrush" Value="#00A9C8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#DCF8FF" />
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,2,0,8" />
            <Setter Property="Foreground" Value="#102536" />
            <Setter Property="Background" Value="#102536" />
            <Setter Property="BorderBrush" Value="#2F7E98" />
            <Setter Property="IsEditable" Value="False" />
        </Style>
        <!--<Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E9FBFF" />
            <Setter Property="Background" Value="#102536" />
        </Style>-->
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="82" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Foreground" Value="#E9FBFF" />
            <Setter Property="Background" Value="#102536" />
            <Setter Property="BorderBrush" Value="#00A9C8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!--  选中颜色  -->
        <SolidColorBrush x:Key="SelectedBrush" Color="#2F7E98" />
        <SolidColorBrush x:Key="UnSelectedBrush" Color="#102536" />


    </Window.Resources>

    <Grid Background="#08111B">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>
        <!--  列定义不变：左200 / 自适应 / 右420  -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  左侧：设备列表 (Column 0 保持不变)  -->
        <Border
            Grid.Row="0"
            Grid.Column="0"
            Padding="1,0"
            Background="#101A26"
            BorderBrush="#2F7E98"
            BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="54" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  标题 + +号按钮  -->
                <Grid Grid.Row="0">
                    <TextBlock
                        Padding="14,0"
                        VerticalAlignment="Center"
                        FontSize="21"
                        FontWeight="Bold"
                        Foreground="#E0F7FF"
                        Text="设备列表" />
                    <Button
                        Width="30"
                        Margin="200,12,0,12"
                        HorizontalAlignment="Left"
                        Background="#102536"
                        BorderBrush="#00A9C8"
                        BorderThickness="1"
                        Command="{Binding AddDeviceCommand}"
                        Content="+"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="#00E5FF" />
                </Grid>

                <!--  列表容器  -->
                <Border
                    Grid.Row="1"
                    MaxWidth="500"
                    Background="#102536"
                    BorderBrush="#2F7E98"
                    BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ListBox
                            x:Name="DevItemPanel"
                            Padding="5"
                            d:ItemsSource="{d:SampleData ItemCount=5}"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemContainerStyle="{StaticResource ItemStyle}"
                            ItemsSource="{Binding Param.l_LightControllerDevs}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <!--  三列布局：ID | 名称 | 连接开关  -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="50" />
                                        </Grid.ColumnDefinitions>

                                        <!--  第一列：ID  -->
                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontWeight="Bold"
                                            Text="{Binding LightControllerParameter.ID}" />

                                        <!--  第二列：名称  -->
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="1,0"
                                            VerticalAlignment="Center"
                                            Text="{Binding LightControllerParameter.LightControllerName}" />

                                        <!--  第三列：连接状态开关  -->
                                        <Button
                                            Grid.Column="2"
                                            Width="50"
                                            Height="35"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Background="{Binding ConnStatus, Mode=OneWay, Converter={tool:BoolToStatusBrushConverter}}"
                                            BorderBrush="#00A9C8"
                                            BorderThickness="1"
                                            Command="{Binding DataContext.ToggleConnectCommand, ElementName=DevItemPanel}"
                                            CommandParameter="{Binding}"
                                            Foreground="#DCF8FF">
                                            <Button.Content>
                                                <Binding
                                                    Converter="{tool:BoolConnectTextConverter}"
                                                    Mode="OneWay"
                                                    Path="ConnStatus" />
                                            </Button.Content>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <!--  已移除外层 ContextMenu  -->
                        </ListBox>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <!--  中间列：原右侧【图像参数】区域  Column 1  -->
        <Border
            Grid.Row="0"
            Grid.Column="1"
            Padding="1,0"
            Background="#101A26"
            BorderBrush="#2F7E98"
            BorderThickness="1">

            <ScrollViewer Background="#111923" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="DevParameterPanel" />
            </ScrollViewer>
        </Border>

        <!--  底部信息栏 (整行跨列)  -->
        <Border
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Padding="12,0"
            Background="#101923"
            BorderBrush="#255F72"
            BorderThickness="1">

            <DockPanel LastChildFill="True">
                <Button
                    x:Name="Btn_Save"
                    Width="90"
                    Height="28"
                    Margin="0,0,5,0"
                    Background="#102536"
                    BorderBrush="#00A9C8"
                    BorderThickness="1"
                    Command="{Binding SaveCommand}"
                    Content="保存"
                    DockPanel.Dock="Right"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="#E9FBFF" />

                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="#AEC7D3"
                    Text="{Binding MouseInfo}" />
            </DockPanel>
        </Border>

    </Grid>
</Window>
