<UserControl x:Class="Plugin.ReusableMeasureDetect.Views.ReusableMeasureDetectUser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
             xmlns:controls="clr-namespace:Plugin.ReusableMeasureDetect.Controls"
             xmlns:pointFilter="clr-namespace:Plugin.ReusableMeasureDetect.PointFilters.Controls"
            >
    <UserControl.Resources>
        <SolidColorBrush x:Key="ShellBackgroundBrush" Color="#08111B"/>
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#111923"/>
        <SolidColorBrush x:Key="PanelDarkBrush" Color="#0B1520"/>
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#07111C"/>
        <SolidColorBrush x:Key="BorderBrushValue" Color="#215D73"/>
        <SolidColorBrush x:Key="BorderSoftBrush" Color="#1B5264"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#00E5FF"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#7EE6FF"/>
        <SolidColorBrush x:Key="TextBrush" Color="#DCF8FF"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#9FC7D8"/>

        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,2,0,6"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushValue}"/>
        </Style>

        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="14" Height="14" Margin="0,1,7,0"
                                    BorderBrush="{StaticResource BorderBrushValue}" BorderThickness="1"
                                    Background="{StaticResource InputBackgroundBrush}">
                                <Path x:Name="CheckMark" Data="M 2 7 L 6 11 L 12 3"
                                      Stroke="{StaticResource AccentBrush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter RecognizesAccessKey="True"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentSoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboToggleButton" TargetType="{x:Type ToggleButton}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="Chrome"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2">
                            <Grid>
                                <Path Width="8" Height="5" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Margin="0,0,8,0" Fill="{StaticResource AccentSoftBrush}"
                                      Data="M 0 0 L 8 0 L 4 5 Z"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Chrome" Property="Background" Value="#102536"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,2,0,6"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushValue}"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Style="{StaticResource ComboToggleButton}"/>
                            <ContentPresenter x:Name="ContentSite"
                                              Margin="8,0,24,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              IsHitTestVisible="False"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Slide">
                                <Grid MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="{StaticResource PanelDarkBrush}"
                                            BorderBrush="{StaticResource AccentBrush}"
                                            BorderThickness="1">
                                        <ScrollViewer SnapsToDevicePixels="True">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource PanelDarkBrush}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#123044"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#102536"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollViewer}">
            <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}"/>
        </Style>

        <Style TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="{StaticResource PanelBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushValue}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel x:Name="HeaderPanel"
                                      Panel.ZIndex="1"
                                      Margin="0"
                                      IsItemsHost="True"
                                      Background="Transparent"/>
                            <Border x:Name="ContentPanel"
                                    Grid.Row="1"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    Background="{TemplateBinding Background}">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  Margin="0"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#102536"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushValue}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="3,3,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource ShellBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Panel.ZIndex" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#173246"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentSoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type GroupBox}">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
            <Setter Property="Background" Value="{StaticResource PanelDarkBrush}"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GroupBox}">
                        <Grid SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.RowSpan="2"
                                    Margin="0,8,0,0"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3"/>
                            <Border HorizontalAlignment="Left"
                                    Margin="8,0,0,0"
                                    Padding="8,1"
                                    Background="{StaticResource PanelBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderSoftBrush}"
                                    BorderThickness="1"
                                    CornerRadius="2">
                                <ContentPresenter ContentSource="Header"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                  TextElement.FontWeight="SemiBold"/>
                            </Border>
                            <ContentPresenter Grid.Row="1" Margin="8,12,8,8"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
        </Style>

        <Style TargetType="{x:Type ListBoxItem}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#102536"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#123044"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="RowBackground" Value="#0B1520"/>
            <Setter Property="AlternatingRowBackground" Value="#0F1B29"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderSoftBrush}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{StaticResource BorderSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="ColumnHeaderHeight" Value="28"/>
            <Setter Property="RowHeight" Value="25"/>
        </Style>

        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Foreground" Value="{StaticResource AccentSoftBrush}"/>
            <Setter Property="Background" Value="#102536"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="6,2"/>
        </Style>

        <Style TargetType="{x:Type DataGridRow}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#0B1520"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#123044"/>
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type DataGridCell}">
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="4,1"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#123044"/>
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToolButton" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#102536"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#173246"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentSoftBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#06101A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource ShellBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="460"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Margin="8" BorderBrush="{StaticResource BorderBrushValue}" BorderThickness="1" Background="#020407">
            <Grid>
                <wfi:WindowsFormsHost x:Name="MainHost" Background="#020407"/>
                <Popup Placement="MousePoint"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       IsOpen="{Binding IsFollowMenuOpen, Mode=TwoWay}">
                    <Border Background="#102536" BorderBrush="#00E5FF" BorderThickness="1" Padding="6">
                        <StackPanel>
                            <Button Style="{StaticResource ToolButton}" MinWidth="130" Content="设置基准坐标" Command="{Binding SetBasePoseCommand}"/>
                            <Button Style="{StaticResource ToolButton}" MinWidth="130" Content="设置当前位置" Command="{Binding SetCurrentPoseCommand}" Margin="0"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <TabControl Grid.Row="0" Grid.Column="1" Margin="0,8,8,8" Background="{StaticResource PanelBackgroundBrush}">
            <TabItem Header="ROI 抓边">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#101826">
                    <StackPanel Margin="8" Background="#101826">
                        <GroupBox Header="工具开关">
                            <StackPanel Background="#101826">
                                <CheckBox Content="启用插件" IsChecked="{Binding EnablePlugin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <CheckBox Content="启用图像抓边" IsChecked="{Binding EnableMeasureGrab, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <CheckBox Content="启用 ROI" IsChecked="{Binding EnableRoi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="ROI 几何参数">
                            <UniformGrid Columns="2">
                                <TextBlock Text="中心 Row"/>
                                <controls:NumericBox Value="{Binding RoiCenterRow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DecimalPlaces="2" Increment="1"/>
                                <TextBlock Text="中心 Col"/>
                                <controls:NumericBox Value="{Binding RoiCenterCol, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DecimalPlaces="2" Increment="1"/>
                                <TextBlock Text="角度 Deg"/>
                                <controls:NumericBox Value="{Binding RoiAngleDeg, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="-180" Maximum="180" DecimalPlaces="2" Increment="1"/>
                                <TextBlock Text="ROI 高度"/>
                                <controls:NumericBox Value="{Binding RoiHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="2" DecimalPlaces="2" Increment="1"/>
                                <TextBlock Text="ROI 宽度"/>
                                <controls:NumericBox Value="{Binding RoiWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="2" DecimalPlaces="2" Increment="1"/>
                                <TextBlock Text="抓边点数"/>
                                <controls:NumericBox Value="{Binding RoiPointNum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="2" DecimalPlaces="0" Increment="1"/>
                            </UniformGrid>
                        </GroupBox>

                        <GroupBox Header="ROI 位置跟随">
                            <StackPanel Background="#101826">
                                <CheckBox Content="启用 ROI 位置跟随" IsChecked="{Binding EnablePositionFollow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="{Binding FollowOffsetText}" Foreground="#7EE6FF" Margin="0,0,0,6"/>
                                <UniformGrid Columns="2">
                                    <TextBlock Text="基准 Row"/>
                                    <controls:NumericBox Value="{Binding BaseRow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DecimalPlaces="3" Increment="1"/>
                                    <TextBlock Text="基准 Col"/>
                                    <controls:NumericBox Value="{Binding BaseCol, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DecimalPlaces="3" Increment="1"/>
                                    <TextBlock Text="基准角度"/>
                                    <controls:NumericBox Value="{Binding BaseAngle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="-180" Maximum="180" DecimalPlaces="3" Increment="0.1"/>
                                    <TextBlock Text="当前 Row"/>
                                    <controls:NumericBox Value="{Binding CurrentRow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DecimalPlaces="3" Increment="1"/>
                                    <TextBlock Text="当前 Col"/>
                                    <controls:NumericBox Value="{Binding CurrentCol, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DecimalPlaces="3" Increment="1"/>
                                    <TextBlock Text="当前角度"/>
                                    <controls:NumericBox Value="{Binding CurrentAngle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="-180" Maximum="180" DecimalPlaces="3" Increment="0.1"/>
                                </UniformGrid>
                                <CheckBox Content="当前坐标有效" IsChecked="{Binding CurrentPoseValid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <UniformGrid Columns="2">
                                    <Button Style="{StaticResource ToolButton}" Content="以当前 ROI 设基准" Command="{Binding SetBasePoseCommand}" Margin="0,0,3,6"/>
                                    <Button Style="{StaticResource ToolButton}" Content="以当前 ROI 设当前位置" Command="{Binding SetCurrentPoseCommand}" Margin="3,0,0,6"/>
                                </UniformGrid>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="HALCON 抓边参数">
                            <UniformGrid Columns="2">
                                <TextBlock Text="Sigma"/>
                                <controls:NumericBox Value="{Binding MeasureSigma, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0.1" DecimalPlaces="2" Increment="0.1"/>
                                <TextBlock Text="Threshold"/>
                                <controls:NumericBox Value="{Binding MeasureThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" DecimalPlaces="2" Increment="1"/>
                                <TextBlock Text="Instances"/>
                                <controls:NumericBox Value="{Binding MeasureNumInstances, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="1" DecimalPlaces="0" Increment="1"/>
                                <TextBlock Text="距离阈值"/>
                                <controls:NumericBox Value="{Binding MeasureDistThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" DecimalPlaces="2" Increment="0.5"/>
                                <TextBlock Text="MinScore"/>
                                <controls:NumericBox Value="{Binding MeasureMinScore, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="1" DecimalPlaces="3" Increment="0.05"/>
                                <TextBlock Text="迭代次数"/>
                                <controls:NumericBox Value="{Binding MaxNumIterations, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="-1" DecimalPlaces="0" Increment="1"/>
                                <TextBlock Text="边缘极性"/>
                                <ComboBox SelectedValue="{Binding MeasureTransition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag">
                                    <ComboBoxItem Content="all" Tag="all"/>
                                    <ComboBoxItem Content="positive" Tag="positive"/>
                                    <ComboBoxItem Content="negative" Tag="negative"/>
                                    <ComboBoxItem Content="uniform" Tag="uniform"/>
                                </ComboBox>
                                <TextBlock Text="边缘选择"/>
                                <ComboBox SelectedValue="{Binding MeasureSelect, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag">
                                    <ComboBoxItem Content="all" Tag="all"/>
                                    <ComboBoxItem Content="first" Tag="first"/>
                                    <ComboBoxItem Content="last" Tag="last"/>
                                </ComboBox>
                                <TextBlock Text="插值方式"/>
                                <ComboBox SelectedValue="{Binding MeasureInterpolation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag">
                                    <ComboBoxItem Content="bilinear" Tag="bilinear"/>
                                    <ComboBoxItem Content="nearest_neighbor" Tag="nearest_neighbor"/>
                                    <ComboBoxItem Content="bicubic" Tag="bicubic"/>
                                </ComboBox>
                                <TextBlock Text="区域越界"/>
                                <ComboBox SelectedValue="{Binding MeasureIORegions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag">
                                    <ComboBoxItem Content="false" Tag="false"/>
                                    <ComboBoxItem Content="true" Tag="true"/>
                                </ComboBox>
                            </UniformGrid>
                        </GroupBox>

                        <GroupBox Header="图像预处理 / 离群剔除">
                            <StackPanel Background="#101826">
                                <UniformGrid Columns="2">
                                    <TextBlock Text="GrayOpening"/>
                                    <controls:NumericBox Value="{Binding ScaleMean, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" DecimalPlaces="2" Increment="1"/>
                                    <TextBlock Text="中值剔除系数"/>
                                    <controls:NumericBox Value="{Binding PointMedianRangeFactor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0.1" DecimalPlaces="2" Increment="0.1"/>
                                </UniformGrid>
                                <CheckBox Content="启用抓边后中值剔除" IsChecked="{Binding EnablePointMedianReject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </GroupBox>

                        <Button Style="{StaticResource ToolButton}" Content="加载图片仿真" Command="{Binding LoadImageCommand}"/>
                        <Button Style="{StaticResource ToolButton}" Content="适应显示" Command="{Binding FitWindowCommand}"/>
                        <Button Style="{StaticResource ToolButton}" Content="按点集重置 ROI"  Command="{Binding ResetRoiFromPointsCommand}"/>
                        <Button Style="{StaticResource ToolButton}" Content="执行检测" Command="{Binding RunCommand}"/>
                        <Button Style="{StaticResource ToolButton}" Content="演示点集" Command="{Binding DemoPointsCommand}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="滤波">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#101826">
                    <pointFilter:FilterUserControl DataContext="{Binding FilterEditor}" Margin="8"/>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="凸点检测">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#101826">
                    <StackPanel Margin="8" Background="#101826">
                        <GroupBox Header="功能开关">
                            <StackPanel Background="#101826">
                                <CheckBox Content="启用凸点检测" IsChecked="{Binding EnableConvexPeakDetection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="检测方法：角点凸点" Foreground="#7EE6FF"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="候选点筛选">
                            <UniformGrid Columns="2">
                                <TextBlock Text="平滑窗口"/>
                                <controls:NumericBox Value="{Binding ConvexSmoothWindow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="1" DecimalPlaces="0" Increment="1"/>
                                <TextBlock Text="支撑窗口"/>
                                <controls:NumericBox Value="{Binding ConvexSupportWindow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="2" DecimalPlaces="0" Increment="1"/>
                                <TextBlock Text="离群半径"/>
                                <controls:NumericBox Value="{Binding ConvexOutlierRadius, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" DecimalPlaces="2" Increment="1"/>
                                <TextBlock Text="离群邻点数"/>
                                <controls:NumericBox Value="{Binding ConvexOutlierMinNeighbors, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" DecimalPlaces="0" Increment="1"/>
                                <TextBlock Text="最小点距"/>
                                <controls:NumericBox Value="{Binding ConvexMinPeakDistance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" DecimalPlaces="2" Increment="1"/>
                            </UniformGrid>
                        </GroupBox>

                        <GroupBox Header="峰值判定阈值">
                            <UniformGrid Columns="2">
                                <TextBlock Text="最小坡度差"/>
                                <controls:NumericBox Value="{Binding ConvexMinSlopeDelta, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" DecimalPlaces="3" Increment="0.05"/>
                                <TextBlock Text="最小突出度"/>
                                <controls:NumericBox Value="{Binding ConvexMinProminence, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0.001" DecimalPlaces="3" Increment="0.05"/>
                                <TextBlock Text="最小得分"/>
                                <controls:NumericBox Value="{Binding ConvexMinPeakScore, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" DecimalPlaces="3" Increment="0.05"/>
                                <TextBlock Text="最小夹角"/>
                                <controls:NumericBox Value="{Binding ConvexMinTurnAngleDeg, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="90" DecimalPlaces="2" Increment="1"/>
                            </UniformGrid>
                        </GroupBox>

                        <GroupBox Header="链路连续性">
                            <UniformGrid Columns="2">
                                <TextBlock Text="最大间隙倍率"/>
                                <controls:NumericBox Value="{Binding ConvexMaxGapRatio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="1" DecimalPlaces="2" Increment="0.1"/>
                                <TextBlock Text="最大间隙补偿"/>
                                <controls:NumericBox Value="{Binding ConvexMaxGapExtra, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" DecimalPlaces="2" Increment="1"/>
                                <TextBlock Text="最小链点数"/>
                                <controls:NumericBox Value="{Binding ConvexMinChainPoints, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="2" DecimalPlaces="0" Increment="1"/>
                            </UniformGrid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="突变检测">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#101826">
                    <StackPanel Margin="8" Background="#101826">
                        <GroupBox Header="功能开关">
                            <StackPanel Background="#101826">
                                <CheckBox Content="启用突变检测" IsChecked="{Binding EnableJumpDetection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <CheckBox Content="显示突变调试" IsChecked="{Binding EnableJumpDebugDisplay, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="突变模式 / 阈值">
                            <UniformGrid Columns="2">
                                <TextBlock Text="模式"/>
                                <ComboBox SelectedValue="{Binding JumpMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag">
                                    <ComboBoxItem Content="Row 行方向突变" Tag="Row"/>
                                    <ComboBoxItem Content="Col 列方向突变" Tag="Col"/>
                                </ComboBox>
                                <TextBlock Text="Row 主边范围"/>
                                <controls:NumericBox Value="{Binding RowJumpThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" DecimalPlaces="2" Increment="0.5"/>
                                <TextBlock Text="Col 主边范围"/>
                                <controls:NumericBox Value="{Binding ColJumpThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" DecimalPlaces="2" Increment="0.5"/>
                            </UniformGrid>
                        </GroupBox>

                        <GroupBox Header="角度约束">
                            <UniformGrid Columns="2">
                                <TextBlock Text="Row 角度最小"/>
                                <controls:NumericBox Value="{Binding RowMainAngleMinDeg, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="90" DecimalPlaces="2" Increment="1"/>
                                <TextBlock Text="Row 角度最大"/>
                                <controls:NumericBox Value="{Binding RowMainAngleMaxDeg, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="90" DecimalPlaces="2" Increment="1"/>
                                <TextBlock Text="Col 角度最小"/>
                                <controls:NumericBox Value="{Binding ColMainAngleMinDeg, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="90" DecimalPlaces="2" Increment="1"/>
                                <TextBlock Text="Col 角度最大"/>
                                <controls:NumericBox Value="{Binding ColMainAngleMaxDeg, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="90" DecimalPlaces="2" Increment="1"/>
                                <TextBlock Text="主副边最小夹角"/>
                                <controls:NumericBox Value="{Binding MinTurnAngleDeg, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="90" DecimalPlaces="2" Increment="1"/>
                            </UniformGrid>
                        </GroupBox>

                        <GroupBox Header="拟合参数">
                            <UniformGrid Columns="2">
                                <TextBlock Text="拟合误差上限"/>
                                <controls:NumericBox Value="{Binding MaxFitError, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" DecimalPlaces="2" Increment="1"/>
                                <TextBlock Text="最少拟合点"/>
                                <controls:NumericBox Value="{Binding MinFitPoints, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="2" DecimalPlaces="0" Increment="1"/>
                                <TextBlock Text="主边最大拟合点"/>
                                <controls:NumericBox Value="{Binding MainMaxFitPoints, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="2" DecimalPlaces="0" Increment="1"/>
                                <TextBlock Text="副边最大拟合点"/>
                                <controls:NumericBox Value="{Binding SecondaryMaxFitPoints, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="2" DecimalPlaces="0" Increment="1"/>
                            </UniformGrid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="结果输出">
                <TabControl Background="#101826">
                    <TabItem Header="原始点">
                        <DataGrid ItemsSource="{Binding RawPointRows}" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False"/>
                    </TabItem>
                    <TabItem Header="滤波点">
                        <DataGrid ItemsSource="{Binding FilteredPointRows}" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False"/>
                    </TabItem>
                    <TabItem Header="凸点">
                        <DataGrid ItemsSource="{Binding ConvexResultRows}" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False"/>
                    </TabItem>
                    <TabItem Header="突变">
                        <DataGrid ItemsSource="{Binding JumpResultRows}" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False"/>
                    </TabItem>
                </TabControl>
            </TabItem>

            <TabItem Header="运行摘要">
                <StackPanel Margin="8" Background="#101826">
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <DataGrid ItemsSource="{Binding SummaryRows}" AutoGenerateColumns="True" IsReadOnly="True" CanUserAddRows="False"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="帮助">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#101826">
                    <TextBlock Margin="8" TextWrapping="Wrap"
                               Text="运行流程：图像输入 -> ROI 抓边 -> 滤波 Pipeline -> 凸点检测 / 突变检测 -> 输出结果。&#x0a;&#x0a;凸点检测和突变检测是两个独立功能，只有各自启用后才运行。凸点当前固定使用角点凸点算法，不再额外设置第二个启用开关。&#x0a;&#x0a;滤波控件按参数字段集合渲染，后续可整体抽到公共库。&#x0a;&#x0a;底部状态栏显示耗时、鼠标 Row/Col、灰度、图像大小、点数和 OK/NG。"/>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="{StaticResource BorderBrushValue}" BorderThickness="0,1,0,0" Background="#0B1520" Padding="8,4">
            <TextBlock Text="{Binding StatusBarText}" Foreground="{StaticResource TextBrush}"/>
        </Border>
    </Grid>
</UserControl>

