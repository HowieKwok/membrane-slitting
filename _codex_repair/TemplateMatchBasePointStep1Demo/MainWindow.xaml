<Window x:Class="TemplateMatchBasePointStep1Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        Title="Step1 ViewROI 图像显示拖拽 Demo"
        Width="1280"
        Height="820"
        MinWidth="980"
        MinHeight="620"
        Background="#07111F"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#0B1728"
                BorderBrush="#1A3657"
                BorderThickness="0,0,0,1"
                Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="读取图像"
                        Width="96"
                        Height="32"
                        Margin="0,0,8,0"
                        Click="OnLoadImageClick" />
                <Button Grid.Column="1"
                        Content="适应窗口"
                        Width="96"
                        Height="32"
                        Click="OnFitImageClick" />

                <TextBlock Grid.Column="2"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="#A9D8FF"
                           FontSize="15"
                           Text="ViewROI：左键拖拽图像，滚轮缩放，双击适应窗口" />

                <TextBlock Grid.Column="3"
                           VerticalAlignment="Center"
                           Foreground="#68F5FF"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Text="{Binding ImageSizeText}" />
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="12"
                Background="#02060B"
                BorderBrush="#1B4368"
                BorderThickness="1">
            <wfi:WindowsFormsHost x:Name="HalconHost" />
        </Border>

        <Border Grid.Row="2"
                Background="#081525"
                BorderBrush="#1A3657"
                BorderThickness="0,1,0,0"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Foreground="White"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Text="{Binding MouseRowText}" />
                <TextBlock Grid.Column="1"
                           Foreground="White"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Text="{Binding MouseColText}" />
                <TextBlock Grid.Column="2"
                           Foreground="White"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Text="{Binding GrayText}" />
                <TextBlock Grid.Column="3"
                           HorizontalAlignment="Right"
                           Foreground="#A9D8FF"
                           FontSize="14"
                           Text="{Binding StatusText}" />
            </Grid>
        </Border>
    </Grid>
</Window>
