  </ItemGroup>

  <ItemGroup>
    <Reference Include="halcondotnet">
      <HintPath>E:\halconPath\bin\dotnet35\halcondotnet.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
