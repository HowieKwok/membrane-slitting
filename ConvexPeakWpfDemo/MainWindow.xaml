<Window x:Class="ConvexPeakWpfDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="V角轮廓交点检测 - 多图仿真"
        Height="900" Width="1500" MinHeight="720" MinWidth="1220"
        Background="#17191c" Foreground="#f1f3f5"
        Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#23272c"/>
        <SolidColorBrush x:Key="LineBrush" Color="#3a4048"/>
        <SolidColorBrush x:Key="InputBrush" Color="#15181c"/>
        <SolidColorBrush x:Key="TextBrush" Color="#f1f3f5"/>
        <SolidColorBrush x:Key="HintBrush" Color="#aeb6c2"/>

        <Style TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="74"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="#2f80ed"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2f80ed"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#4a525c"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,8"/>
        </Style>

        <Style x:Key="ParamLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource HintBrush}"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="480"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#20242a" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="12">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                    <Button Content="单张图片" Click="BrowseImage_Click"/>
                    <Button Content="多张图片" Click="BrowseImages_Click"/>
                    <Button Content="文件夹" Click="BrowseFolder_Click"/>
                    <Button Content="加载" Click="LoadImage_Click"/>
                    <Button Content="检测当前" Background="#18a058" BorderBrush="#18a058" Click="Detect_Click"/>
                    <Button Content="批量仿真" Background="#b56a00" BorderBrush="#b56a00" Click="RunBatch_Click"/>
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="图像路径" VerticalAlignment="Center" Foreground="{StaticResource HintBrush}"/>
                    <TextBox Grid.Column="1" x:Name="ImagePathBox" Margin="0" Height="32"/>
                </Grid>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Grid.Column="0" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="190"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#0e1013" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                <Grid ClipToBounds="True">
                    <Image x:Name="ImageView"
                           Stretch="Fill"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           SnapsToDevicePixels="True"/>
                    <Canvas x:Name="OverlayCanvas"
                            Background="Transparent"
                            SizeChanged="OverlayCanvas_SizeChanged"
                            MouseLeftButtonDown="OverlayCanvas_MouseLeftButtonDown"
                            MouseMove="OverlayCanvas_MouseMove"
                            MouseLeftButtonUp="OverlayCanvas_MouseLeftButtonUp"
                            MouseRightButtonDown="OverlayCanvas_MousePanButtonDown"
                            MouseRightButtonUp="OverlayCanvas_MousePanButtonUp"
                            MouseDown="OverlayCanvas_MouseDown"
                            MouseUp="OverlayCanvas_MouseUp"
                            MouseWheel="OverlayCanvas_MouseWheel"
                            MouseLeave="OverlayCanvas_MouseLeave"/>
                    <TextBlock Text="滚轮缩放；右键/中键拖动画面；左键拖拽 ROI；自动定位需先用当前 ROI 生成模板"
                               HorizontalAlignment="Left" VerticalAlignment="Top"
                               Margin="12" Padding="8,4"
                               Background="#AA101317" Foreground="#d9e2ec"
                               IsHitTestVisible="False"/>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="12">
                        <Button Content="适应窗口" Click="ZoomFit_Click"/>
                        <Button Content="1:1" Click="ZoomOneToOne_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="CursorInfoText"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Bottom"
                               Margin="12"
                               Padding="8,4"
                               MinWidth="260"
                               FontFamily="Consolas"
                               Background="#AA101317"
                               Foreground="#d9e2ec"
                               Text="Row=-, Col=-, Gray=-, Zoom=100%"
                               IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Margin="0,10,0,0" Background="#111418" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                <DataGrid x:Name="ResultGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          IsReadOnly="True"
                          Background="#111418"
                          Foreground="#eef2f7"
                          RowBackground="#171b20"
                          AlternatingRowBackground="#1d2228"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="图像" Binding="{Binding ImageName}" Width="150"/>
                        <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="70"/>
                        <DataGridTextColumn Header="模式" Binding="{Binding Mode}" Width="130"/>
                        <DataGridTextColumn Header="P1 像素(Row,Col)" Binding="{Binding P1Pixel}" Width="145"/>
                        <DataGridTextColumn Header="P2 像素(Row,Col)" Binding="{Binding P2Pixel}" Width="145"/>
                        <DataGridTextColumn Header="P1 物理(X,Y)" Binding="{Binding P1Physical}" Width="145"/>
                        <DataGridTextColumn Header="P2 物理(X,Y)" Binding="{Binding P2Physical}" Width="145"/>
                        <DataGridTextColumn Header="基准线" Binding="{Binding BaseLine}" Width="105"/>
                        <DataGridTextColumn Header="DistanceX 平行" Binding="{Binding DistanceX}" Width="120"/>
                        <DataGridTextColumn Header="DistanceY 垂直" Binding="{Binding DistanceY}" Width="120"/>
                        <DataGridTextColumn Header="Distance 总长" Binding="{Binding Distance}" Width="100"/>
                        <DataGridTextColumn Header="耗时ms" Binding="{Binding ElapsedMs}" Width="80"/>
                        <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="多图仿真" Style="{StaticResource GroupTitle}" Margin="0,0,0,8"/>
                    <ListBox x:Name="ImageListBox"
                             Height="126"
                             Background="#15181c"
                             Foreground="#f1f3f5"
                             BorderBrush="#4a525c"
                             SelectionChanged="ImageListBox_SelectionChanged"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="上一张" Click="PreviousImage_Click"/>
                        <Button Content="下一张" Click="NextImage_Click"/>
                        <Button Content="清空" Click="ClearImages_Click"/>
                        <Button Content="导出CSV" Click="ExportCsv_Click"/>
                    </StackPanel>

                    <TextBlock Text="像素当量 / 物理坐标" Style="{StaticResource GroupTitle}"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="单位名称" Style="{StaticResource ParamLabel}"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="PhysicalUnitBox"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="X像素当量" Style="{StaticResource ParamLabel}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="PixelSizeXBox"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Y像素当量" Style="{StaticResource ParamLabel}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="PixelSizeYBox"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="原点 Row" Style="{StaticResource ParamLabel}"/>
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="OriginRowBox"/>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="原点 Col" Style="{StaticResource ParamLabel}"/>
                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="OriginColBox"/>
                    </Grid>
                    <CheckBox x:Name="YDownPositiveCheck" Content="Row 增大方向为物理 +Y" IsChecked="True" Checked="OverlayOption_Changed" Unchecked="OverlayOption_Changed"/>
                    <CheckBox x:Name="UseBaseLineCoordinateCheck" Content="使用基准线平行/垂直方向计算 DistanceX/DistanceY" IsChecked="True" Checked="OverlayOption_Changed" Unchecked="OverlayOption_Changed"/>

                    <TextBlock Text="ROI / 模板匹配" Style="{StaticResource GroupTitle}"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="中心 Row" Style="{StaticResource ParamLabel}"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="RoiCenterRowBox"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="中心 Col" Style="{StaticResource ParamLabel}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="RoiCenterColBox"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="角度 Deg" Style="{StaticResource ParamLabel}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="RoiPhiDegBox"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Length1 半宽" Style="{StaticResource ParamLabel}"/>
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="RoiLength1Box"/>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Length2 半高" Style="{StaticResource ParamLabel}"/>
                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="RoiLength2Box"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="应用 ROI" Click="ApplyRoi_Click"/>
                        <Button Content="重置示例" Click="ResetRoi_Click"/>
                    </StackPanel>

                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="模板路径" Style="{StaticResource ParamLabel}"/>
                        <DockPanel Grid.Row="0" Grid.Column="1" LastChildFill="True">
                            <Button Content="..." Width="34" MinWidth="34" Padding="0" Margin="6,3,0,3" DockPanel.Dock="Right" Click="BrowseTemplate_Click"/>
                            <TextBox x:Name="TemplatePathBox"/>
                        </DockPanel>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="最低分数" Style="{StaticResource ParamLabel}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="MatchMinScoreBox"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="起始角 Deg" Style="{StaticResource ParamLabel}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="MatchAngleStartDegBox"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="角度范围 Deg" Style="{StaticResource ParamLabel}"/>
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="MatchAngleExtentDegBox"/>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="最大重叠" Style="{StaticResource ParamLabel}"/>
                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="MatchMaxOverlapBox"/>
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="贪心系数" Style="{StaticResource ParamLabel}"/>
                        <TextBox Grid.Row="5" Grid.Column="1" x:Name="MatchGreedinessBox"/>
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="匹配 Row" Style="{StaticResource ParamLabel}"/>
                        <TextBox Grid.Row="6" Grid.Column="1" x:Name="MatchRowBox"/>
                        <TextBlock Grid.Row="7" Grid.Column="0" Text="匹配 Col" Style="{StaticResource ParamLabel}"/>
                        <TextBox Grid.Row="7" Grid.Column="1" x:Name="MatchColBox"/>
                        <TextBlock Grid.Row="8" Grid.Column="0" Text="匹配角 Deg" Style="{StaticResource ParamLabel}"/>
                        <TextBox Grid.Row="8" Grid.Column="1" x:Name="MatchAngleDegBox"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="模板匹配" Click="RunTemplateMatch_Click"/>
                        <Button Content="匹配更新ROI" Click="UseMatchRoi_Click"/>
                        <Button Content="ROI生成模板" MinWidth="112" Click="CreateTemplateFromRoi_Click"/>
                    </StackPanel>
                    <CheckBox x:Name="UseTemplateBeforeDetectCheck" Content="检测前先模板匹配定位 ROI（需先生成或选择模板）" IsChecked="False"/>

                    <TextBlock Text="边缘提取" Style="{StaticResource GroupTitle}"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Canny Alpha" Style="{StaticResource ParamLabel}"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="CannyAlphaBox"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Canny Low" Style="{StaticResource ParamLabel}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="CannyLowBox"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Canny High" Style="{StaticResource ParamLabel}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="CannyHighBox"/>
                    </Grid>

                    <TextBlock Text="轮廓拼接 / 分段" Style="{StaticResource GroupTitle}"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="最小轮廓长度" Style="{StaticResource ParamLabel}"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="MinContourLengthBox"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="拼接绝对距离" Style="{StaticResource ParamLabel}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="UnionMaxDistAbsBox"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="拼接相对距离" Style="{StaticResource ParamLabel}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="UnionMaxDistRelBox"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="分段平滑" Style="{StaticResource ParamLabel}"/>
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="SegmentSmoothBox"/>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="直线误差 1" Style="{StaticResource ParamLabel}"/>
                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="SegmentMaxLineDist1Box"/>
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="直线误差 2" Style="{StaticResource ParamLabel}"/>
                        <TextBox Grid.Row="5" Grid.Column="1" x:Name="SegmentMaxLineDist2Box"/>
                    </Grid>

                    <TextBlock Text="圆弧优先 / 曲率兜底" Style="{StaticResource GroupTitle}"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="最小圆弧长度" Style="{StaticResource ParamLabel}"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="MinArcLengthBox"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="最小半径" Style="{StaticResource ParamLabel}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="MinArcRadiusBox"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="最大半径" Style="{StaticResource ParamLabel}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="MaxArcRadiusBox"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="曲率步长" Style="{StaticResource ParamLabel}"/>
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="CurvatureStepBox"/>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="曲率角阈值 Deg" Style="{StaticResource ParamLabel}"/>
                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="CurvatureAngleThresholdDegBox"/>
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="最小连续点数" Style="{StaticResource ParamLabel}"/>
                        <TextBox Grid.Row="5" Grid.Column="1" x:Name="MinCurveRunPointsBox"/>
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="交点距离 px" Style="{StaticResource ParamLabel}"/>
                        <TextBox Grid.Row="6" Grid.Column="1" x:Name="MinPointDistanceBox"/>
                        <TextBlock Grid.Row="7" Grid.Column="0" Text="切线拟合点数" Style="{StaticResource ParamLabel}"/>
                        <TextBox Grid.Row="7" Grid.Column="1" x:Name="TangentFitPointsBox"/>
                        <TextBlock Grid.Row="8" Grid.Column="0" Text="切线偏离 px" Style="{StaticResource ParamLabel}"/>
                        <TextBox Grid.Row="8" Grid.Column="1" x:Name="TangentDepartureDistanceBox"/>
                    </Grid>

                    <CheckBox x:Name="ShowPartsCheck" Content="显示 lines/circles 分段" IsChecked="True" Checked="OverlayOption_Changed" Unchecked="OverlayOption_Changed"/>
                    <CheckBox x:Name="ShowMainContourCheck" Content="显示主轮廓" IsChecked="True" Checked="OverlayOption_Changed" Unchecked="OverlayOption_Changed"/>

                    <TextBlock Text="调参说明" Style="{StaticResource GroupTitle}"/>
                    <TextBlock Text="1. 先拖 ROI，只让 ROI 包住 V 角和两侧基准边，少放背景干扰；不使用模板时取消勾选模板匹配。&#10;2. 橙色轮廓已出来但没交点，优先调切线偏离阈值/切线拟合点数，这是针对长 S 型过渡。&#10;3. 如果主轮廓断裂，先降 Canny Low/High 或增大轮廓拼接距离；如果噪声多，升 Canny High 或增大最小轮廓长度。&#10;4. 如果识别到短小台阶/噪声，把最小交点距离或最小圆弧长度调大。&#10;5. 如果圆弧优先找不到，用曲率兜底：降低曲率角阈值或最小连续点数；误检时反向调高。"
                               Foreground="#cfd7e3"
                               TextWrapping="Wrap"
                               LineHeight="20"/>

                    <TextBlock Text="当前结果" Style="{StaticResource GroupTitle}"/>
                    <TextBlock x:Name="StatsText"
                               FontFamily="Consolas"
                               FontSize="13"
                               Foreground="#dce4ee"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#20242a" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,7">
            <TextBlock x:Name="StatusText" Foreground="#cfd7e3"/>
        </Border>
    </Grid>
</Window>
