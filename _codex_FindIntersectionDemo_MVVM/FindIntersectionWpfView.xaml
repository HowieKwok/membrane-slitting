<UserControl x:Class="Plugin.FindIntersection.FindIntersectionWpfView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
             Background="#070D14">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#101923"/>
        <SolidColorBrush x:Key="PanelBg2" Color="#08111B"/>
        <SolidColorBrush x:Key="LineBrush" Color="#255F72"/>
        <SolidColorBrush x:Key="Accent" Color="#00D8FF"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DCF8FF"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="27"/>
            <Setter Property="Margin" Value="0,2,0,7"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#07111A"/>
            <Setter Property="BorderBrush" Value="#28667A"/>
            <Setter Property="CaretBrush" Value="#00D8FF"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="27"/>
            <Setter Property="Margin" Value="0,2,0,7"/>
        </Style>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="78"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Foreground" Value="#E9FBFF"/>
            <Setter Property="Background" Value="#102536"/>
            <Setter Property="BorderBrush" Value="#00A9C8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="#111923"/>
            <Setter Property="BorderBrush" Value="#2F7E98"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#D9F8FF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,8"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="126"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="390"/>
        </Grid.ColumnDefinitions>

        <Border Grid.ColumnSpan="2" BorderBrush="#2F7E98" BorderThickness="1" Background="#101A26" Padding="14,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="500"/>
                    <ColumnDefinition Width="230"/>
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="两线交点工具" FontSize="21" FontWeight="Bold" Foreground="#00E5FF"/>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding StatusText}" Foreground="#9FC7D8"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolButton}" Content="加载图片" Click="LoadImage_Click"/>
                    <Button Style="{StaticResource ToolButton}" Content="十字光标" Click="CrossCursor_Click"/>
                    <Button Style="{StaticResource ToolButton}" Content="适应窗口" Click="FitWindow_Click"/>
                    <Button Style="{StaticResource ToolButton}" Content="保持ROI" Click="KeepRoi_Click"/>
                    <Button Style="{StaticResource ToolButton}" Content="运行" Click="RunPreview_Click"/>
                </StackPanel>
                <TextBlock Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Text="{Binding Angle, StringFormat=当前夹角：{0:F3} 度}" FontSize="17" FontWeight="Bold"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" BorderBrush="#215D73" BorderThickness="1" Background="#020407" Margin="0,10,12,8">
            <Grid>
                <wfi:WindowsFormsHost x:Name="HalconElementHost"/>
                <TextBlock x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Text="加载图片后显示 Halcon / ViewROI"
                           Foreground="#326B7B" FontSize="22"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" BorderBrush="#215D73" BorderThickness="1" Background="#08111B" Margin="0,0,12,8">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border BorderBrush="#1B5264" BorderThickness="1" Margin="0,0,6,0" Background="#050A10">
                    <Grid>
                        <TextBlock Text="H 灰度曲线" Foreground="#7EE6FF" Margin="8,6" Panel.ZIndex="1"/>
                        <Canvas x:Name="HProfileCanvas" Margin="8,24,8,8"/>
                    </Grid>
                </Border>
                <Border Grid.Column="1" BorderBrush="#1B5264" BorderThickness="1" Margin="6,0,0,0" Background="#050A10">
                    <Grid>
                        <TextBlock Text="V 灰度曲线" Foreground="#7EE6FF" Margin="8,6" Panel.ZIndex="1"/>
                        <Canvas x:Name="VProfileCanvas" Margin="8,24,8,8"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Grid.RowSpan="2" BorderBrush="#2F7E98" BorderThickness="1" Background="#111923" Margin="0,10,0,8">
            <TabControl>
                <TabItem Header="线1参数">
                    <ScrollViewer Padding="14">
                        <StackPanel>
                            <TextBlock Text="ROI 参数" Foreground="#00E5FF" FontWeight="Bold" Margin="0,0,0,8"/>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,8,0"><TextBlock Text="中心行"/><TextBox Text="{Binding Line1CenterRow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel><TextBlock Text="中心列"/><TextBox Text="{Binding Line1CenterColumn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Margin="0,0,8,0"><TextBlock Text="角度"/><TextBox Text="{Binding Line1Angle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel><TextBlock Text="高度"/><TextBox Text="{Binding Line1Height, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Margin="0,0,8,0"><TextBlock Text="宽度"/><TextBox Text="{Binding Line1Width, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel><TextBlock Text="采样点数"/><TextBox Text="{Binding Line1PointCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            </UniformGrid>
                            <Separator Margin="0,8,0,12" Background="#255F72"/>
                            <TextBlock Text="抓边参数" Foreground="#00E5FF" FontWeight="Bold" Margin="0,0,0,8"/>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,8,0"><TextBlock Text="Sigma"/><TextBox Text="{Binding Line1Sigma, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel><TextBlock Text="阈值"/><TextBox Text="{Binding Line1Threshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Margin="0,0,8,0"><TextBlock Text="边数量"/><TextBox Text="{Binding Line1NumInstances, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel><TextBlock Text="距离阈值"/><TextBox Text="{Binding Line1DistThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Margin="0,0,8,0"><TextBlock Text="最小得分"/><TextBox Text="{Binding Line1MinScore, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel><TextBlock Text="最大迭代"/><TextBox Text="{Binding Line1MaxIterations, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            </UniformGrid>
                            <TextBlock Text="明暗方向"/><ComboBox Text="{Binding Line1Transition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValue="{Binding Line1Transition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" IsEditable="True">
                                <ComboBoxItem Content="all"/>
                                <ComboBoxItem Content="positive"/>
                                <ComboBoxItem Content="negative"/>
                            </ComboBox>
                            <TextBlock Text="选择边"/><ComboBox Text="{Binding Line1Select, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValue="{Binding Line1Select, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" IsEditable="True">
                                <ComboBoxItem Content="first"/>
                                <ComboBoxItem Content="last"/>
                                <ComboBoxItem Content="all"/>
                            </ComboBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="线2参数">
                    <ScrollViewer Padding="14">
                        <StackPanel>
                            <TextBlock Text="ROI 参数" Foreground="#00E5FF" FontWeight="Bold" Margin="0,0,0,8"/>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,8,0"><TextBlock Text="中心行"/><TextBox Text="{Binding Line2CenterRow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel><TextBlock Text="中心列"/><TextBox Text="{Binding Line2CenterColumn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Margin="0,0,8,0"><TextBlock Text="角度"/><TextBox Text="{Binding Line2Angle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel><TextBlock Text="高度"/><TextBox Text="{Binding Line2Height, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Margin="0,0,8,0"><TextBlock Text="宽度"/><TextBox Text="{Binding Line2Width, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel><TextBlock Text="采样点数"/><TextBox Text="{Binding Line2PointCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            </UniformGrid>
                            <Separator Margin="0,8,0,12" Background="#255F72"/>
                            <TextBlock Text="抓边参数" Foreground="#00E5FF" FontWeight="Bold" Margin="0,0,0,8"/>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,8,0"><TextBlock Text="Sigma"/><TextBox Text="{Binding Line2Sigma, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel><TextBlock Text="阈值"/><TextBox Text="{Binding Line2Threshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Margin="0,0,8,0"><TextBlock Text="边数量"/><TextBox Text="{Binding Line2NumInstances, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel><TextBlock Text="距离阈值"/><TextBox Text="{Binding Line2DistThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel Margin="0,0,8,0"><TextBlock Text="最小得分"/><TextBox Text="{Binding Line2MinScore, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                                <StackPanel><TextBlock Text="最大迭代"/><TextBox Text="{Binding Line2MaxIterations, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                            </UniformGrid>
                            <TextBlock Text="明暗方向"/><ComboBox Text="{Binding Line2Transition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValue="{Binding Line2Transition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" IsEditable="True">
                                <ComboBoxItem Content="all"/>
                                <ComboBoxItem Content="positive"/>
                                <ComboBoxItem Content="negative"/>
                            </ComboBox>
                            <TextBlock Text="选择边"/><ComboBox Text="{Binding Line2Select, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValue="{Binding Line2Select, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" IsEditable="True">
                                <ComboBoxItem Content="first"/>
                                <ComboBoxItem Content="last"/>
                                <ComboBoxItem Content="all"/>
                            </ComboBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="结果输出">
                    <StackPanel Margin="14">
                        <Border BorderBrush="#2F7E98" BorderThickness="1" Background="#0B1722" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding Angle, StringFormat={}{0:F3} 度}" FontSize="28" FontWeight="Bold" Foreground="#00E5FF"/>
                                <TextBlock Text="{Binding IntersectionText}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding Line1Status}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding Line1Info}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding Line2Status}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding Line2Info}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding ParallelText}" Margin="0,0,0,8"/>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Border>

        <Border Grid.Row="3" Grid.ColumnSpan="2" BorderBrush="#255F72" BorderThickness="1" Background="#101923" Padding="12,0">
            <TextBlock VerticalAlignment="Center" Text="{Binding MouseInfo}" Foreground="#AEC7D3"/>
        </Border>
    </Grid>
</UserControl>
