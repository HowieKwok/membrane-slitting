<Window x:Class="DefectRuleClassifier.Views.ClassifierToolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ONNX 分类器工具（设置 / 推理 / 训练 / 测试）"
        Width="1240" Height="800" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterOwner" Background="#05080D" Foreground="#EAFBFF" FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#081018"/>
        <SolidColorBrush x:Key="LineCyan" Color="#23D9FF"/>
        <SolidColorBrush x:Key="LinePink" Color="#FF3FB4"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EAFBFF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Background" Value="#0E9FE8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineCyan}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#F7FBFF"/>
            <Setter Property="Foreground" Value="#111820"/>
            <Setter Property="RowBackground" Value="#FFFFFF"/>
            <Setter Property="AlternatingRowBackground" Value="#EEF6FB"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="#0A1620"/>
            <Setter Property="Foreground" Value="#EAFBFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineCyan}"/>
        </Style>
    </Window.Resources>
    <Border Margin="10" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource LineCyan}" BorderThickness="1" CornerRadius="6" Padding="10">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="ONNX 分类器工具" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="  设置模型 → 推理看图 → 批量测试 → 续接训练" Foreground="#8DFF64" Margin="12,0,0,0"/>
            </StackPanel>

            <!-- 左：设置 + 序号绑定表 -->
            <Border DockPanel.Dock="Left" Width="430" Background="#0A1620" BorderBrush="{StaticResource LinePink}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,10,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="设置与序号绑定表" FontSize="14" FontWeight="Bold" Foreground="{StaticResource LinePink}" Margin="0,0,0,6"/>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="ONNX 模型路径"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="浏览" Click="BrowseModelButton_Click"/>
                            <TextBox x:Name="ModelPathTextBox" IsReadOnly="True"/>
                        </DockPanel>
                        <TextBlock Text="标签文件路径（labels.txt，行序=序号 0 起）"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="浏览" Click="BrowseLabelsButton_Click"/>
                            <TextBox x:Name="LabelsPathTextBox" IsReadOnly="True"/>
                        </DockPanel>
                        <TextBlock Text="特征值分类规则文件（独立读取其特征标签用于绑定）"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="加载" Click="LoadFeatureRuleButton_Click"/>
                            <Button DockPanel.Dock="Right" Content="浏览" Click="BrowseFeatureRuleButton_Click"/>
                            <TextBox x:Name="FeatureRulePathTextBox" IsReadOnly="True"/>
                        </DockPanel>
                        <Button Content="加载模型 / 刷新" Click="LoadModelButton_Click" Margin="0,6,0,0"/>
                        <TextBlock x:Name="ModelStatusTextBlock" TextWrapping="Wrap" Foreground="#8DFF64" Margin="0,4,0,0"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="序号绑定表（序号 → 类别名 → 映射特征标签；未绑定统一输出超限类别）" Margin="0,10,0,4"/>
                    <DockPanel DockPanel.Dock="Bottom">
                        <Button DockPanel.Dock="Right" Content="保存绑定" Click="SaveBindingButton_Click" Background="#0B8F55"/>
                        <Button DockPanel.Dock="Right" Content="导出txt" Click="ExportIndexTableButton_Click"/>
                        <Button DockPanel.Dock="Right" Content="按同名自动绑定" Click="AutoBindSameNameButton_Click"/>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="提示：序号未绑定 → 输出 涂布不良；可先加载特征值分类规则文件后点“按同名自动绑定”快速填写。" Foreground="#8DFF64" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <DataGrid x:Name="IndexTableGrid" AutoGenerateColumns="False" CanUserAddRows="True" IsReadOnly="False" Height="300"
                              CellEditEnding="IndexTableGrid_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="序号" Binding="{Binding Index}" Width="60" IsReadOnly="True"/>
                            <DataGridTextColumn Header="类别名" Binding="{Binding ClassName}" Width="140" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="映射特征标签" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FeatureLabel, Mode=OneWay}" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding FeatureLabelOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding FeatureLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- 右：推理 / 测试 / 训练 -->
            <TabControl x:Name="MainTabControl">
                <!-- 推理 -->
                <TabItem Header="推理">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0">
                            <Button DockPanel.Dock="Right" Content="选择图片" Click="BrowseImageButton_Click"/>
                            <Button DockPanel.Dock="Right" Content="推理" Click="InferButton_Click" Background="#0B8F55"/>
                            <TextBox x:Name="ImagePathTextBox" IsReadOnly="True"/>
                        </DockPanel>
                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#060D13" BorderBrush="{StaticResource LineCyan}" BorderThickness="1" CornerRadius="4" Padding="6">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="原图" FontWeight="Bold" Foreground="{StaticResource LineCyan}"/>
                                    <Image x:Name="SourcePreviewImage" Stretch="Uniform"/>
                                </DockPanel>
                            </Border>
                            <Border Grid.Column="2" Background="#060D13" BorderBrush="{StaticResource LinePink}" BorderThickness="1" CornerRadius="4" Padding="6">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="推理效果（标注图）" FontWeight="Bold" Foreground="{StaticResource LinePink}"/>
                                    <Image x:Name="ResultPreviewImage" Stretch="Uniform"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                        <Border Grid.Row="2" Background="#0A1620" BorderBrush="{StaticResource LineCyan}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="输出标签（绑定后）" Foreground="#8DFF64"/>
                                    <TextBlock x:Name="ResultClassTextBlock" FontSize="20" FontWeight="Bold" Text="--"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="标签序号" Foreground="#8DFF64"/>
                                    <TextBlock x:Name="ResultIndexTextBlock" FontSize="20" FontWeight="Bold" Text="--"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="置信度" Foreground="#8DFF64"/>
                                    <TextBlock x:Name="ResultConfidenceTextBlock" FontSize="20" FontWeight="Bold" Text="--"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="全部类别得分" Foreground="#8DFF64"/>
                                    <ListBox x:Name="TopKListBox" Height="86" FontFamily="Microsoft YaHei UI" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- 批量测试 -->
                <TabItem Header="测试">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0">
                            <Button DockPanel.Dock="Right" Content="选择测试目录" Click="BrowseTestRootButton_Click"/>
                            <Button x:Name="TestButton" DockPanel.Dock="Right" Content="开始测试" Click="TestButton_Click" Background="#0B8F55"/>
                            <TextBox x:Name="TestRootTextBox" IsReadOnly="True"/>
                            <TextBlock Text="  并行数：" Margin="8,0,0,0"/>
                            <TextBox x:Name="TestWorkersTextBox" Width="46" Text="4"/>
                        </DockPanel>
                        <TextBlock Grid.Row="1" x:Name="TestSummaryTextBlock" TextWrapping="Wrap" Foreground="#8DFF64" Margin="3,8,3,6"/>
                        <DataGrid Grid.Row="2" x:Name="TestResultGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="图片" Binding="{Binding ImageName}" Width="*"/>
                                <DataGridTextColumn Header="真实类别" Binding="{Binding TrueClass}" Width="110"/>
                                <DataGridTextColumn Header="预测类别" Binding="{Binding ClassName}" Width="110"/>
                                <DataGridTextColumn Header="标签序号" Binding="{Binding ClassIndex}" Width="70"/>
                                <DataGridTextColumn Header="置信度" Binding="{Binding Confidence, StringFormat=P2}" Width="80"/>
                                <DataGridTextColumn Header="是否正确" Binding="{Binding Correct}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Button Grid.Row="2" Content="导出测试结果CSV" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="ExportTestCsvButton_Click" Margin="0,0,6,6"/>
                    </Grid>
                </TabItem>

                <!-- 训练 -->
                <TabItem Header="训练">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0">
                            <Button DockPanel.Dock="Right" Content="选择数据集目录" Click="BrowseTrainDataButton_Click"/>
                            <Button x:Name="TrainButton" DockPanel.Dock="Right" Content="开始续接训练" Click="TrainButton_Click" Background="#0B8F55"/>
                            <TextBox x:Name="TrainDataRootTextBox" IsReadOnly="True"/>
                            <TextBlock Text="  轮数：" Margin="8,0,0,0"/>
                            <TextBox x:Name="TrainEpochsTextBox" Width="52" Text="30"/>
                            <CheckBox x:Name="TrainResumeCheckBox" Content="续接上次训练" IsChecked="True" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Grid.Row="1" Text="数据集结构：数据集根目录\类别名\图片；训练后台隐藏进程执行，不打开 Python 界面。" Foreground="#8DFF64" Margin="3,8,3,6" TextWrapping="Wrap"/>
                        <TextBox Grid.Row="2" x:Name="TrainLogTextBox" IsReadOnly="True" FontFamily="Consolas" FontSize="10"
                                 TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 Background="#060D13" Foreground="#A9E5A9"/>
                    </Grid>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Border>
</Window>