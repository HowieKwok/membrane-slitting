<Window
    x:Class="DefectRuleClassifier.Views.RuleSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:DefectRuleClassifier.Controls"
    Title="分类规则设置"
    Width="1320"
    Height="800"
    MinWidth="1120"
    MinHeight="660"
    Background="#05080D"
    FontFamily="Microsoft YaHei UI"
    Foreground="#EAFBFF"
    WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#081018" />
        <SolidColorBrush x:Key="PanelBg2" Color="#0B141E" />
        <SolidColorBrush x:Key="LineCyan" Color="#23D9FF" />
        <SolidColorBrush x:Key="LinePink" Color="#FF3FB4" />
        <SolidColorBrush x:Key="InputBg" Color="#F7FBFF" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EAFBFF" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="Background" Value="#0E9FE8" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource LineCyan}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="6" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Foreground" Value="#EAFBFF" />
            <Setter Property="BorderBrush" Value="#21485A" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="25" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Background" Value="{StaticResource InputBg}" />
            <Setter Property="Foreground" Value="#111820" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Background" Value="{StaticResource InputBg}" />
            <Setter Property="Foreground" Value="#111820" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#EAFBFF" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="GridLinesVisibility" Value="All" />
            <Setter Property="Background" Value="#F7FBFF" />
            <Setter Property="Foreground" Value="#111820" />
            <Setter Property="RowBackground" Value="#FFFFFF" />
            <Setter Property="AlternatingRowBackground" Value="#EEF6FB" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Foreground" Value="#111820" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">
        <Border
            Margin="0,0,0,8"
            Padding="12,8"
            Background="{StaticResource PanelBg}"
            BorderBrush="{StaticResource LineCyan}"
            BorderThickness="1"
            CornerRadius="6"
            DockPanel.Dock="Top">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" LastChildFill="False">
                    <TextBlock
                        DockPanel.Dock="Left"
                        FontSize="20"
                        FontWeight="Bold"
                        Text="分类规则设置" />
                    <Button
                        MinWidth="120"
                        Command="{Binding ImportCommand}"
                        Content="导入规则"
                        DockPanel.Dock="Right" />
                    <TextBlock
                        Margin="0,0,12,0"
                        DockPanel.Dock="Right"
                        Foreground="#8DFF64"
                        Text="{Binding SaveStatusText}" />
                </DockPanel>
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="56" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="规则路径" />
                    <TextBox Grid.Column="1" Text="{Binding RuleConfigPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Grid.Column="2"
                        MinWidth="56"
                        Command="{Binding SelectPathCommand}"
                        Content="设置" />
                    <Button
                        Grid.Column="3"
                        MinWidth="48"
                        Click="SaveButton_Click"
                        Command="{Binding SaveCommand}"
                        Content="保存" />
                </Grid>
            </Grid>
        </Border>

        <Border
            Padding="8"
            Background="{StaticResource PanelBg}"
            BorderBrush="{StaticResource LinePink}"
            BorderThickness="1"
            CornerRadius="6">
            <TabControl Background="{StaticResource PanelBg2}">
                <TabItem Header="特征分类">
                    <Grid Background="{StaticResource PanelBg2}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="270" />
                            <ColumnDefinition Width="430" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <GroupBox Grid.Column="0" Header="NG类型">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="40" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>
                                <DataGrid
                                    Grid.Row="0"
                                    AutoGenerateColumns="False"
                                    ItemsSource="{Binding FeatureRuleConfig.NgTypes}"
                                    SelectedItem="{Binding SelectedNgType, Mode=TwoWay}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn
                                            Width="*"
                                            Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Header="NG类型" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    VerticalAlignment="Center">
                                    <Button
                                        MinWidth="34"
                                        Command="{Binding MoveNgUpCommand}"
                                        Content="↑" />
                                    <Button
                                        MinWidth="34"
                                        Command="{Binding MoveNgDownCommand}"
                                        Content="↓" />
                                </StackPanel>
                                <UniformGrid
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Columns="2">
                                    <Button Command="{Binding AddNgTypeCommand}" Content="新增" />
                                    <Button Command="{Binding DeleteNgTypeCommand}" Content="删除" />
                                </UniformGrid>
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Column="1" Header="尺寸范围与数量限制">
                            <Grid Margin="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border
                                    Grid.Row="0"
                                    Padding="10"
                                    Background="#FF95A9BB"
                                    BorderBrush="#21485A"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="34" />
                                            <RowDefinition Height="36" />
                                            <RowDefinition Height="36" />
                                            <RowDefinition Height="36" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="44" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Content="启用尺寸判定"
                                            IsChecked="{Binding SelectedNgType.EnableJudgeCondition, Mode=TwoWay}" />
                                        <TextBlock
                                            Grid.Row="0"
                                            Grid.Column="2"
                                            Text="方式" />
                                        <ComboBox
                                            Grid.Row="0"
                                            Grid.Column="3"
                                            Grid.ColumnSpan="2"
                                            DisplayMemberPath="DisplayName"
                                            ItemsSource="{Binding JudgeConditionModes}"
                                            SelectedValue="{Binding SelectedNgType.JudgeCondition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedValuePath="Value" />

                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Text="长度范围" />
                                        <ctrl:NumericBox
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            DecimalPlaces="4"
                                            Increment="0.1"
                                            Minimum="0"
                                            Value="{Binding SelectedNgType.MinLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="2"
                                            HorizontalAlignment="Center"
                                            Text="~" />
                                        <ctrl:NumericBox
                                            Grid.Row="1"
                                            Grid.Column="3"
                                            DecimalPlaces="4"
                                            Increment="0.1"
                                            Minimum="0"
                                            Value="{Binding SelectedNgType.MaxLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="4"
                                            Text="mm" />

                                        <TextBlock
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            Text="宽度范围" />
                                        <ctrl:NumericBox
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            DecimalPlaces="4"
                                            Increment="0.1"
                                            Minimum="0"
                                            Value="{Binding SelectedNgType.MinWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock
                                            Grid.Row="2"
                                            Grid.Column="2"
                                            HorizontalAlignment="Center"
                                            Text="~" />
                                        <ctrl:NumericBox
                                            Grid.Row="2"
                                            Grid.Column="3"
                                            DecimalPlaces="4"
                                            Increment="0.1"
                                            Minimum="0"
                                            Value="{Binding SelectedNgType.MaxWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock
                                            Grid.Row="2"
                                            Grid.Column="4"
                                            Text="mm" />

                                        <TextBlock
                                            Grid.Row="3"
                                            Grid.Column="0"
                                            Text="面积范围" />
                                        <ctrl:NumericBox
                                            Grid.Row="3"
                                            Grid.Column="1"
                                            DecimalPlaces="4"
                                            Increment="0.1"
                                            Minimum="0"
                                            Value="{Binding SelectedNgType.MinArea, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock
                                            Grid.Row="3"
                                            Grid.Column="2"
                                            HorizontalAlignment="Center"
                                            Text="~" />
                                        <ctrl:NumericBox
                                            Grid.Row="3"
                                            Grid.Column="3"
                                            DecimalPlaces="4"
                                            Increment="0.1"
                                            Minimum="0"
                                            Value="{Binding SelectedNgType.MaxArea, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock
                                            Grid.Row="3"
                                            Grid.Column="4"
                                            Text="mm²" />
                                    </Grid>
                                </Border>

                                <Border
                                    Grid.Row="2"
                                    Padding="10"
                                    Background="#FF95A9BB"
                                    BorderBrush="#23D9FF"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="30" />
                                            <RowDefinition Height="36" />
                                            <RowDefinition Height="38" />
                                            <RowDefinition Height="36" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="118" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="78" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Row="0"
                                            Grid.ColumnSpan="4"
                                            FontWeight="Bold"
                                            Foreground="#23D9FF"
                                            Text="特征分类数量限制" />
                                        <CheckBox
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="4"
                                            Content="候选总数超过硬上限时，整批不进入特征分类"
                                            Foreground="#FFF1F6F7"
                                            IsChecked="{Binding FeatureRuleConfig.EnableCandidateCountLimit, Mode=TwoWay}" />
                                        <TextBlock
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            Text="硬超限数量" />
                                        <ctrl:NumericBox
                                            Grid.Row="2"
                                            Grid.ColumnSpan="2"
                                            Margin="99,2,0,8"
                                            DecimalPlaces="0"
                                            Increment="10"
                                            Minimum="1"
                                            Value="{Binding FeatureRuleConfig.MaxCandidateCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock
                                            Grid.Row="2"
                                            Grid.Column="2"
                                            Text="超限输出" />
                                        <TextBox
                                            Grid.Row="2"
                                            Grid.Column="3"
                                            Text="{Binding FeatureRuleConfig.OverflowClassName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <CheckBox
                                            Grid.Row="3"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Content="限制进入数量"
                                            IsChecked="{Binding FeatureRuleConfig.EnableMaxEnterClassifyLimit, Mode=TwoWay}" />
                                        <TextBlock
                                            Grid.Row="3"
                                            Grid.Column="2"
                                            Text="最多进入" />
                                        <ctrl:NumericBox
                                            Grid.Row="3"
                                            Grid.Column="3"
                                            DecimalPlaces="0"
                                            Increment="1"
                                            Minimum="1"
                                            Value="{Binding FeatureRuleConfig.MaxEnterClassifyCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Column="2" Header="特征参数">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="42" />
                                </Grid.RowDefinitions>
                                <DataGrid
                                    AutoGenerateColumns="False"
                                    HorizontalScrollBarVisibility="Auto"
                                    ItemsSource="{Binding SelectedNgType.Features}"
                                    SelectedItem="{Binding SelectedFeature, Mode=TwoWay}">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Width="180" Header="特征类型">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Padding="4,0" Text="{Binding FeatureName}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <ComboBox
                                                        DisplayMemberPath="DisplayName"
                                                        ItemsSource="{Binding DataContext.FeatureTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        SelectedValue="{Binding FeatureType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        SelectedValuePath="Value" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Width="126" Header="最小值">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Padding="4,0" Text="{Binding MinValue, StringFormat={}{0:0.######}}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <ctrl:NumericBox
                                                        DecimalPlaces="6"
                                                        Increment="0.1"
                                                        Value="{Binding MinValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Width="126" Header="最大值">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Padding="4,0" Text="{Binding MaxValue, StringFormat={}{0:0.######}}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <ctrl:NumericBox
                                                        DecimalPlaces="6"
                                                        Increment="0.1"
                                                        Value="{Binding MaxValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn
                                            Width="260"
                                            Binding="{Binding FeatureDescription}"
                                            Header="计算说明" />
                                        <DataGridTextColumn
                                            Width="300"
                                            Binding="{Binding FeatureRangeDescription}"
                                            Header="建议范围/单位" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <UniformGrid Grid.Row="1" Columns="2">
                                    <Button Command="{Binding AddFeatureCommand}" Content="新增特征" />
                                    <Button Command="{Binding DeleteFeatureCommand}" Content="删除特征" />
                                </UniformGrid>
                            </Grid>
                        </GroupBox>
                    </Grid>
                </TabItem>

                <TabItem Header="判定说明">
                    <Grid Margin="8" Background="{StaticResource PanelBg2}">
                        <DataGrid AutoGenerateColumns="False" ItemsSource="{Binding JudgeConditionModes}">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="180"
                                    Binding="{Binding DisplayName}"
                                    Header="判定条件" />
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding Remark}"
                                    Header="说明" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="AI分类">
                    <Grid Margin="12" Background="{StaticResource PanelBg2}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />

                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="AI参数路径" />
                        <TextBox
                            Grid.Row="0"
                            Grid.Column="1"
                            Text="{Binding AiConfigPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Grid.Row="0"
                            Grid.Column="2"
                            Command="{Binding SelectAiConfigPathCommand}"
                            Content="设置" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Text="AI模型路径" />
                        <TextBox
                            Grid.Row="1"
                            Grid.Column="1"
                            Text="{Binding AiRuleConfig.ModelPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Grid.Row="1"
                            Grid.Column="2"
                            Command="{Binding SelectAiModelPathCommand}"
                            Content="选择" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Text="说明" />
                        <TextBox
                            Grid.Row="2"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Text="{Binding AiRuleConfig.Remark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </TabItem>

                <TabItem Header="分类器分类">
                    <Grid Margin="12" Background="{StaticResource PanelBg2}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="分类器参数路径" />
                        <TextBox
                            Grid.Row="0"
                            Grid.Column="1"
                            Text="{Binding ModelConfigPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Grid.Row="0"
                            Grid.Column="2"
                            Command="{Binding SelectModelConfigPathCommand}"
                            Content="设置" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Text="分类器模型路径" />
                        <TextBox
                            Grid.Row="1"
                            Grid.Column="1"
                            Text="{Binding ModelRuleConfig.ModelPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Grid.Row="1"
                            Grid.Column="2"
                            Command="{Binding SelectModelFilePathCommand}"
                            Content="选择" />
                        <CheckBox
                            Grid.Row="2"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Content="启用硬超限：超限整批不进分类器"
                            IsChecked="{Binding ModelRuleConfig.EnableCandidateCountLimit, Mode=TwoWay}" />
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            Text="硬超限数量" />
                        <ctrl:NumericBox
                            Grid.Row="3"
                            Grid.Column="1"
                            DecimalPlaces="0"
                            Increment="10"
                            Minimum="1"
                            Value="{Binding ModelRuleConfig.MaxCandidateCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox
                            Grid.Row="4"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Content="限制进入分类器数量：只取面积最大的前N个"
                            IsChecked="{Binding ModelRuleConfig.EnableMaxEnterClassifierLimit, Mode=TwoWay}" />
                        <TextBlock
                            Grid.Row="5"
                            Grid.Column="0"
                            Text="最多进入数量" />
                        <ctrl:NumericBox
                            Grid.Row="5"
                            Grid.Column="1"
                            DecimalPlaces="0"
                            Increment="1"
                            Minimum="1"
                            Value="{Binding ModelRuleConfig.MaxEnterClassifierCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Grid.Row="6"
                            Grid.Column="0"
                            Text="标签文件路径" />
                        <TextBox
                            Grid.Row="6"
                            Grid.Column="1"
                            Text="{Binding ModelRuleConfig.LabelsPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="labels.txt：模型类别名称，顺序即标签序号（0 起）" />
                        <Button
                            Grid.Row="6"
                            Grid.Column="2"
                            Command="{Binding SelectLabelsPathCommand}"
                            Content="选择" />
                        <TextBlock
                            Grid.Row="7"
                            Grid.Column="0"
                            Margin="0,4,0,0"
                            VerticalAlignment="Top"
                            Text="序号→特征标签" />
                        <DataGrid
                            Grid.Row="7"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Height="180"
                            AutoGenerateColumns="False"
                            CanUserAddRows="True"
                            ItemsSource="{Binding ModelRuleConfig.IndexToFeatureLabel}">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="80"
                                    Binding="{Binding Index, Mode=TwoWay}"
                                    Header="模型序号" />
                                <DataGridComboBoxColumn
                                    Width="*"
                                    DisplayMemberPath="Name"
                                    Header="映射特征值标签"
                                    ItemsSource="{Binding DataContext.FeatureRuleConfig.NgTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                                    SelectedValueBinding="{Binding FeatureLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedValuePath="Name" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock
                            Grid.Row="8"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Foreground="#8A94A6"
                            Text="提示：序号对应 labels.txt 顺序（0 起）；未配置映射或映射到的标签不在特征值分类中时，统一归入超限类别（涂布/涂层不良）。"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Grid.Row="9"
                            Grid.Column="0"
                            Text="未匹配归入类别" />
                        <TextBlock
                            Grid.Row="10"
                            Grid.Column="0"
                            Text="完整工具" />
                        <Button
                            Grid.Row="10"
                            Grid.Column="1"
                            MinWidth="220"
                            HorizontalAlignment="Left"
                            Click="OpenClassifierToolButton_Click"
                            Content="打开分类器工具（推理/测试/训练）" />
                        <TextBox
                            Grid.Row="9"
                            Grid.Column="1"
                            Text="{Binding ModelRuleConfig.OverflowClassName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="模型序号未配置映射，或映射标签不在特征值分类中时，统一归入该类别（如 涂层不良）" />
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
    </DockPanel>
</Window>
