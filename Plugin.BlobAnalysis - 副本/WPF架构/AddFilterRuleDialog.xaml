<Window x:Class="Plugin.BlobAnalysis.WPFArchitecture.AddFilterRuleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="&#x65B0;&#x589E;&#x8FC7;&#x6EE4;&#x6761;&#x4EF6;"
        Width="430"
        Height="280"
        WindowStartupLocation="CenterOwner"
        Background="#F7FBFF"
        FontFamily="Microsoft YaHei UI"
        FontSize="13">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="&#x7279;&#x5F81;" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,5" Foreground="#111820"/>
        <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,5" Height="28"
                  ItemsSource="{Binding FeatureItems}"
                  DisplayMemberPath="Value"
                  SelectedValuePath="Key"
                  SelectedValue="{Binding Feature, Mode=TwoWay}"/>

        <TextBlock Text="&#x6700;&#x5C0F;&#x503C;" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,5" Foreground="#111820"/>
        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,5" Height="26" Text="{Binding Min, Mode=TwoWay}"/>

        <TextBlock Text="&#x6700;&#x5927;&#x503C;" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,5" Foreground="#111820"/>
        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,5" Height="26" Text="{Binding Max, Mode=TwoWay}"/>

        <TextBlock Text="&#x903B;&#x8F91;" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,5" Foreground="#111820"/>
        <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,5" Height="28"
                  ItemsSource="{Binding OperationItems}"
                  DisplayMemberPath="Value"
                  SelectedValuePath="Key"
                  SelectedValue="{Binding Operation, Mode=TwoWay}"/>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="&#x786E;&#x5B9A;" Width="86" Height="30" Margin="0,0,10,0" Click="OnOkClick"/>
            <Button Content="&#x53D6;&#x6D88;" Width="86" Height="30" Click="OnCancelClick"/>
        </StackPanel>
    </Grid>
</Window>