<UserControl
    x:Class="DevMgmt.Cameras.View.DynamicCameraParamUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DevMgmt.Cameras.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="630"
    d:DesignWidth="390"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DCF8FF" />
            <Setter Property="FontFamily" Value="Microsoft YaHei" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="35" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="#102536" />
            <Setter Property="BorderBrush" Value="#00A9C8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#DCF8FF" />
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,2,0,8" />
            <Setter Property="Foreground" Value="#E9FBFF" />
            <Setter Property="Background" Value="#102536" />
            <Setter Property="BorderBrush" Value="#2F7E98" />
        </Style>
        <Style x:Key="PathSelectBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="35" />
            <Setter Property="Height" Value="35" />
            <Setter Property="Background" Value="#102536" />
            <Setter Property="BorderBrush" Value="#00A9C8" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>

    <Grid Background="#08111B">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="1"
            Padding="1,0"
            Background="#101A26"
            BorderBrush="#2F7E98"
            BorderThickness="1">
            <ScrollViewer
                Padding="10"
                Background="#111923"
                VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="MainStackPanel" />
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
