<Window
    x:Class="DevMgmt.Cameras.View.AddCameraWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DevMgmt.Cameras.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    MinWidth="500"
    MinHeight="250"
    d:DesignHeight="250"
    d:DesignWidth="500"
    Background="#08111B"
    SizeToContent="WidthAndHeight"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <!--  样式，风格完全统一  -->
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DCF8FF" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,2,0,8" />
            <Setter Property="Foreground" Value="#E9FBFF" />
            <Setter Property="Background" Value="#102536" />
            <Setter Property="BorderBrush" Value="#2F7E98" />
        </Style>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="82" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Foreground" Value="#E9FBFF" />
            <Setter Property="Background" Value="#102536" />
            <Setter Property="BorderBrush" Value="#00A9C8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="#111923" />
            <Setter Property="BorderBrush" Value="#2F7E98" />
            <Setter Property="Foreground" Value="#DCF8FF" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#102536" />
            <Setter Property="Foreground" Value="#DCF8FF" />
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#102536" />
            <Setter Property="Foreground" Value="#DCF8FF" />
            <Setter Property="BorderBrush" Value="#00E5FF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="#102536" />
            <Setter Property="Foreground" Value="#DCF8FF" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  标题栏  -->
        <Border
            Grid.Row="0"
            Padding="10"
            Background="#101A26"
            BorderBrush="#2F7E98"
            BorderThickness="0,0,0,1">
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="18"
                FontWeight="Bold"
                Foreground="#00E5FF"
                Text="请选择相机类型" />
        </Border>

        <!--  单选框区域（自适应换行，不会挤成一条）  -->
        <ItemsControl
            Grid.Row="1"
            Margin="15"
            ItemsSource="{Binding AllCamTypes}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4" />
                    <!--<WrapPanel Orientation="Horizontal" />-->
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <RadioButton
                        Margin="15,8"
                        Content="{Binding DisplayName}"
                        FontSize="14"
                        Foreground="#DCF8FF"
                        GroupName="CameraGroup"
                        IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--  底部按钮（自动贴右下角）  -->
        <StackPanel
            Grid.Row="2"
            Margin="0,10,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">

            <Button
                Width="90"
                Height="30"
                Background="#102536"
                BorderBrush="#2F7E98"
                Command="{Binding ConfirmCommand}"
                Content="确定"
                Foreground="White"
                IsEnabled="{Binding CanConfirm}" />
        </StackPanel>
    </Grid>
</Window>
