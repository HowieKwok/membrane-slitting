<UserControl x:Class="ControlBoard.View.IO640.IO640UserView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ControlBoard.View.IO640"
        xmlns:conv="clr-namespace:ControlBoard.转换"
        mc:Ignorable="d"
        Height="800" Width="900"
        Background="#05080D"
        Foreground="#EAFBFF"
        FontFamily="Microsoft YaHei UI"
        FontSize="13">
    <UserControl.Resources>
        <conv:BoolToLedBrushConverter x:Key="BoolToLedBrushConverter"/>
        <conv:BoolToTextConverter x:Key="BoolToTextConverter"/>

        <SolidColorBrush x:Key="PanelBg" Color="#081018"/>
        <SolidColorBrush x:Key="PanelBg2" Color="#0B141E"/>
        <SolidColorBrush x:Key="PanelBg3" Color="#101D28"/>
        <SolidColorBrush x:Key="LineCyan" Color="#23D9FF"/>
        <SolidColorBrush x:Key="LinePink" Color="#FF3FB4"/>
        <SolidColorBrush x:Key="LineGreen" Color="#8DFF64"/>
        <SolidColorBrush x:Key="LineOrange" Color="#FFB84D"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#EAFBFF"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8CA8B8"/>
        <SolidColorBrush x:Key="InputBg" Color="#F7FBFF"/>

        <DropShadowEffect x:Key="CardShadow" Color="#23D9FF" BlurRadius="14" ShadowDepth="0" Opacity="0.12"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="PanelCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="#111820"/>
            <Setter Property="BorderBrush" Value="#BFD3E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#111820"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="#111820"/>
            <Setter Property="BorderBrush" Value="#BFD3E0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="BorderBrush" Value="#21485A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="BaseBtn" TargetType="Button">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F7FEFF"/>
            <Setter Property="Background" Value="#102638"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineCyan}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" BasedOn="{StaticResource BaseBtn}" TargetType="Button">
            <Setter Property="Background" Value="#0E5A78"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineCyan}"/>
        </Style>

        <Style x:Key="SuccessBtn" BasedOn="{StaticResource BaseBtn}" TargetType="Button">
            <Setter Property="Background" Value="#1D5F3A"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineGreen}"/>
        </Style>

        <Style x:Key="DangerBtn" BasedOn="{StaticResource BaseBtn}" TargetType="Button">
            <Setter Property="Background" Value="#68213A"/>
            <Setter Property="BorderBrush" Value="{StaticResource LinePink}"/>
        </Style>

        <Style x:Key="WarningBtn" BasedOn="{StaticResource BaseBtn}" TargetType="Button">
            <Setter Property="Background" Value="#7A4A12"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineOrange}"/>
        </Style>

        <Style x:Key="LedEllipseStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Stroke" Value="#BFD3E0"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="Fill" Value="#27323B"/>
        </Style>

        <DataTemplate x:Key="IoPointItemTemplate">
            <Border Margin="4"
                    Padding="6,4"
                    Background="{StaticResource PanelBg2}"
                    BorderBrush="#1A3C4E"
                    BorderThickness="1"
                    CornerRadius="4">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Style="{StaticResource LedEllipseStyle}"
                             Fill="{Binding IsOn, Converter={StaticResource BoolToLedBrushConverter}}">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#23D9FF" BlurRadius="9" ShadowDepth="0" Opacity="0.35"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="{Binding Index, StringFormat={}{0:00}}"
                               FontSize="11"
                               Foreground="{StaticResource TextMuted}"
                               Margin="6,0,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="IoGridPanel">
            <UniformGrid Columns="8" Rows="4"/>
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.Background>
            <RadialGradientBrush Center="0.1,0.05"
                                 GradientOrigin="0.1,0.05"
                                 RadiusX="1.1"
                                 RadiusY="1.1">
                <GradientStop Color="#102638" Offset="0"/>
                <GradientStop Color="#05080D" Offset="0.62"/>
                <GradientStop Color="#03060A" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource PanelBg}"
                BorderBrush="{StaticResource LineCyan}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14,8">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="雷赛 IO 控制卡"
                               FontSize="22"
                               FontWeight="Bold"/>
                    <TextBlock Text="IO640 · 32 路 DI / 32 路 DO 状态监控与单点调试"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="12"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <Border DockPanel.Dock="Right"
                        Padding="12,6"
                        Background="{StaticResource PanelBg3}"
                        BorderBrush="{StaticResource LineGreen}"
                        BorderThickness="1"
                        CornerRadius="16"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Style="{StaticResource LedEllipseStyle}"
                                 Width="16"
                                 Height="16"
                                 Fill="{Binding HardwareConnected, Converter={StaticResource BoolToLedBrushConverter}}"/>
                        <TextBlock Text="板卡状态"
                                   Foreground="{StaticResource TextMuted}"
                                   Margin="8,0,6,0"/>
                        <TextBlock Text="{Binding HardwareConnected, Converter={StaticResource BoolToTextConverter}}"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Style="{StaticResource CardBorder}"
                        BorderBrush="{StaticResource LineCyan}">
                    <StackPanel>
                        <TextBlock Text="板卡参数配置" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="保存卡号、端口号与滤波时间，保持 IO 初始化参数一致。"
                                   Style="{StaticResource PanelCaption}"/>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="108"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FormLabel}" Text="控制卡型号"/>
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      IsEnabled="False"
                                      ItemsSource="{Binding BoardTypeItems}"
                                      SelectedItem="{Binding ControlType, Mode=TwoWay}"
                                      DropDownClosed="ComboBox_DropDownClosed"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FormLabel}" Text="卡号 CardNo"/>
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Text="{Binding CardNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="5"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FormLabel}" Text="端口号 PortNo"/>
                            <TextBox Grid.Row="2" Grid.Column="1"
                                     Text="{Binding m_PortNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="5"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FormLabel}" Text="滤波时间(μs)"/>
                            <TextBox Grid.Row="3" Grid.Column="1"
                                     Text="{Binding FilteTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Visibility="Hidden" Content="初始化"
                                  Command="{Binding InitCommand}"
                                  Style="{StaticResource PrimaryBtn}"
                                  Width="96"/>      

                                <Button Content="保存配置"
                                        Command="{Binding SaveParamCommand}"
                                        Style="{StaticResource PrimaryBtn}"
                                        Width="96"/>
                                <Button Visibility="Hidden"
                                        Content="加载配置"
                                        Command="{Binding LoadParamCommand}"
                                        Style="{StaticResource SuccessBtn}"
                                        Width="90"
                                        Margin="10,0,0,0"/>
                                <Button Visibility="Hidden"
                                        Content="重置参数"
                                        Command="{Binding ResetParamCommand}"
                                        Style="{StaticResource DangerBtn}"
                                        Width="60"
                                        Margin="10,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2"
                        Style="{StaticResource CardBorder}"
                        BorderBrush="{StaticResource LinePink}">
                    <StackPanel>
                        <TextBlock Text="连接与轮询" Style="{StaticResource SectionTitle}"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="108"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="板卡连接状态" Style="{StaticResource FormLabel}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Ellipse Style="{StaticResource LedEllipseStyle}"
                                         Width="22"
                                         Height="22"
                                         Fill="{Binding HardwareConnected, Converter={StaticResource BoolToLedBrushConverter}}"/>
                                <TextBlock Text="{Binding HardwareConnected, Converter={StaticResource BoolToTextConverter}}"
                                           FontWeight="SemiBold"
                                           Margin="8,0,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Content="启动轮询"
                                    Command="{Binding StartIoPollCommand}"
                                    Style="{StaticResource SuccessBtn}"/>
                            <Button Grid.Column="2"
                                    Content="停止轮询"
                                    Command="{Binding StopIoPollCommand}"
                                    Style="{StaticResource DangerBtn}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="4"
                        Style="{StaticResource CardBorder}"
                        BorderBrush="{StaticResource LineOrange}">
                    <StackPanel>
                        <TextBlock Text="DO 单点输出调试"
                                   Style="{StaticResource SectionTitle}"
                                   Foreground="{StaticResource LineOrange}"/>
                        <TextBlock Text="用于快速验证单路输出，高/低电平会直接写入指定 DO 点位。"
                                   Style="{StaticResource PanelCaption}"/>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="108"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FormLabel}" Text="点位索引"/>
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Width="88"
                                     HorizontalAlignment="Left"
                                     Text="{Binding DebugDoIndex,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="2"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FormLabel}" Text="输出电平"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton Content="高电平(1)"
                                             IsChecked="{Binding DebugDoLevel, Converter={conv:IntBoolConverter TrueValue=1,FalseValue=0}}"/>
                                <RadioButton Content="低电平(0)"
                                             IsChecked="{Binding DebugDoLevel, Converter={conv:IntBoolConverter TrueValue=0,FalseValue=1}}"/>
                            </StackPanel>

                            <Button Grid.Row="2" Grid.Column="1"
                                    Content="触发 DO 输出"
                                    Command="{Binding DoSingleOutCommand}"
                                    Style="{StaticResource WarningBtn}"
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Stretch"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Style="{StaticResource CardBorder}"
                        BorderBrush="{StaticResource LineCyan}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left"
                                       Text="DI 32 路输入状态"
                                       Style="{StaticResource SectionTitle}"
                                       Foreground="{StaticResource LineCyan}"/>
                            <TextBlock DockPanel.Dock="Right"
                                       Text="INPUT"
                                       Foreground="{StaticResource TextMuted}"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Margin="0,0,0,12"/>
                        </DockPanel>
                        <TextBlock Grid.Row="1"
                                   Text="亮灯表示当前输入点位有效。"
                                   Style="{StaticResource PanelCaption}"/>
                        <ItemsControl Grid.Row="2"
                                      ItemsSource="{Binding DiPointList}"
                                      ItemTemplate="{StaticResource IoPointItemTemplate}"
                                      ItemsPanel="{StaticResource IoGridPanel}"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Style="{StaticResource CardBorder}"
                        BorderBrush="{StaticResource LinePink}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left"
                                       Text="DO 32 路输出状态"
                                       Style="{StaticResource SectionTitle}"
                                       Foreground="{StaticResource LinePink}"/>
                            <TextBlock DockPanel.Dock="Right"
                                       Text="OUTPUT"
                                       Foreground="{StaticResource TextMuted}"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Margin="0,0,0,12"/>
                        </DockPanel>
                        <TextBlock Grid.Row="1"
                                   Text="亮灯表示当前输出点位已置位。"
                                   Style="{StaticResource PanelCaption}"/>
                        <ItemsControl Grid.Row="2"
                                      ItemsSource="{Binding DoPointList}"
                                      ItemTemplate="{StaticResource IoPointItemTemplate}"
                                      ItemsPanel="{StaticResource IoGridPanel}"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
