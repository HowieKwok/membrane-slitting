  </ItemGroup>

  <ItemGroup>
    <Reference Include="CommunityToolkit.Mvvm">
      <HintPath>..\Mef_VisionFrame\bin\Release\Plugins\CommunityToolkit.Mvvm.dll</HintPath>
    </Reference>
    <Reference Include="log4net">
      <HintPath>..\DLL\OtherDLL\log4net.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
