        /// <summary>
        /// Helper: setup one ROI parameter table (used for both Line1 and Line2)
        /// </summary>
        private void SetupROITable(
            System.Windows.Forms.TableLayoutPanel tlp, string name,
            System.Windows.Forms.Label lblNum, System.Windows.Forms.Label lblWidth,
            System.Windows.Forms.Label lblHeight, System.Windows.Forms.Label lblAngle,
            System.Windows.Forms.Label lblRow, System.Windows.Forms.Label lblCol,
            System.Windows.Forms.NumericUpDown nudNum, System.Windows.Forms.NumericUpDown nudWidth,
            System.Windows.Forms.NumericUpDown nudHeight, System.Windows.Forms.NumericUpDown nudAngle,
            System.Windows.Forms.NumericUpDown nudRow, System.Windows.Forms.NumericUpDown nudCol,
            string suffix)
        {
            tlp.ColumnCount = 2;
            tlp.ColumnStyles.Add(new System.Windows.Forms.ColumnStyle(System.Windows.Forms.SizeType.Percent, 40F));
            tlp.ColumnStyles.Add(new System.Windows.Forms.ColumnStyle(System.Windows.Forms.SizeType.Percent, 60F));
            tlp.RowCount = 6;
            for (int i = 0; i < 6; i++)
                tlp.RowStyles.Add(new System.Windows.Forms.RowStyle(System.Windows.Forms.SizeType.Absolute, 38F));
            tlp.Dock = System.Windows.Forms.DockStyle.Fill;
            tlp.Name = name;

            SetupTableLabel(lblNum, "lbl_Num_" + suffix, "\u626b\u63cf\u70b9\u6570");
            SetupTableLabel(lblWidth, "lbl_Width_" + suffix, "\u5bbd\u5ea6");
            SetupTableLabel(lblHeight, "lbl_Height_" + suffix, "\u9ad8\u5ea6");
            SetupTableLabel(lblAngle, "lbl_Angle_" + suffix, "\u89d2\u5ea6");
            SetupTableLabel(lblRow, "lbl_MidRow_" + suffix, "\u4e2d\u5fc3\u884c");
            SetupTableLabel(lblCol, "lbl_MidCol_" + suffix, "\u4e2d\u5fc3\u5217");

            tlp.Controls.Add(lblNum, 0, 0);
            tlp.Controls.Add(lblWidth, 0, 1);
            tlp.Controls.Add(lblHeight, 0, 2);
            tlp.Controls.Add(lblAngle, 0, 3);
            tlp.Controls.Add(lblRow, 0, 4);
            tlp.Controls.Add(lblCol, 0, 5);

            SetupTableNUD(nudNum, "NUD_RoiNum_" + suffix, 1, 150, 0, 20);
            SetupTableNUD(nudWidth, "NUD_RoiWidth_" + suffix, 1, 100000, 0, 100);
            SetupTableNUD(nudHeight, "NUD_RoiHeight_" + suffix, 1, 100000, 0, 200);
            SetupTableNUD(nudAngle, "NUD_RoiAngle_" + suffix, -180, 180, 0, 0);
            SetupTableNUD(nudRow, "NUD_RoiMidRow_" + suffix, -100000, 100000, 0, 200);
            SetupTableNUD(nudCol, "NUD_RoiMidColumn_" + suffix, -100000, 100000, 0, 300);

            tlp.Controls.Add(nudNum, 1, 0);
            tlp.Controls.Add(nudWidth, 1, 1);
            tlp.Controls.Add(nudHeight, 1, 2);
            tlp.Controls.Add(nudAngle, 1, 3);
            tlp.Controls.Add(nudRow, 1, 4);
            tlp.Controls.Add(nudCol, 1, 5);
        }

        /// <summary>
        /// Helper: setup one Measure parameter panel (used for both Line1 and Line2)
        /// </summary>
        private void SetupMeasurePanel(
            System.Windows.Forms.Panel panel, string suffix,
            System.Windows.Forms.Label lSigma, System.Windows.Forms.Label lThresh,
            System.Windows.Forms.Label lTrans, System.Windows.Forms.Label lSel,
            System.Windows.Forms.Label lMinScore, System.Windows.Forms.Label lNumInst,
            System.Windows.Forms.Label lDistThresh, System.Windows.Forms.Label lMaxIter,
            System.Windows.Forms.Label lInterp, System.Windows.Forms.Label lIOReg,
            System.Windows.Forms.NumericUpDown nSigma, System.Windows.Forms.NumericUpDown nThresh,
            System.Windows.Forms.ComboBox cTrans, System.Windows.Forms.ComboBox cSel,
            System.Windows.Forms.NumericUpDown nMinScore, System.Windows.Forms.NumericUpDown nNumInst,
            System.Windows.Forms.NumericUpDown nDistThresh, System.Windows.Forms.NumericUpDown nMaxIter,
            System.Windows.Forms.ComboBox cInterp, System.Windows.Forms.ComboBox cIOReg,
            System.EventHandler nudChanged, System.EventHandler cbChanged)
        {
            panel.Dock = System.Windows.Forms.DockStyle.Fill;
            panel.AutoScroll = true;
            panel.Name = "panel_Measure_" + suffix;

            int y = 10, lblX = 10, ctrlX = 110, ctrlW = 130;

            // Sigma
            SetupLabel(lSigma, "lbl_" + suffix + "_Sigma", "Sigma", lblX, y);
            panel.Controls.Add(lSigma);
            SetupNUD(nSigma, "NUD_" + suffix + "_Sigma", ctrlX, y, ctrlW, 0.5m, 10m, 1, 3.0m);
            nSigma.Increment = 0.1m;
            nSigma.ValueChanged += nudChanged;
            panel.Controls.Add(nSigma);
            y += 32;

            // Threshold
            SetupLabel(lThresh, "lbl_" + suffix + "_Threshold", "\u9608\u503c", lblX, y);
            panel.Controls.Add(lThresh);
            SetupNUD(nThresh, "NUD_" + suffix + "_Threshold", ctrlX, y, ctrlW, 0, 255, 0, 20);
            nThresh.ValueChanged += nudChanged;
            panel.Controls.Add(nThresh);
            y += 32;

            // Transition
            SetupLabel(lTrans, "lbl_" + suffix + "_Transition", "\u6781\u6027", lblX, y);
            panel.Controls.Add(lTrans);
            cTrans.DropDownStyle = System.Windows.Forms.ComboBoxStyle.DropDownList;
            cTrans.Location = new System.Drawing.Point(ctrlX, y);
            cTrans.Size = new System.Drawing.Size(ctrlW, 24);
            cTrans.Name = "CB_" + suffix + "_Transition";
            cTrans.Font = new System.Drawing.Font("\u5fae\u8f6f\u96c5\u9ed1", 9F);
            cTrans.SelectedIndexChanged += cbChanged;
            panel.Controls.Add(cTrans);
            y += 32;

            // Select
            SetupLabel(lSel, "lbl_" + suffix + "_Select", "\u9009\u8fb9", lblX, y);
            panel.Controls.Add(lSel);
            cSel.DropDownStyle = System.Windows.Forms.ComboBoxStyle.DropDownList;
            cSel.Location = new System.Drawing.Point(ctrlX, y);
            cSel.Size = new System.Drawing.Size(ctrlW, 24);
            cSel.Name = "CB_" + suffix + "_Select";
            cSel.Font = new System.Drawing.Font("\u5fae\u8f6f\u96c5\u9ed1", 9F);
            cSel.SelectedIndexChanged += cbChanged;
            panel.Controls.Add(cSel);
            y += 32;

            // MinScore
            SetupLabel(lMinScore, "lbl_" + suffix + "_MinScore", "\u6700\u5c0f\u5f97\u5206", lblX, y);
            panel.Controls.Add(lMinScore);
            SetupNUD(nMinScore, "NUD_" + suffix + "_MinScore", ctrlX, y, ctrlW, 0.1m, 1m, 1, 0.5m);
            nMinScore.Increment = 0.1m;
            nMinScore.ValueChanged += nudChanged;
            panel.Controls.Add(nMinScore);
            y += 32;

            // NumInstances
            SetupLabel(lNumInst, "lbl_" + suffix + "_NumInst", "\u5b9e\u4f8b\u6570", lblX, y);
            panel.Controls.Add(lNumInst);
            SetupNUD(nNumInst, "NUD_" + suffix + "_NumInstances", ctrlX, y, ctrlW, 1, 9999, 0, 1);
            nNumInst.ValueChanged += nudChanged;
            panel.Controls.Add(nNumInst);
            y += 32;

            // DistThreshold
            SetupLabel(lDistThresh, "lbl_" + suffix + "_DistThresh", "\u8ddd\u79bb\u9608\u503c", lblX, y);
            panel.Controls.Add(lDistThresh);
            SetupNUD(nDistThresh, "NUD_" + suffix + "_DistThreshold", ctrlX, y, ctrlW, 0.5m, 100m, 1, 3.5m);
            nDistThresh.Increment = 0.5m;
            nDistThresh.ValueChanged += nudChanged;
            panel.Controls.Add(nDistThresh);
            y += 32;

            // MaxIterations
            SetupLabel(lMaxIter, "lbl_" + suffix + "_MaxIter", "\u6700\u5927\u8fed\u4ee3", lblX, y);
            panel.Controls.Add(lMaxIter);
            SetupNUD(nMaxIter, "NUD_" + suffix + "_MaxIterations", ctrlX, y, ctrlW, -1, 50, 0, -1);
            nMaxIter.ValueChanged += nudChanged;
            panel.Controls.Add(nMaxIter);
            y += 32;

            // Interpolation
            SetupLabel(lInterp, "lbl_" + suffix + "_Interpolation", "\u63d2\u503c\u7c7b\u578b", lblX, y);
            panel.Controls.Add(lInterp);
            cInterp.DropDownStyle = System.Windows.Forms.ComboBoxStyle.DropDownList;
            cInterp.Location = new System.Drawing.Point(ctrlX, y);
            cInterp.Size = new System.Drawing.Size(ctrlW, 24);
            cInterp.Name = "CB_" + suffix + "_Interpolation";
            cInterp.Font = new System.Drawing.Font("\u5fae\u8f6f\u96c5\u9ed1", 9F);
            cInterp.SelectedIndexChanged += cbChanged;
            panel.Controls.Add(cInterp);
            y += 32;

            // IORegions
            SetupLabel(lIOReg, "lbl_" + suffix + "_IORegions", "\u533a\u57df\u9a8c\u8bc1", lblX, y);
            panel.Controls.Add(lIOReg);
            cIOReg.DropDownStyle = System.Windows.Forms.ComboBoxStyle.DropDownList;
            cIOReg.Location = new System.Drawing.Point(ctrlX, y);
            cIOReg.Size = new System.Drawing.Size(ctrlW, 24);
            cIOReg.Name = "CB_" + suffix + "_IORegions";
            cIOReg.Font = new System.Drawing.Font("\u5fae\u8f6f\u96c5\u9ed1", 9F);
            cIOReg.SelectedIndexChanged += cbChanged;
            panel.Controls.Add(cIOReg);
        }

        private void SetupTableLabel(System.Windows.Forms.Label lbl, string name, string text)
        {
            lbl.Name = name;
            lbl.Text = text;
            lbl.Dock = System.Windows.Forms.DockStyle.Fill;
            lbl.TextAlign = System.Drawing.ContentAlignment.MiddleRight;
            lbl.Font = new System.Drawing.Font("\u5fae\u8f6f\u96c5\u9ed1", 9.5F);
            lbl.Padding = new System.Windows.Forms.Padding(0, 0, 8, 0);
        }

        private void SetupTableNUD(System.Windows.Forms.NumericUpDown nud, string name,
            decimal min, decimal max, int decimals, decimal value)
        {
            nud.Name = name;
            nud.Minimum = min;
            nud.Maximum = max;
            nud.DecimalPlaces = decimals;
            nud.Value = value;
            nud.Dock = System.Windows.Forms.DockStyle.Fill;
            nud.Font = new System.Drawing.Font("\u5fae\u8f6f\u96c5\u9ed1", 9.5F);
        }

        private void SetupLabel(System.Windows.Forms.Label lbl, string name, string text, int x, int y)
        {
            lbl.Name = name;
            lbl.Text = text;
            lbl.Location = new System.Drawing.Point(x, y + 3);
            lbl.AutoSize = true;
            lbl.Font = new System.Drawing.Font("\u5fae\u8f6f\u96c5\u9ed1", 9F);
        }

        private void SetupNUD(System.Windows.Forms.NumericUpDown nud, string name,
            int x, int y, int w, decimal min, decimal max, int decimals, decimal value)
        {
            nud.Name = name;
            nud.Location = new System.Drawing.Point(x, y);
            nud.Size = new System.Drawing.Size(w, 24);
            nud.Minimum = min;
            nud.Maximum = max;
            nud.DecimalPlaces = decimals;
            nud.Value = value;
            nud.Font = new System.Drawing.Font("\u5fae\u8f6f\u96c5\u9ed1", 9F);
        }

        #endregion

