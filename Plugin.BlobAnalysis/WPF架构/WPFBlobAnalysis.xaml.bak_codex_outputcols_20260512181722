<UserControl x:Class="Plugin.BlobAnalysis.WPFArchitecture.WPFBlobAnalysis"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
             Background="#05080D" Foreground="#EAFBFF" FontFamily="Microsoft YaHei UI" FontSize="13"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#081018"/>
        <SolidColorBrush x:Key="PanelBg2" Color="#0B141E"/>
        <SolidColorBrush x:Key="LineCyan" Color="#23D9FF"/>
        <SolidColorBrush x:Key="LinePink" Color="#FF3FB4"/>
        <SolidColorBrush x:Key="InputBg" Color="#F7FBFF"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EAFBFF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Background" Value="#102638"/>
            <Setter Property="Foreground" Value="#F7FEFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineCyan}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,3,8,3"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="#111820"/>
            <Setter Property="BorderBrush" Value="#BFD3E0"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,3,8,3"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="#111820"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#EAFBFF"/>
            <Setter Property="Margin" Value="0,5,14,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#F7FBFF"/>
            <Setter Property="Foreground" Value="#111820"/>
            <Setter Property="RowBackground" Value="#FFFFFF"/>
            <Setter Property="AlternatingRowBackground" Value="#EEF6FB"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="Foreground" Value="#EAFBFF"/>
            <Setter Property="BorderBrush" Value="#355A6E"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Foreground" Value="#111820"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="GroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Foreground" Value="#EAFBFF"/>
            <Setter Property="BorderBrush" Value="#21485A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.65*" MinWidth="760"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="0.82*" MinWidth="440"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="120"/>
        </Grid.RowDefinitions>

        <Border Grid.ColumnSpan="3" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource LineCyan}" BorderThickness="1" CornerRadius="6" Padding="12,8">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text=" Blob分析工具" FontSize="22" FontWeight="Bold"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="&#x52A0;&#x8F7D;&#x56FE;&#x50CF;" Click="OnLoadImageClick"/>
                    <Button Content="&#x56FE;&#x50CF;&#x9002;&#x5E94;" Click="OnFitImageClick"/>
                    <Button Content="&#x8FD0;&#x884C;&#x5206;&#x6790;" Click="OnRunClick"/>
                    <Button Content="&#x4FDD;&#x5B58;&#x53C2;&#x6570;" Click="OnSaveParamsClick"/>
                    <Button Content="&#x8BFB;&#x53D6;&#x53C2;&#x6570;" Click="OnLoadParamsClick"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="0.72*"/>
            </Grid.RowDefinitions>

            <Border Grid.RowSpan="3" Background="Black" BorderBrush="{StaticResource LineCyan}" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                <Grid>
                    <TextBlock Text="&#x8FD0;&#x884C;&#x56FE;" Margin="8" FontWeight="Bold" Panel.ZIndex="2"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,12,0" Panel.ZIndex="2">
                        <TextBlock Text="{Binding MouseInfo}" Foreground="#8DFF64" Margin="0,0,18,0"/>
                        <TextBlock Text="{Binding ImageInfo}"/>
                    </StackPanel>
                    <Border Margin="4,34,4,4">
                        <wfi:WindowsFormsHost x:Name="MainHost"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource LinePink}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <TextBlock Text="&#x5F53;&#x524D;&#x9009;&#x4E2D; Region &#x9884;&#x89C8;" Margin="10,6" FontWeight="Bold"/>
                    <Button Content="&#x9002;&#x5E94;" Width="58" Height="28" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,8,0" Click="OnFitPreviewClick"/>
                    <Border Margin="6,38,6,6" Background="Black">
                        <wfi:WindowsFormsHost x:Name="PreviewHost"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Grid.Row="2" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource LineCyan}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <TextBlock Text="&#x8FC7;&#x6EE4;&#x540E; Blob &#x663E;&#x793A;" Margin="10,6" FontWeight="Bold"/>
                    <Button Content="&#x9002;&#x5E94;" Width="58" Height="28" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,8,0" Click="OnFitResultClick"/>
                    <Border Margin="6,38,6,6" Background="Black">
                        <wfi:WindowsFormsHost x:Name="ResultHost"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Grid.Column="0" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource PanelBg}" BorderBrush="#21485A" BorderThickness="1" CornerRadius="4" Padding="12">
                <StackPanel>
                    <TextBlock Text="&#x56FE;&#x50CF;/&#x9F20;&#x6807;" Foreground="{StaticResource LineCyan}" FontWeight="Bold"/>
                    <TextBlock Text="{Binding ImageInfo}" Margin="0,10,0,0"/>
                    <TextBlock Text="{Binding MouseInfo}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource PanelBg}" BorderBrush="#21485A" BorderThickness="1" CornerRadius="4" Padding="12">
                <StackPanel>
                    <TextBlock Text="&#x8FD0;&#x884C;&#x8F93;&#x51FA;" Foreground="{StaticResource LinePink}" FontWeight="Bold"/>
                    <TextBlock Text="{Binding RunSummary}" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Background="{StaticResource PanelBg}" BorderBrush="#21485A" BorderThickness="1" CornerRadius="4" Padding="12">
                <StackPanel>
                    <TextBlock Text="&#x72B6;&#x6001;" Foreground="#8DFF64" FontWeight="Bold"/>
                    <TextBlock Text="{Binding StatusText}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Column="2" Grid.Row="1" Grid.RowSpan="2" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource LinePink}" BorderThickness="1" CornerRadius="6" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Blob &#x53C2;&#x6570;&#x4E0E;&#x8F93;&#x51FA;" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
                <TabControl Grid.Row="1">
                    <TabItem Header="&#x57FA;&#x7840;&#x53C2;&#x6570;">
                        <Border Background="{StaticResource PanelBg2}" Padding="10">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <GroupBox Header="&#x68C0;&#x6D4B;&#x8303;&#x56F4;" Style="{StaticResource GroupBoxStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="96"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="&#x68C0;&#x6D4B;&#x6A21;&#x5F0F;"/>
                                            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding DetectModeItems}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding DetectMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="ROI &#x529F;&#x80FD;"/>
                                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding RoiRoleItems}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding EditRole, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <WrapPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,6,0,0">
                                                <CheckBox Content="&#x542F;&#x7528;&#x5C40;&#x90E8; ROI" IsChecked="{Binding EnableLocalRoi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <CheckBox Content="&#x542F;&#x7528;&#x5C4F;&#x853D; ROI" IsChecked="{Binding EnableMaskRoi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <CheckBox Content="&#x663E;&#x793A; ViewROI" IsChecked="{Binding ShowViewRoi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </WrapPanel>
                                        </Grid>
                                    </GroupBox>

                                    <GroupBox Header="&#x9608;&#x503C;&#x4E0E;&#x5F62;&#x6001;&#x5B66;" Style="{StaticResource GroupBoxStyle}">
                                        <UniformGrid Columns="2">
                                            <TextBlock Text="&#x9608;&#x503C; Min"/>
                                            <TextBox Text="{Binding ThresholdMin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Text="&#x9608;&#x503C; Max"/>
                                            <TextBox Text="{Binding ThresholdMax, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Text="&#x5F62;&#x6001;&#x5B66;&#x65B9;&#x5F0F;"/>
                                            <ComboBox ItemsSource="{Binding MorphModeItems}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding MorphMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Text="&#x5F62;&#x6001;&#x5B66;&#x534A;&#x5F84;"/>
                                            <TextBox Text="{Binding MorphRadius, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </UniformGrid>
                                    </GroupBox>

                                    <GroupBox Header="&#x6392;&#x5E8F;&#x8F93;&#x51FA;" Style="{StaticResource GroupBoxStyle}">
                                        <UniformGrid Columns="2">
                                            <TextBlock Text="&#x6392;&#x5E8F;&#x7279;&#x5F81;"/>
                                            <ComboBox ItemsSource="{Binding SortFeatureItems}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding SortFeature, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Text="&#x6392;&#x5E8F;&#x65B9;&#x5411;"/>
                                            <ComboBox ItemsSource="{Binding SortDirectionItems}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding SortDirection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </UniformGrid>
                                    </GroupBox>

                                    <GroupBox Header="&#x4F4D;&#x7F6E;&#x8DDF;&#x968F;" Style="{StaticResource GroupBoxStyle}">
                                        <StackPanel>
                                            <WrapPanel>
                                                <CheckBox Content="&#x542F;&#x7528;&#x4F4D;&#x7F6E;&#x8DDF;&#x968F;" IsChecked="{Binding EnablePositionFollow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <Button Content="&#x53F3;&#x952E;&#x70B9;&#x8BBE;&#x4E3A; Base" Command="{Binding SetBaseFromMouseCommand}"/>
                                                <Button Content="&#x53F3;&#x952E;&#x70B9;&#x8BBE;&#x4E3A; Current" Command="{Binding SetCurrentFromMouseCommand}"/>
                                            </WrapPanel>
                                            <UniformGrid Columns="2" Margin="0,8,0,0">
                                                <TextBlock Text="Base Row"/><TextBox Text="{Binding BaseRow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Text="Base Col"/><TextBox Text="{Binding BaseCol, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Text="Base Angle"/><TextBox Text="{Binding BaseAngle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Text="Current Row"/><TextBox Text="{Binding CurrentRow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Text="Current Col"/><TextBox Text="{Binding CurrentCol, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Text="Current Angle"/><TextBox Text="{Binding CurrentAngle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </UniformGrid>
                                        </StackPanel>
                                    </GroupBox>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </TabItem>

                    <TabItem Header="ROI&#x8BBE;&#x7F6E;">
                        <Border Background="{StaticResource PanelBg2}" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <UniformGrid Columns="2">
                                    <TextBlock Text="&#x5C40;&#x90E8; Row1"/><TextBox Text="{Binding LocalRow1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="&#x5C40;&#x90E8; Col1"/><TextBox Text="{Binding LocalCol1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="&#x5C40;&#x90E8; Row2"/><TextBox Text="{Binding LocalRow2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="&#x5C40;&#x90E8; Col2"/><TextBox Text="{Binding LocalCol2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </UniformGrid>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8">
                                    <Button Content="&#x65B0;&#x589E;&#x5C4F;&#x853D; ROI" Command="{Binding AddMaskRoiCommand}"/>
                                    <Button Content="&#x5220;&#x9664;&#x5C4F;&#x853D; ROI" Command="{Binding DeleteMaskRoiCommand}"/>
                                </StackPanel>
                                <DataGrid Grid.Row="2" ItemsSource="{Binding MaskRois}" SelectedItem="{Binding SelectedMaskRoi, Mode=TwoWay}" AutoGenerateColumns="False">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="&#x542F;&#x7528;" Binding="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="52"/>
                                        <DataGridTextColumn Header="#" Binding="{Binding Index, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="38"/>
                                        <DataGridTextColumn Header="&#x540D;&#x79F0;" Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                                        <DataGridTextColumn Header="Row1" Binding="{Binding Row1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                        <DataGridTextColumn Header="Col1" Binding="{Binding Col1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                        <DataGridTextColumn Header="Row2" Binding="{Binding Row2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                        <DataGridTextColumn Header="Col2" Binding="{Binding Col2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </TabItem>

                    <TabItem Header="&#x8FC7;&#x6EE4;&#x6761;&#x4EF6;">
                        <Border Background="{StaticResource PanelBg2}" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="&#x65B0;&#x589E;&#x8FC7;&#x6EE4;" Command="{Binding AddFilterCommand}"/>
                                    <Button Content="&#x5220;&#x9664;&#x8FC7;&#x6EE4;" Command="{Binding DeleteFilterCommand}"/>
                                </StackPanel>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter, Mode=TwoWay}" AutoGenerateColumns="False">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="&#x542F;&#x7528;" Binding="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                                        <DataGridTemplateColumn Header="&#x5C5E;&#x6027;" Width="150">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding DataContext.FilterFeatureItems, RelativeSource={RelativeSource AncestorType=UserControl}}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding Feature, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="&#x6700;&#x5C0F;&#x503C;" Binding="{Binding Min, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                        <DataGridTextColumn Header="&#x6700;&#x5927;&#x503C;" Binding="{Binding Max, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                        <DataGridTemplateColumn Header="&#x903B;&#x8F91;" Width="92">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding DataContext.FilterOperationItems, RelativeSource={RelativeSource AncestorType=UserControl}}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding Operation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </TabItem>

                    <TabItem Header="&#x8F93;&#x51FA;&#x7ED3;&#x679C;">
                        <Border Background="{StaticResource PanelBg2}" Padding="10">
                            <DataGrid ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedRegion, Mode=TwoWay}" AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="45"/>
                                    <DataGridTextColumn Header="&#x9762;&#x79EF;" Binding="{Binding Area, StringFormat=0.###}" Width="78"/>
                                    <DataGridTextColumn Header="Row" Binding="{Binding Row, StringFormat=0.###}" Width="78"/>
                                    <DataGridTextColumn Header="Col" Binding="{Binding Col, StringFormat=0.###}" Width="78"/>
                                    <DataGridTextColumn Header="&#x957F;&#x5BBD;&#x6BD4;" Binding="{Binding Ratio, StringFormat=0.###}" Width="78"/>
                                    <DataGridTextColumn Header="&#x89D2;&#x5EA6;" Binding="{Binding AngleDeg, StringFormat=0.###}" Width="78"/>
                                    <DataGridTextColumn Header="&#x5747;&#x7070;&#x5EA6;" Binding="{Binding MeanGray, StringFormat=0.###}" Width="78"/>
                                    <DataGridTextColumn Header="&#x5706;&#x5EA6;" Binding="{Binding Circularity, StringFormat=0.###}" Width="68"/>
                                    <DataGridTextColumn Header="&#x77E9;&#x5F62;&#x5EA6;" Binding="{Binding Rectangularity, StringFormat=0.###}" Width="78"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>