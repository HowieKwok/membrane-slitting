<UserControl x:Class="Plugin.BlobAnalysis.WPFArchitecture.WPFBlobAnalysis"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
             Background="#05080D" Foreground="#EAFBFF" FontFamily="Microsoft YaHei UI" FontSize="13"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#081018"/>
        <SolidColorBrush x:Key="PanelBg2" Color="#0B141E"/>
        <SolidColorBrush x:Key="LineCyan" Color="#23D9FF"/>
        <SolidColorBrush x:Key="LinePink" Color="#FF3FB4"/>
        <SolidColorBrush x:Key="InputBg" Color="#F7FBFF"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EAFBFF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Background" Value="#102638"/>
            <Setter Property="Foreground" Value="#F7FEFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineCyan}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,3,8,3"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="#111820"/>
            <Setter Property="BorderBrush" Value="#BFD3E0"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,3,8,3"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="#111820"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#EAFBFF"/>
            <Setter Property="Margin" Value="0,5,14,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#F7FBFF"/>
            <Setter Property="Foreground" Value="#111820"/>
            <Setter Property="RowBackground" Value="#FFFFFF"/>
            <Setter Property="AlternatingRowBackground" Value="#EEF6FB"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="Foreground" Value="#EAFBFF"/>
            <Setter Property="BorderBrush" Value="#355A6E"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Foreground" Value="#111820"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="GroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Foreground" Value="#EAFBFF"/>
            <Setter Property="BorderBrush" Value="#21485A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.65*" MinWidth="760"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="0.82*" MinWidth="440"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="120"/>
        </Grid.RowDefinitions>

        <Border Grid.ColumnSpan="3" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource LineCyan}" BorderThickness="1" CornerRadius="6" Padding="12,8">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text=" Blob分析工具" FontSize="22" FontWeight="Bold"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="加载图像" Click="OnLoadImageClick"/>
                    <Button Content="图像适应" Click="OnFitImageClick"/>
                    <Button Content="运行分析" Click="OnRunClick"/>
                    <Button Content="保存参数" Click="OnSaveParamsClick" Visibility="Collapsed"/>
                    <Button Content="读取参数" Click="OnLoadParamsClick" Visibility="Collapsed"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="0.72*"/>
            </Grid.RowDefinitions>

            <Border Grid.RowSpan="3" Background="Black" BorderBrush="{StaticResource LineCyan}" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                <Grid>
                    <TextBlock Text="运行图" Margin="8" FontWeight="Bold" Panel.ZIndex="2"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,12,0" Panel.ZIndex="2">
                        <TextBlock Text="{Binding MouseInfo}" Foreground="#8DFF64" Margin="0,0,18,0"/>
                        <TextBlock Text="{Binding ImageInfo}"/>
                    </StackPanel>
                    <Border Margin="4,34,4,4">
                        <wfi:WindowsFormsHost x:Name="MainHost"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource LinePink}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <TextBlock Text="当前选中 Region 预览" Margin="10,6" FontWeight="Bold"/>
                    <Button Content="适应" Width="58" Height="28" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,8,0" Click="OnFitPreviewClick"/>
                    <Border Margin="6,38,6,6" Background="Black">
                        <wfi:WindowsFormsHost x:Name="PreviewHost"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Grid.Row="2" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource LineCyan}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <TextBlock Text="过滤后 Blob 显示" Margin="10,6" FontWeight="Bold"/>
                    <Button Content="适应" Width="58" Height="28" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,8,0" Click="OnFitResultClick"/>
                    <Border Margin="6,38,6,6" Background="Black">
                        <wfi:WindowsFormsHost x:Name="ResultHost"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Grid.Column="0" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource PanelBg}" BorderBrush="#21485A" BorderThickness="1" CornerRadius="4" Padding="12">
                <StackPanel>
                    <TextBlock Text="图像/鼠标" Foreground="{StaticResource LineCyan}" FontWeight="Bold"/>
                    <TextBlock Text="{Binding ImageInfo}" Margin="0,10,0,0"/>
                    <TextBlock Text="{Binding MouseInfo}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource PanelBg}" BorderBrush="#21485A" BorderThickness="1" CornerRadius="4" Padding="12">
                <StackPanel>
                    <TextBlock Text="运行输出" Foreground="{StaticResource LinePink}" FontWeight="Bold"/>
                    <TextBlock Text="{Binding RunSummary}" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Background="{StaticResource PanelBg}" BorderBrush="#21485A" BorderThickness="1" CornerRadius="4" Padding="12">
                <StackPanel>
                    <TextBlock Text="状态" Foreground="#8DFF64" FontWeight="Bold"/>
                    <TextBlock Text="{Binding StatusText}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Column="2" Grid.Row="1" Grid.RowSpan="2" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource LinePink}" BorderThickness="1" CornerRadius="6" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Blob 参数与输出" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
                <TabControl Grid.Row="1">
                    <TabItem Header="基础参数">
                        <Border Background="{StaticResource PanelBg2}" Padding="10">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <GroupBox Header="检测范围" Style="{StaticResource GroupBoxStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="96"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="检测模式"/>
                                            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding DetectModeItems}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding DetectMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="ROI 功能"/>
                                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding RoiRoleItems}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding EditRole, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <WrapPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,6,0,0">
                                                <CheckBox Content="模块启用" IsChecked="{Binding m_bIsEnable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <CheckBox Content="启用局部 ROI" IsChecked="{Binding EnableLocalRoi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <CheckBox Content="启用屏蔽 ROI" IsChecked="{Binding EnableMaskRoi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <CheckBox Content="显示 ViewROI" IsChecked="{Binding ShowViewRoi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </WrapPanel>
                                        </Grid>
                                    </GroupBox>

                                    <GroupBox Header="阈值与形态学" Style="{StaticResource GroupBoxStyle}">
                                        <UniformGrid Columns="2">
                                            <TextBlock Text="阈值 Min"/>
                                            <TextBox Text="{Binding ThresholdMin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Text="阈值 Max"/>
                                            <TextBox Text="{Binding ThresholdMax, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Text="形态学方式"/>
                                            <ComboBox ItemsSource="{Binding MorphModeItems}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding MorphMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Text="形态学半径"/>
                                            <TextBox Text="{Binding MorphRadius, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </UniformGrid>
                                    </GroupBox>

                                    <GroupBox Header="排序输出" Style="{StaticResource GroupBoxStyle}">
                                        <UniformGrid Columns="2">
                                            <TextBlock Text="排序特征"/>
                                            <ComboBox ItemsSource="{Binding SortFeatureItems}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding SortFeature, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Text="排序方向"/>
                                            <ComboBox ItemsSource="{Binding SortDirectionItems}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding SortDirection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </UniformGrid>
                                    </GroupBox>

                                    <GroupBox Header="位置跟随" Style="{StaticResource GroupBoxStyle}">
                                        <StackPanel>
                                            <WrapPanel>
                                                <CheckBox Content="启用位置跟随" IsChecked="{Binding EnablePositionFollow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <Button Content="右键点设为 Base" Command="{Binding SetBaseFromMouseCommand}"/>
                                                <Button Content="右键点设为 Current" Command="{Binding SetCurrentFromMouseCommand}"/>
                                            </WrapPanel>
                                            <UniformGrid Columns="2" Margin="0,8,0,0">
                                                <TextBlock Text="Base Row"/><TextBox Text="{Binding BaseRow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Text="Base Col"/><TextBox Text="{Binding BaseCol, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Text="Base Angle"/><TextBox Text="{Binding BaseAngle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Text="Current Row"/><TextBox Text="{Binding CurrentRow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Text="Current Col"/><TextBox Text="{Binding CurrentCol, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Text="Current Angle"/><TextBox Text="{Binding CurrentAngle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </UniformGrid>
                                        </StackPanel>
                                    </GroupBox>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </TabItem>

                    <TabItem Header="ROI设置">
                        <Border Background="{StaticResource PanelBg2}" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <UniformGrid Columns="4">
                                    <TextBlock Text="局部 Row1"/><TextBox Text="{Binding LocalRow1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="局部 Col1"/><TextBox Text="{Binding LocalCol1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="局部 Row2"/><TextBox Text="{Binding LocalRow2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="局部 Col2"/><TextBox Text="{Binding LocalCol2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="上偏移（Row）"/>
                                    <TextBox Text="{Binding TopOffsetRow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="下偏移（Row）"/>
                                    <TextBox Text="{Binding BottomOffsetRow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="左偏移(Col)"/>
                                    <TextBox Text="{Binding LeftOffsetCol, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="右偏移(Col)"/>
                                    <TextBox Text="{Binding RightOffsetCol, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </UniformGrid>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8">
                                    <Button Content="新增屏蔽 ROI" Command="{Binding AddMaskRoiCommand}"/>
                                    <Button Content="删除屏蔽 ROI" Command="{Binding DeleteMaskRoiCommand}"/>
                                </StackPanel>
                                <DataGrid Grid.Row="2" ItemsSource="{Binding MaskRois}" SelectedItem="{Binding SelectedMaskRoi, Mode=TwoWay}" AutoGenerateColumns="False">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="52"/>
                                        <DataGridTextColumn Header="#" Binding="{Binding Index, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="38"/>
                                        <DataGridTextColumn Header="名称" Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                                        <DataGridTextColumn Header="Row1" Binding="{Binding Row1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                        <DataGridTextColumn Header="Col1" Binding="{Binding Col1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                        <DataGridTextColumn Header="Row2" Binding="{Binding Row2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                        <DataGridTextColumn Header="Col2" Binding="{Binding Col2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </TabItem>

                    <TabItem Header="过滤条件">
                        <Border Background="{StaticResource PanelBg2}" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="新增过滤" Command="{Binding AddFilterCommand}"/>
                                    <Button Content="删除过滤" Command="{Binding DeleteFilterCommand}"/>
                                </StackPanel>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter, Mode=TwoWay}" AutoGenerateColumns="False">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                                        <DataGridTemplateColumn Header="属性" Width="150">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding DataContext.FilterFeatureItems, RelativeSource={RelativeSource AncestorType=UserControl}}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding Feature, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="最小值" Binding="{Binding Min, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                        <DataGridTextColumn Header="最大值" Binding="{Binding Max, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                        <DataGridTemplateColumn Header="逻辑" Width="92">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding DataContext.FilterOperationItems, RelativeSource={RelativeSource AncestorType=UserControl}}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding Operation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </TabItem>

                    <TabItem Header="输出结果">
                        <Border Background="{StaticResource PanelBg2}" Padding="10">
                            <DataGrid ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedRegion, Mode=TwoWay}" AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="45"/>
                                    <DataGridTextColumn Header="面积" Binding="{Binding Area, StringFormat=0.###}" Width="78"/>
                                    <DataGridTextColumn Header="质心Row" Binding="{Binding Row, StringFormat=0.###}" Width="82"/>
                                    <DataGridTextColumn Header="质心Col" Binding="{Binding Col, StringFormat=0.###}" Width="82"/>
                                    <DataGridTextColumn Header="矩形Row" Binding="{Binding Rect2Row, StringFormat=0.###}" Width="82"/>
                                    <DataGridTextColumn Header="矩形Col" Binding="{Binding Rect2Col, StringFormat=0.###}" Width="82"/>
                                    <DataGridTextColumn Header="长轴Ra" Binding="{Binding Ra, StringFormat=0.###}" Width="78"/>
                                    <DataGridTextColumn Header="短轴Rb" Binding="{Binding Rb, StringFormat=0.###}" Width="78"/>
                                    <DataGridTextColumn Header="半长边L1" Binding="{Binding Length1, StringFormat=0.###}" Width="86"/>
                                    <DataGridTextColumn Header="半短边L2" Binding="{Binding Length2, StringFormat=0.###}" Width="86"/>
                                    <DataGridTextColumn Header="长宽比" Binding="{Binding Ratio, StringFormat=0.###}" Width="78"/>
                                    <DataGridTextColumn Header="Phi(rad)" Binding="{Binding Phi, StringFormat=0.###}" Width="78"/>
                                    <DataGridTextColumn Header="角度Deg" Binding="{Binding AngleDeg, StringFormat=0.###}" Width="82"/>
                                    <DataGridTextColumn Header="圆度" Binding="{Binding Circularity, StringFormat=0.###}" Width="68"/>
                                    <DataGridTextColumn Header="矩形度" Binding="{Binding Rectangularity, StringFormat=0.###}" Width="78"/>
                                    <DataGridTextColumn Header="均灰度" Binding="{Binding MeanGray, StringFormat=0.###}" Width="78"/>
                                    <DataGridTextColumn Header="灰度偏差" Binding="{Binding DeviationGray, StringFormat=0.###}" Width="88"/>
                                    <DataGridTextColumn Header="最小灰度" Binding="{Binding MinGray, StringFormat=0.###}" Width="88"/>
                                    <DataGridTextColumn Header="最大灰度" Binding="{Binding MaxGray, StringFormat=0.###}" Width="88"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>