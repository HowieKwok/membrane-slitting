<UserControl x:Class="Plugin.CACRunCalibration.WPF架构.WPFRunCalibration"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ctrl="clr-namespace:FrameCommunity.UserControls;assembly=FrameCommunity"
             xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
             mc:Ignorable="d"
             d:DesignWidth="1380"
             d:DesignHeight="820"
             Background="#05080D"
             Loaded="OnLoaded"
            >
    <UserControl.Resources>
        <LinearGradientBrush x:Key="BgBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#05080D" Offset="0"/>
            <GradientStop Color="#071827" Offset="0.45"/>
            <GradientStop Color="#150A18" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="Cyan" Color="#25D9FF"/>
        <SolidColorBrush x:Key="Magenta" Color="#FF3FA8"/>
        <SolidColorBrush x:Key="Green" Color="#83FF72"/>
        <SolidColorBrush x:Key="Amber" Color="#FFD166"/>
        <SolidColorBrush x:Key="TextMain" Color="#EAFBFF"/>
        <SolidColorBrush x:Key="TextSub" Color="#8FB5C7"/>
        <SolidColorBrush x:Key="PanelBg" Color="#101A26"/>
        <SolidColorBrush x:Key="PanelDeep" Color="#07111C"/>
        <SolidColorBrush x:Key="LineBrush" Color="#245D73"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="#D9101A26"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Cyan}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,2,0,8"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#BFEAFF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Foreground" Value="#F2FEFF"/>
            <Setter Property="Background" Value="#123044"/>
            <Setter Property="BorderBrush" Value="#25D9FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="#07111C"/>
            <Setter Property="Foreground" Value="#101820"/>
            <Setter Property="BorderBrush" Value="#2B7892"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Margin" Value="0,4,14,8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ctrl:NumericBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Increment" Value="1"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#07111C"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="RowBackground" Value="#0D1721"/>
            <Setter Property="AlternatingRowBackground" Value="#111E2B"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#1D4557"/>
            <Setter Property="VerticalGridLinesBrush" Value="#1D4557"/>
            <Setter Property="BorderBrush" Value="#245D73"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#123044"/>
            <Setter Property="Foreground" Value="#EAFBFF"/>
            <Setter Property="BorderBrush" Value="#245D73"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#EAFBFF"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BgBrush}" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="220"/>
            <RowDefinition Height="76"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.55*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="0.95*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="3" Style="{StaticResource Panel}" Background="#111E2B">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <TextBlock Text="CAC RUN CALIBRATION" Foreground="{StaticResource Cyan}" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="棋盘格坐标转换" Foreground="{StaticResource TextSub}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="图像：" Foreground="{StaticResource TextSub}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Model.ImageStateText}" Foreground="{StaticResource Cyan}" VerticalAlignment="Center" Margin="0,0,18,0"/>
                    <TextBlock Text="矩阵：" Foreground="{StaticResource TextSub}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Model.MatrixStateText}" Foreground="{StaticResource Green}" VerticalAlignment="Center" Margin="0,0,18,0"/>
                    <TextBlock Text="结果：" Foreground="{StaticResource TextSub}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Model.ResultStateText}" Foreground="{StaticResource Amber}" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Panel}" Margin="0,10,0,0">
            <Grid>
                <wfi:WindowsFormsHost x:Name="MainHost" Margin="2"/>
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Background="#B007111C" BorderBrush="#2D6A80" BorderThickness="1" CornerRadius="4" Padding="10">
                    <StackPanel Width="360">
                        <TextBlock Text="运行信息" Foreground="{StaticResource TextSub}"/>
                        <TextBlock Text="{Binding Model.RunMessage}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Model.MatrixCheckMessage}" TextWrapping="Wrap" Foreground="#BFEAFF" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding Model.LoadedImagePath}" TextWrapping="Wrap" FontSize="11" Foreground="#7BB2C7" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Panel}" Margin="0,10,0,0">
            <TabControl Background="Transparent">
                <TabItem Header="矩阵生成">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="6">
                            <TextBlock Text="图像与矩阵" Style="{StaticResource SectionTitle}"/>
                            <WrapPanel>
                                <Button Content="加载图像" Click="OnLoadImageClick"/>
                                <Button Content="生成矩阵" Click="OnGenerateMatrixClick"/>
                                <Button Content="按勾选重拟合" Click="OnRefitSelectedClick"/>
                                <Button Content="自检矩阵" Click="OnCheckMatrixClick"/>
                            </WrapPanel>

                            <TextBlock Text="棋盘参数" Style="{StaticResource SectionTitle}" Margin="0,8,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="86"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="行数" Style="{StaticResource FieldLabel}"/>
                                <ctrl:NumericBox Grid.Row="0" Grid.Column="1" Value="{Binding Model.BoardRows, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="1" Maximum="999" DecimalPlaces="0"/>
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="列数" Style="{StaticResource FieldLabel}"/>
                                <ctrl:NumericBox Grid.Row="0" Grid.Column="4" Value="{Binding Model.BoardColumns, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="1" Maximum="999" DecimalPlaces="0"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="X间距" Style="{StaticResource FieldLabel}"/>
                                <ctrl:NumericBox Grid.Row="1" Grid.Column="1" Value="{Binding Model.SpacingX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="100000" DecimalPlaces="4" Increment="0.1"/>
                                <TextBlock Grid.Row="1" Grid.Column="3" Text="Y间距" Style="{StaticResource FieldLabel}"/>
                                <ctrl:NumericBox Grid.Row="1" Grid.Column="4" Value="{Binding Model.SpacingY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="100000" DecimalPlaces="4" Increment="0.1"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="原点X" Style="{StaticResource FieldLabel}"/>
                                <ctrl:NumericBox Grid.Row="2" Grid.Column="1" Value="{Binding Model.OriginX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="-100000" Maximum="100000" DecimalPlaces="4" Increment="0.1"/>
                                <TextBlock Grid.Row="2" Grid.Column="3" Text="原点Y" Style="{StaticResource FieldLabel}"/>
                                <ctrl:NumericBox Grid.Row="2" Grid.Column="4" Value="{Binding Model.OriginY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="-100000" Maximum="100000" DecimalPlaces="4" Increment="0.1"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="码宽" Style="{StaticResource FieldLabel}"/>
                                <ctrl:NumericBox Grid.Row="3" Grid.Column="1" Value="{Binding Model.QrPhysicalWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="100000" DecimalPlaces="4" Increment="0.1"/>
                                <TextBlock Grid.Row="3" Grid.Column="3" Text="码高" Style="{StaticResource FieldLabel}"/>
                                <ctrl:NumericBox Grid.Row="3" Grid.Column="4" Value="{Binding Model.QrPhysicalHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="100000" DecimalPlaces="4" Increment="0.1"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="最大误差" Style="{StaticResource FieldLabel}"/>
                                <ctrl:NumericBox Grid.Row="4" Grid.Column="1" Value="{Binding Model.MaxAllowedErrorMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="100000" DecimalPlaces="4" Increment="0.01"/>
                            </Grid>

                            <TextBlock Text="二维码序号映射" Style="{StaticResource SectionTitle}" Margin="0,8,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="86"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="起始序号" Style="{StaticResource FieldLabel}"/>
                                <ctrl:NumericBox Grid.Row="0" Grid.Column="1" Value="{Binding Model.SerialBaseIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="999999" DecimalPlaces="0"/>
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="每行数量" Style="{StaticResource FieldLabel}"/>
                                <ctrl:NumericBox Grid.Row="0" Grid.Column="4" Value="{Binding Model.QrPerRow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="1" Maximum="999" DecimalPlaces="0"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="列步距" Style="{StaticResource FieldLabel}"/>
                                <ctrl:NumericBox Grid.Row="1" Grid.Column="1" Value="{Binding Model.QrColumnStep, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="1" Maximum="999" DecimalPlaces="0"/>
                                <TextBlock Grid.Row="1" Grid.Column="3" Text="行步距" Style="{StaticResource FieldLabel}"/>
                                <ctrl:NumericBox Grid.Row="1" Grid.Column="4" Value="{Binding Model.QrRowStep, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="1" Maximum="999" DecimalPlaces="0"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="奇行偏移" Style="{StaticResource FieldLabel}"/>
                                <ctrl:NumericBox Grid.Row="2" Grid.Column="1" Value="{Binding Model.QrOddRowColumnOffset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="-999" Maximum="999" DecimalPlaces="0"/>
                            </Grid>
                            <WrapPanel>
                                <CheckBox Content="反转行轴" IsChecked="{Binding Model.InvertRowAxis, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <CheckBox Content="反转列轴" IsChecked="{Binding Model.InvertColumnAxis, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </WrapPanel>

                            <TextBlock Text="HALCON识别参数" Style="{StaticResource SectionTitle}" Margin="0,8,0,8"/>
                            <TextBlock Text="二维码极性" Foreground="{StaticResource TextSub}"/>
                            <ComboBox ItemsSource="{Binding QrPolarityItems}" SelectedItem="{Binding Model.QrPolarity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="识别参数" Foreground="{StaticResource TextSub}"/>
                            <ComboBox ItemsSource="{Binding QrDefaultParamItems}" SelectedItem="{Binding Model.QrDefaultParameters, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="中心来源" Foreground="{StaticResource TextSub}"/>
                            <ComboBox ItemsSource="{Binding CenterSourceItems}" SelectedItem="{Binding Model.CenterSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="映射模型" Foreground="{StaticResource TextSub}"/>
                            <ComboBox ItemsSource="{Binding MappingModelItems}" SelectedItem="{Binding Model.MappingModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="最大识别数" Style="{StaticResource FieldLabel}"/>
                                <ctrl:NumericBox Grid.Column="1" Value="{Binding Model.StopAfterResultNum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="3" Maximum="999" DecimalPlaces="0"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="ROI">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="6">
                            <TextBlock Text="ViewROI矩形区域" Style="{StaticResource SectionTitle}"/>
                            <WrapPanel>
                                <CheckBox Content="启用ROI参与识别" IsChecked="{Binding Model.EnableRoi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Checked="OnRoiParameterChanged" Unchecked="OnRoiParameterChanged"/>
                                <CheckBox Content="显示ViewROI" IsChecked="{Binding Model.ShowViewRoi, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Checked="OnShowRoiChanged" Unchecked="OnShowRoiChanged"/>
                            </WrapPanel>
                            <Border Background="#0D1721" BorderBrush="#245D73" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,4,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Row1" Style="{StaticResource FieldLabel}"/>
                                    <ctrl:NumericBox Grid.Row="0" Grid.Column="1" Value="{Binding Model.RoiRow1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="200000" DecimalPlaces="3" Increment="1"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="Col1" Style="{StaticResource FieldLabel}"/>
                                    <ctrl:NumericBox Grid.Row="0" Grid.Column="4" Value="{Binding Model.RoiCol1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="200000" DecimalPlaces="3" Increment="1"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Row2" Style="{StaticResource FieldLabel}"/>
                                    <ctrl:NumericBox Grid.Row="1" Grid.Column="1" Value="{Binding Model.RoiRow2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="200000" DecimalPlaces="3" Increment="1"/>
                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="Col2" Style="{StaticResource FieldLabel}"/>
                                    <ctrl:NumericBox Grid.Row="1" Grid.Column="4" Value="{Binding Model.RoiCol2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="200000" DecimalPlaces="3" Increment="1"/>
                                </Grid>
                            </Border>
                            <WrapPanel>
                                <Button Content="读取ViewROI" Click="OnReadRoiClick"/>
                                <Button Content="应用ROI" Click="OnApplyRoiClick"/>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="坐标转换">
                    <StackPanel Margin="6">
                        <TextBlock Text="像素坐标输入" Style="{StaticResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Pixel Row" Style="{StaticResource FieldLabel}"/>
                            <ctrl:NumericBox Grid.Row="0" Grid.Column="1" Value="{Binding Model.InputPixelRow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="200000" DecimalPlaces="4" Increment="1"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Pixel Col" Style="{StaticResource FieldLabel}"/>
                            <ctrl:NumericBox Grid.Row="1" Grid.Column="1" Value="{Binding Model.InputPixelCol, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="200000" DecimalPlaces="4" Increment="1"/>
                        </Grid>
                        <Button Content="转换" Click="OnTransformClick"/>
                        <TextBlock Text="棋盘坐标输出" Style="{StaticResource SectionTitle}" Margin="0,10,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Board X" Style="{StaticResource FieldLabel}"/>
                            <ctrl:NumericBox Grid.Row="0" Grid.Column="1" Value="{Binding Model.OutputBoardX, Mode=OneWay}" DecimalPlaces="4"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Board Y" Style="{StaticResource FieldLabel}"/>
                            <ctrl:NumericBox Grid.Row="1" Grid.Column="1" Value="{Binding Model.OutputBoardY, Mode=OneWay}" DecimalPlaces="4"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="是否成功" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Model.TransformSuccess}" Foreground="{StaticResource Amber}" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Border>

        <Border Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource Panel}" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel>
                    <TextBlock Text="识别点表格" Style="{StaticResource SectionTitle}" DockPanel.Dock="Left"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="识别 " Foreground="{StaticResource TextSub}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Model.DetectedCount}" Foreground="{StaticResource Cyan}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <TextBlock Text="参与 " Foreground="{StaticResource TextSub}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Model.UsedCount}" Foreground="{StaticResource Magenta}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <TextBlock Text="平均 " Foreground="{StaticResource TextSub}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Model.AvgErrorMm, StringFormat=F4}" Foreground="{StaticResource Green}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <TextBlock Text="RMS " Foreground="{StaticResource TextSub}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Model.RmsErrorMm, StringFormat=F4}" Foreground="{StaticResource Green}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <TextBlock Text="最大 " Foreground="{StaticResource TextSub}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Model.MaxErrorMm, StringFormat=F4}" Foreground="{StaticResource Amber}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
                <DataGrid Grid.Row="1" ItemsSource="{Binding PointRows}" EnableRowVirtualization="True" EnableColumnVirtualization="True" FrozenColumnCount="3">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="参与" Binding="{Binding Used, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="52"/>
                        <DataGridTextColumn Header="序号" Binding="{Binding SerialNumber}" Width="70" IsReadOnly="True"/>
                        <DataGridTextColumn Header="二维码" Binding="{Binding Decoded}" Width="120" IsReadOnly="True"/>
                        <DataGridTextColumn Header="行" Binding="{Binding BoardRow}" Width="48" IsReadOnly="True"/>
                        <DataGridTextColumn Header="列" Binding="{Binding BoardColumn}" Width="48" IsReadOnly="True"/>
                        <DataGridTextColumn Header="拟合Row" Binding="{Binding ImageRow, StringFormat=F3}" Width="86" IsReadOnly="True"/>
                        <DataGridTextColumn Header="拟合Col" Binding="{Binding ImageColumn, StringFormat=F3}" Width="86" IsReadOnly="True"/>
                        <DataGridTextColumn Header="识别Row" Binding="{Binding DetectedRow, StringFormat=F3}" Width="86" IsReadOnly="True"/>
                        <DataGridTextColumn Header="识别Col" Binding="{Binding DetectedColumn, StringFormat=F3}" Width="86" IsReadOnly="True"/>
                        <DataGridTextColumn Header="名义Row" Binding="{Binding NominalRow, StringFormat=F3}" Width="86" IsReadOnly="True"/>
                        <DataGridTextColumn Header="名义Col" Binding="{Binding NominalColumn, StringFormat=F3}" Width="86" IsReadOnly="True"/>
                        <DataGridTextColumn Header="像素误差" Binding="{Binding PixelError, StringFormat=F3}" Width="86" IsReadOnly="True"/>
                        <DataGridTextColumn Header="X(mm)" Binding="{Binding WorldX, StringFormat=F4}" Width="86" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Y(mm)" Binding="{Binding WorldY, StringFormat=F4}" Width="86" IsReadOnly="True"/>
                        <DataGridTextColumn Header="拟合X" Binding="{Binding FittedX, StringFormat=F4}" Width="86" IsReadOnly="True"/>
                        <DataGridTextColumn Header="拟合Y" Binding="{Binding FittedY, StringFormat=F4}" Width="86" IsReadOnly="True"/>
                        <DataGridTextColumn Header="误差(mm)" Binding="{Binding ErrorMm, StringFormat=F4}" Width="90" IsReadOnly="True"/>
                        <DataGridTextColumn Header="角度" Binding="{Binding PhiDeg, StringFormat=F2}" Width="72" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Row="3" Grid.ColumnSpan="3" Style="{StaticResource Panel}" Margin="0,10,0,0" Background="#111E2B">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <TextBlock Text="{Binding Model.MatrixCheckMessage}" Width="300" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Model.RunMessage}" TextWrapping="Wrap" Width="300" Foreground="{StaticResource TextSub}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="自检矩阵" Click="OnCheckMatrixClick"/>
                    <Button Content="按勾选重拟合" Click="OnRefitSelectedClick"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>