<UserControl x:Class="Plugin.MeasureLine.WPF架构.MeasureLineUser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ctrl="clr-namespace:Plugin.MeasureLine.Controls"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280"
           >
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DCF8FF"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,2,0,8"/>
            <Setter Property="Foreground" Value="#E9FBFF"/>
            <Setter Property="Background" Value="#102536"/>
            <Setter Property="BorderBrush" Value="#2F7E98"/>
        </Style>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="82"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Foreground" Value="#E9FBFF"/>
            <Setter Property="Background" Value="#102536"/>
            <Setter Property="BorderBrush" Value="#00A9C8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="#111923"/>
            <Setter Property="BorderBrush" Value="#2F7E98"/>
            <Setter Property="Foreground" Value="#DCF8FF"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#102536"/>
            <Setter Property="Foreground" Value="#DCF8FF"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#08111B">
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2" BorderBrush="#2F7E98" BorderThickness="1" Background="#101A26" Padding="14,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="520"/>
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="直线抓边工具" FontSize="21" FontWeight="Bold" Foreground="#00E5FF"/>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding StatusText}" Foreground="#9FC7D8"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolButton}" Content="加载图像" Command="{Binding LoadImageCommand}"/>
                    <Button Style="{StaticResource ToolButton}" Content="十字光标" Command="{Binding ToggleCrosshairCommand}"/>
                    <Button Style="{StaticResource ToolButton}" Content="适应窗口" Command="{Binding FitWindowCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="220"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
            BorderBrush="#215D73"
            BorderThickness="1"
            Background="#020407"
            Margin="1,1,1,8">
                <Grid>
                    <wfi:WindowsFormsHost x:Name="HalconHost" Background="#020407"/>

                    <Popup Placement="MousePoint"
                   StaysOpen="False"
                   AllowsTransparency="True"
                   IsOpen="{Binding IsFollowMenuOpen, Mode=TwoWay}">
                        <Border Background="#102536"
                        BorderBrush="#00A9C8"
                        BorderThickness="1"
                        Padding="4">
                            <StackPanel>
                                <Button Style="{StaticResource ToolButton}"
                                MinWidth="132"
                                Margin="0,0,0,4"
                                Content="设置基准坐标"
                                Command="{Binding SetBasePoseCommand}"/>
                                <Button Style="{StaticResource ToolButton}"
                                MinWidth="132"
                                Margin="0"
                                Content="设置当前位置"
                                Command="{Binding SetCurrentPoseCommand}"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Border>

            <Border Grid.Row="1"
            BorderBrush="#215D73"
            BorderThickness="1"
            Background="#08111B"
            Margin="1,0,1,8">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border BorderBrush="#1B5264"
                    BorderThickness="1"
                    Margin="0,0,6,0"
                    Background="#050A10">
                        <Grid>
                            <TextBlock Text="H 灰度曲线"
                               Foreground="#7EE6FF"
                               Margin="8,6"
                               Panel.ZIndex="1"/>
                            <ctrl:ProfileCurveControl Margin="8,24,8,8"
                                              Values="{Binding HorizontalProfile}"
                                              Stroke="#00E5FF"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1"
                    BorderBrush="#1B5264"
                    BorderThickness="1"
                    Margin="6,0,0,0"
                    Background="#050A10">
                        <Grid>
                            <TextBlock Text="V 灰度曲线"
                               Foreground="#7EE6FF"
                               Margin="8,6"
                               Panel.ZIndex="1"/>
                            <ctrl:ProfileCurveControl Margin="8,24,8,8"
                                              Values="{Binding VerticalProfile}"
                                              Stroke="#83FF72"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="1" Grid.Column="1" BorderBrush="#2F7E98" BorderThickness="1" Background="#111923" Margin="0,10,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="126"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border BorderBrush="#255F72" BorderThickness="0,0,0,1" Background="#0B1520" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="运行结果" Foreground="#00E5FF" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="1" Text="{Binding Line1Status}" Foreground="#83FF72"/>
                        <TextBlock Grid.Row="2" Text="{Binding Line1Info}" Foreground="AliceBlue"/>
                        <TextBlock Grid.Row="3" Text="{Binding FollowOffsetText}" Foreground="#AEC7D3" Margin="0,8,0,0"/>
                    </Grid>
                </Border>

                <TabControl Grid.Row="1" Foreground="Black">
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem">
                            <Setter Property="Background" Value="#102536"/>
                            <Setter Property="Foreground" Value="#DCF8FF"/>
                            <Setter Property="Padding" Value="14,6"/>
                            <Setter Property="Margin" Value="0,0,4,0"/>

                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#08111B"/>
                                    <Setter Property="Foreground" Value="#00E5FF"/>
                                    <Setter Property="Panel.ZIndex" Value="1"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#173246"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TabControl.ItemContainerStyle>

                    <TabItem Header="抓边">
                        <ScrollViewer Padding="14" VerticalScrollBarVisibility="Auto" Background="#111923" >
                            <StackPanel>
                                <TextBlock Text="ROI参数" Foreground="#00E5FF" FontWeight="Bold" Margin="0,0,0,8"/>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="中心行"/>
                                        <ctrl:NumericBox Value="{Binding Params.Line1CenterRow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Increment="1" DecimalPlaces="2"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="中心列"/>
                                        <ctrl:NumericBox Value="{Binding Params.Line1CenterColumn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Increment="1" DecimalPlaces="2"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="角度"/>
                                        <ctrl:NumericBox Value="{Binding Params.Line1Angle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Increment="0.1" DecimalPlaces="3"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="高度"/>
                                        <ctrl:NumericBox Value="{Binding Params.Line1Height, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="1" Increment="1" DecimalPlaces="2"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="宽度"/>
                                        <ctrl:NumericBox Value="{Binding Params.Line1Width, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="1" Increment="1" DecimalPlaces="2"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="采样点数"/>
                                        <ctrl:NumericBox Value="{Binding Params.Line1PointCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="2" Increment="1" DecimalPlaces="0"/>
                                    </StackPanel>
                                </UniformGrid>

                                <Separator Margin="0,8,0,12" Background="#255F72"/>
                                <TextBlock Text="抓边参数" Foreground="#00E5FF" FontWeight="Bold" Margin="0,0,0,8"/>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="平滑系数"/>
                                        <ctrl:NumericBox Value="{Binding Params.Line1Sigma, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0.1" Increment="0.1" DecimalPlaces="2"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="灰度阈值"/>
                                        <ctrl:NumericBox Value="{Binding Params.Line1Threshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="255" Increment="1" DecimalPlaces="0"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="边缘数量"/>
                                        <ctrl:NumericBox Value="{Binding Params.Line1NumInstances, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="1" Increment="1" DecimalPlaces="0"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="距离阈值"/>
                                        <ctrl:NumericBox Value="{Binding Params.Line1DistThreshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Increment="0.1" DecimalPlaces="2"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="最小得分"/>
                                        <ctrl:NumericBox Value="{Binding Params.Line1MinScore, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="1" Increment="0.05" DecimalPlaces="2"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="最大迭代"/>
                                        <ctrl:NumericBox Value="{Binding Params.Line1MaxIterations, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="-1" Increment="1" DecimalPlaces="0"/>
                                    </StackPanel>
                                </UniformGrid>

                                <TextBlock Text="明暗方向"/>
                                <ComboBox SelectedValue="{Binding Params.Line1Transition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag">
                                    <ComboBoxItem Content="全部" Tag="all"/>
                                    <ComboBoxItem Content="从暗到亮" Tag="positive"/>
                                    <ComboBoxItem Content="从亮到暗" Tag="negative"/>
                                    <ComboBoxItem Content="一致" Tag="uniform"/>
                                </ComboBox>

                                <TextBlock Text="边缘选择"/>
                                <ComboBox SelectedValue="{Binding Params.Line1Select, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag">
                                    <ComboBoxItem Content="第一条边" Tag="first"/>
                                    <ComboBoxItem Content="最后一条边" Tag="last"/>
                                    <ComboBoxItem Content="全部边" Tag="all"/>
                                </ComboBox>

                                <TextBlock Text="测量结果验证"/>
                                <ComboBox SelectedValue="{Binding Params.MeasureIORegions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag">
                                    <ComboBoxItem Content="开启" Tag="true"/>
                                    <ComboBoxItem Content="关闭" Tag="false"/>
                                </ComboBox>

                                <TextBlock Text="插值方式"/>
                                <ComboBox SelectedValue="{Binding Params.MeasureInterpolation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag">
                                    <ComboBoxItem Content="最近邻" Tag="nearest_neighbor"/>
                                    <ComboBoxItem Content="双线性" Tag="bilinear"/>
                                    <ComboBoxItem Content="双三次" Tag="bicubic"/>
                                </ComboBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="ROI移动">
                        <ScrollViewer Padding="14" VerticalScrollBarVisibility="Auto" Background="#111923">
                            <StackPanel>
                                <TextBlock Text="移动方式" Foreground="#00E5FF" FontWeight="Bold" Margin="0,0,0,8"/>
                                <ComboBox SelectedValue="{Binding Params.RoiMoveIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag">
                                    <ComboBoxItem Content="静态" Tag="StaticROI"/>
                                    <ComboBoxItem Content="标准ROI" Tag="StandardROI"/>
                                    <ComboBoxItem Content="递增ROI" Tag="IncreaseROI"/>
                                </ComboBox>

                                <TextBlock Text="标准ROI" Foreground="#00E5FF" FontWeight="Bold" Margin="0,6,0,8"/>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="基准行"/>
                                        <ctrl:NumericBox Value="{Binding Params.RoiStandardRow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Increment="1" DecimalPlaces="2"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="基准列"/>
                                        <ctrl:NumericBox Value="{Binding Params.RoiStandardColumn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Increment="1" DecimalPlaces="2"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="基准偏移行"/>
                                        <ctrl:NumericBox Value="{Binding Params.RoiStandardOffsetRow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Increment="1" DecimalPlaces="2"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="基准偏移列"/>
                                        <ctrl:NumericBox Value="{Binding Params.RoiStandardOffsetColumn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Increment="1" DecimalPlaces="2"/>
                                    </StackPanel>
                                </UniformGrid>

                                <TextBlock Text="递增ROI" Foreground="#00E5FF" FontWeight="Bold" Margin="0,8,0,8"/>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="递增次数"/>
                                        <ctrl:NumericBox Value="{Binding Params.RoiIncreaseNum, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Increment="1" DecimalPlaces="0"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="行增量"/>
                                        <ctrl:NumericBox Value="{Binding Params.RoiIncreaseRow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Increment="1" DecimalPlaces="2"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="列增量"/>
                                        <ctrl:NumericBox Value="{Binding Params.RoiIncreaseColumn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Increment="1" DecimalPlaces="2"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="图像预处理">
                        <ScrollViewer Padding="14" VerticalScrollBarVisibility="Auto" Background="#111923">
                            <StackPanel>
                                <CheckBox Content="启用图像预处理" IsChecked="{Binding Params.ImageProcessEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Foreground="#DCF8FF" Margin="0,0,0,12"/>
                                <StackPanel IsEnabled="{Binding Params.ImageProcessEnabled}">
                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="底色选取"/>
                                            <ctrl:NumericBox Value="{Binding Params.ScaleMean, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="255" Increment="1" DecimalPlaces="0"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="增强因子"/>
                                            <ctrl:NumericBox Value="{Binding Params.ScaleFactor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Increment="0.1" DecimalPlaces="2"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="锐化迭代"/>
                                            <ctrl:NumericBox Value="{Binding Params.SharpenIterations, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Increment="1" DecimalPlaces="0"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="锐化系数"/>
                                            <ctrl:NumericBox Value="{Binding Params.SharpenSigma, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Increment="0.1" DecimalPlaces="2"/>
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="峰值/默认线">
                        <ScrollViewer Padding="14" VerticalScrollBarVisibility="Auto" Background="#111923">
                            <StackPanel>
                                <TextBlock Text="峰值谷值选择" Foreground="#00E5FF" FontWeight="Bold" Margin="0,0,0,8"/>
                                <ComboBox SelectedValue="{Binding Params.PeakValleySelect, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag">
                                    <ComboBoxItem Content="无" Tag="None"/>
                                    <ComboBoxItem Content="峰值" Tag="peak"/>
                                    <ComboBoxItem Content="谷值" Tag="valley"/>
                                    <ComboBoxItem Content="剔值平均" Tag="RejectionAverage"/>
                                </ComboBox>
                                <CheckBox Content="默认线回退" IsChecked="{Binding Params.DefaultLine, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Foreground="Black"  Margin="0,6,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="位置跟随">
                        <ScrollViewer Padding="14" VerticalScrollBarVisibility="Auto" Background="#111923">
                            <StackPanel>
                                <CheckBox Content="启用位置跟随" IsChecked="{Binding Params.EnablePositionFollow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Foreground="#DCF8FF" Margin="0,0,0,12"/>
                                <TextBlock Text="基准位置" Foreground="#00E5FF" FontWeight="Bold" Margin="0,0,0,8"/>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="基准行"/>
                                        <ctrl:NumericBox Value="{Binding Params.BaseRow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Increment="1" DecimalPlaces="2"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="基准列"/>
                                        <ctrl:NumericBox Value="{Binding Params.BaseColumn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Increment="1" DecimalPlaces="2"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="基准角度"/>
                                        <ctrl:NumericBox Value="{Binding Params.BaseAngle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Increment="0.1" DecimalPlaces="3"/>
                                    </StackPanel>
                                </UniformGrid>

                                <TextBlock Text="当前位置" Foreground="#00E5FF" FontWeight="Bold" Margin="0,8,0,8"/>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="当前行"/>
                                        <ctrl:NumericBox Value="{Binding Params.CurrentRow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Increment="1" DecimalPlaces="2"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="当前列"/>
                                        <ctrl:NumericBox Value="{Binding Params.CurrentColumn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Increment="1" DecimalPlaces="2"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="当前角度"/>
                                        <ctrl:NumericBox Value="{Binding Params.CurrentAngle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Increment="0.1" DecimalPlaces="3"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>

        <Border Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="#255F72" BorderThickness="1" Background="#101923" Padding="12,0">
            <TextBlock VerticalAlignment="Center" Text="{Binding MouseInfo}" Foreground="#AEC7D3"/>
        </Border>
    </Grid>
</UserControl>
