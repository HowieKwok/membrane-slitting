<Window x:Class="Frame_Core.WPFFormPluginBase"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="Root"
        Title="PluginFormBase"
        Icon="/Frame_Core;component/WPF/Resources/Icons/hsvision_plugin.ico"
        Width="1008"
        Height="811"
        MinWidth="860"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#070D14"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <SolidColorBrush x:Key="SciBg" Color="#070D14"/>
        <SolidColorBrush x:Key="SciPanel" Color="#101923"/>
        <SolidColorBrush x:Key="SciPanelDeep" Color="#08111B"/>
        <SolidColorBrush x:Key="SciLine" Color="#255F72"/>
        <SolidColorBrush x:Key="SciAccent" Color="#00D8FF"/>

        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#DCF8FF"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="SciButton" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Foreground" Value="#E9FBFF"/>
            <Setter Property="Background" Value="#102536"/>
            <Setter Property="BorderBrush" Value="#00A9C8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <DrawingBrush TileMode="Tile"
                          Viewport="0,0,42,42"
                          ViewportUnits="Absolute"
                          Viewbox="0,0,42,42"
                          ViewboxUnits="Absolute">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="#070D14">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,42,42"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="#143847">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,1,42"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="#102E3B">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,42,1"/>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>
        </Grid.Background>

        <Border Margin="10"
                BorderBrush="#2F7E98"
                BorderThickness="1"
                Background="#DD0A111C">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="44"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Margin="10,10,10,6"
                        BorderBrush="#215D73"
                        BorderThickness="1"
                        Background="{StaticResource SciPanelDeep}">
                    <ContentPresenter Content="{Binding PluginContent, ElementName=Root}"/>
                </Border>

                <Border Grid.Row="1"
                        BorderBrush="#255F72"
                        BorderThickness="0,1,0,0"
                        Background="{StaticResource SciPanel}"
                        Padding="10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Height="30"
                                VerticalAlignment="Center"
                                BorderBrush="#2F7E98"
                                BorderThickness="1"
                                Background="#0B1722"
                                Padding="10,0">
                            <TextBlock VerticalAlignment="Center"
                                       Text="{Binding CostTimeText, ElementName=Root}"
                                       Foreground="#7EE6FF"/>
                        </Border>

                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"
                                   Text="{Binding StatusText, ElementName=Root}"
                                   Foreground="#9FC7D8"/>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button Style="{StaticResource SciButton}"
                                    Content="执行"
                                    Command="{Binding RunCommand, ElementName=Root}"/>
                            <Button Style="{StaticResource SciButton}"
                                    Content="保存"
                                    Command="{Binding SaveCommand, ElementName=Root}"/>
                            <Button Style="{StaticResource SciButton}"
                                    Content="关闭"
                                    Command="{Binding CloseCommand, ElementName=Root}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
