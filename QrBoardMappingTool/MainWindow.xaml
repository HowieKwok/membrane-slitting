<Window x:Class="QrBoardMappingTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:QrBoardMappingTool.Controls"
        Title="二维码棋盘格坐标映射工具"
        Width="1480"
        Height="900"
        MinWidth="1180"
        MinHeight="760"
        Background="#101418"
        FontFamily="Microsoft YaHei UI"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F1F5F9" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="BorderBrush" Value="#6B7280" />
            <Setter Property="CaretBrush" Value="#111827" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#111827" />
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Background" Value="#FFFFFF" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Foreground" Value="#111827" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F1F5F9" />
            <Setter Property="Margin" Value="0,4,12,0" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#475569" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="RowBackground" Value="#FFFFFF" />
            <Setter Property="AlternatingRowBackground" Value="#EAF2FF" />
            <Setter Property="GridLinesVisibility" Value="All" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="BorderBrush" Value="#64748B" />
            <Setter Property="HorizontalGridLinesBrush" Value="#CBD5E1" />
            <Setter Property="VerticalGridLinesBrush" Value="#CBD5E1" />
            <Setter Property="ColumnHeaderHeight" Value="30" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#D9E8FF" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="#94A3B8" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="6,2" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Padding" Value="4,2" />
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="390" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="230" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Column="0" Grid.RowSpan="2" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
            <StackPanel>
                <TextBlock Text="二维码棋盘格坐标映射" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,10" />

                <GroupBox Header="图像">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Row="0" Grid.Column="0" x:Name="ImagePathBox" Text="{Binding Settings.ImagePath, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Row="0" Grid.Column="1" Content="浏览" Click="BrowseImage_Click" />
                        <UniformGrid Grid.Row="1" Grid.ColumnSpan="2" Columns="2">
                            <Button Content="加载图像" Click="LoadImage_Click" />
                            <Button Content="适配窗口" Click="FitImage_Click" />
                        </UniformGrid>
                    </Grid>
                </GroupBox>

                <GroupBox Header="识别ROI">
                    <StackPanel>
                        <UniformGrid Columns="3">
                            <Button Content="矩形" Click="AddRectRoi_Click" />
                            <Button Content="圆形" Click="AddCircleRoi_Click" />
                            <Button Content="多边形" Click="AddPolygonRoi_Click" />
                        </UniformGrid>
                        <UniformGrid Columns="2">
                            <Button Content="撤销ROI" Click="UndoRoi_Click" />
                            <Button Content="清空ROI" Click="ClearRoi_Click" />
                        </UniformGrid>
                        <TextBlock x:Name="RoiInfoText" Text="ROI: 整图" Margin="4,6,0,0" Foreground="#C7D2FE" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="棋盘物理参数">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="行数" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Settings.BoardRows, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="列数" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Settings.BoardColumns, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="X间距(mm)" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Settings.SpacingX, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Y间距(mm)" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Settings.SpacingY, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="物理原点X(mm)" />
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Settings.OriginX, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="物理原点Y(mm)" />
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Settings.OriginY, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="二维码宽(mm)" />
                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Settings.QrPhysicalWidth, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="7" Grid.Column="0" Text="二维码高(mm)" />
                        <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Settings.QrPhysicalHeight, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal">
                            <CheckBox Content="行方向反转" IsChecked="{Binding Settings.InvertRowAxis}" />
                            <CheckBox Content="列方向反转" IsChecked="{Binding Settings.InvertColumnAxis}" />
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox Header="像素网格参数">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="像素格宽(px)" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Settings.PixelCellWidth, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="像素格高(px)" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Settings.PixelCellHeight, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="像素原点Col" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Settings.PixelOriginColumn, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="像素原点Row" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Settings.PixelOriginRow, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="二维码宽(px)" />
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Settings.QrPixelWidth, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="二维码高(px)" />
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Settings.QrPixelHeight, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Text="例: 序号2左上角(Row=0, Col=200), 中心(Row=50, Col=250)" Foreground="#C7D2FE" Margin="3,4,0,0" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="二维码 / 拟合">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="解码方式" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="取第一个数字作为序号" Foreground="#C7D2FE" Margin="3,0,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="序号基准" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Settings.SerialBaseIndex, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="每行二维码数" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Settings.QrPerRow, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="列步长(格)" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Settings.QrColumnStep, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="行步长(格)" />
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Settings.QrRowStep, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="奇数行列偏移(格)" />
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Settings.QrOddRowColumnOffset, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="矩阵算法" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="HALCON VectorToHomMat2d" Foreground="#C7D2FE" Margin="3,0,0,0" />
                        <TextBlock Grid.Row="7" Grid.Column="0" Text="矩阵点绑定" />
                        <TextBlock Grid.Row="7" Grid.Column="1" Text="识别像素中心 -> 序号物理中心" Foreground="#C7D2FE" Margin="3,0,0,0" />
                        <TextBlock Grid.Row="8" Grid.Column="0" Text="识别中心来源" />
                        <ComboBox Grid.Row="8" Grid.Column="1" x:Name="CenterSourceBox" SelectedValue="{Binding Settings.CenterSource}" />
                        <TextBlock Grid.Row="9" Grid.Column="0" Text="极性" />
                        <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding Settings.QrPolarity, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="10" Grid.Column="0" Text="识别参数" />
                        <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding Settings.QrDefaultParameters, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="11" Grid.Column="0" Text="最多识别数" />
                        <TextBox Grid.Row="11" Grid.Column="1" Text="{Binding Settings.StopAfterResultNum, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="12" Grid.ColumnSpan="2" Text="默认: 序号1=(5,5), 2=(25,5), 6=(15,15)" Foreground="#C7D2FE" Margin="3,4,0,0" />
                        <Button Grid.Row="13" Grid.ColumnSpan="2" Content="识别二维码并用VectorToHomMat2d拟合" Margin="3,8,3,3" Click="DetectAndFit_Click" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="手动验证">
                    <StackPanel>
                        <TextBlock Text="像素 -> 物理" FontWeight="SemiBold" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="像素Y(Row)" Foreground="#C7D2FE" Margin="3,2,0,0" />
                                <TextBox x:Name="PixelRowBox" ToolTip="图像Row，向下为正" Text="50" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Text="像素X(Col)" Foreground="#C7D2FE" Margin="3,2,0,0" />
                                <TextBox x:Name="PixelColBox" ToolTip="图像Column，向右为正" Text="250" />
                            </StackPanel>
                        </Grid>
                        <Button Content="像素转物理" Click="PixelToBoard_Click" />
                        <TextBlock x:Name="PixelToBoardText" Foreground="#93C5FD" Margin="4,2,0,8" />

                        <TextBlock Text="物理 -> 像素" FontWeight="SemiBold" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="物理X(mm)" Foreground="#C7D2FE" Margin="3,2,0,0" />
                                <TextBox x:Name="WorldXBox" ToolTip="物理X，向右为正" Text="25" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Text="物理Y(mm)" Foreground="#C7D2FE" Margin="3,2,0,0" />
                                <TextBox x:Name="WorldYBox" ToolTip="物理Y，向下为正" Text="5" />
                            </StackPanel>
                        </Grid>
                        <Button Content="物理转像素" Click="BoardToPixel_Click" />
                        <TextBlock x:Name="BoardToPixelText" Foreground="#93C5FD" Margin="4,2,0,0" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="1" Grid.Row="0" BorderBrush="#475569" BorderThickness="1" Background="#080B0E">
            <controls:HalconSmartViewer x:Name="Viewer" />
        </Border>

        <Grid Grid.Column="1" Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#475569" BorderThickness="1" Background="#151B21" Padding="10" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="拟合状态" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#D7E3F5" />
                    <Separator Margin="0,8" />
                    <TextBlock x:Name="StatsText" FontFamily="Consolas" Foreground="#F8FAFC" />
                    <Button Content="按勾选点重新拟合" Margin="0,10,0,0" Click="Refit_Click" />
                </StackPanel>
            </Border>

            <DataGrid Grid.Column="1"
                      x:Name="PointsGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="False"
                      ItemsSource="{Binding Result.Points}">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="参与" Binding="{Binding Used}" Width="48" />
                    <DataGridTextColumn Header="序号" Binding="{Binding SerialNumber}" Width="55" IsReadOnly="True" />
                    <DataGridTextColumn Header="二维码" Binding="{Binding Decoded}" Width="80" IsReadOnly="True" />
                    <DataGridTextColumn Header="行" Binding="{Binding RowIndex}" Width="42" IsReadOnly="True" />
                    <DataGridTextColumn Header="列" Binding="{Binding ColumnIndex}" Width="42" IsReadOnly="True" />
                    <DataGridTextColumn Header="拟合Row" Binding="{Binding ImageRow, StringFormat=F3}" Width="80" IsReadOnly="True" />
                    <DataGridTextColumn Header="拟合Col" Binding="{Binding ImageColumn, StringFormat=F3}" Width="80" IsReadOnly="True" />
                    <DataGridTextColumn Header="识别Row" Binding="{Binding DetectedImageRow, StringFormat=F3}" Width="80" IsReadOnly="True" />
                    <DataGridTextColumn Header="识别Col" Binding="{Binding DetectedImageColumn, StringFormat=F3}" Width="80" IsReadOnly="True" />
                    <DataGridTextColumn Header="名义Row" Binding="{Binding NominalImageRow, StringFormat=F3}" Width="80" IsReadOnly="True" />
                    <DataGridTextColumn Header="名义Col" Binding="{Binding NominalImageColumn, StringFormat=F3}" Width="80" IsReadOnly="True" />
                    <DataGridTextColumn Header="像素误差" Binding="{Binding PixelError, StringFormat=F3}" Width="80" IsReadOnly="True" />
                    <DataGridTextColumn Header="X(mm)" Binding="{Binding WorldX, StringFormat=F3}" Width="75" IsReadOnly="True" />
                    <DataGridTextColumn Header="Y(mm)" Binding="{Binding WorldY, StringFormat=F3}" Width="75" IsReadOnly="True" />
                    <DataGridTextColumn Header="拟合X" Binding="{Binding FittedX, StringFormat=F3}" Width="75" IsReadOnly="True" />
                    <DataGridTextColumn Header="拟合Y" Binding="{Binding FittedY, StringFormat=F3}" Width="75" IsReadOnly="True" />
                    <DataGridTextColumn Header="误差(mm)" Binding="{Binding ErrorMm, StringFormat=F4}" Width="80" IsReadOnly="True" />
                    <DataGridTextColumn Header="角度" Binding="{Binding PhiDeg, StringFormat=F2}" Width="65" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>
